# CPISP - Civil Protection Stability & Defense Force
au14-job-name-corp-nemo-cpisp-specialist = CPISP Specialist
au14-job-description-corp-nemo-cpisp-specialist = You are part of the elite Civil Protection Stability & Defense Force! Deployed on high-risk missions and protection tasks of high-ranking officials. Only the best NEMO operatives make it here.
au14-job-prefix-nemo-cpisp-specialist = CPISP-S

au14-job-name-corp-nemo-cpisp-enforcer = CPISP Enforcer
au14-job-description-corp-nemo-cpisp-enforcer = You are an enforcer in the elite Civil Protection Stability & Defense Force! Ready for high-risk tactical operations protecting high-ranking officials.
au14-job-prefix-nemo-cpisp-enforcer = CPISP-E

au14-job-name-corp-nemo-cpisp-inspector = CPISP Inspector
au14-job-description-corp-nemo-cpisp-inspector = You are an inspector in the elite Civil Protection Stability & Defense Force! Coordinate protective operations and tactical assessments for high-value targets.
au14-job-prefix-nemo-cpisp-inspector = CPISP-I

au14-job-name-corp-nemo-cpisp-leader = CPISP Team Leader
au14-job-description-corp-nemo-cpisp-leader = You lead an elite CPISP team! Command high-risk protective and tactical operations. If CPISP fails, NEMO has few other options.
au14-job-prefix-nemo-cpisp-leader = CPISP-L

au14-job-name-corp-nemo-cpisp-medic = CPISP Medic
au14-job-description-corp-nemo-cpisp-medic = You are the medical specialist of the elite CPISP! Provide emergency medical support during high-risk protective operations.
au14-job-prefix-nemo-cpisp-medic = CPISP-M

au14-job-name-corp-nemo-cpisp-operator = CPISP Operator
au14-job-description-corp-nemo-cpisp-operator = You are an operator in the elite Civil Protection Stability & Defense Force! Execute specialized tactical operations with maximum precision.
au14-job-prefix-nemo-cpisp-operator = CPISP-OP

au14-job-name-corp-nemo-cpisp-pointman = CPISP Pointman
au14-job-description-corp-nemo-cpisp-pointman = You are the pointman of an elite CPISP team! Lead entry and close quarters tactical operations protecting high-value targets.
au14-job-prefix-nemo-cpisp-pointman = CPISP-P

# MIG - Marshal Intervention Group
au14-job-name-corp-nemo-mig-enforcer = MIG Enforcer
au14-job-description-corp-nemo-mig-enforcer = You are an enforcer in the Marshal Intervention Group! Handle arrests after SED investigations using advanced capture tools. Running is futile.
au14-job-prefix-nemo-mig-enforcer = MIG-E

au14-job-name-corp-nemo-mig-examiner = MIG Examiner
au14-job-description-corp-nemo-mig-examiner = You are an examiner in the Marshal Intervention Group! Collect evidence and conduct further investigations during arrest operations.
au14-job-prefix-nemo-mig-examiner = MIG-EX

au14-job-name-corp-nemo-mig-medic = MIG Medic
au14-job-description-corp-nemo-mig-medic = You are the medical specialist of the Marshal Intervention Group! Provide field medical support during arrest and capture operations.
au14-job-prefix-nemo-mig-medic = MIG-M

au14-job-name-corp-nemo-mig-synthetic = MIG Synthetic
au14-job-description-corp-nemo-mig-synthetic = You are a synthetic operative in the Marshal Intervention Group! Your enhanced capabilities make you invaluable for capture and enforcement operations.
au14-job-prefix-nemo-mig-synthetic = MIG-SY

# IRG - Instability Response Group
au14-job-name-corp-nemo-irg-enforcer = IRG Enforcer
au14-job-description-corp-nemo-irg-enforcer = You are part of the Instability Response Group! Deployed to handle instability within covered military factions. Equipped with non-lethal tools and limited personnel for focused operations.
au14-job-prefix-nemo-irg-enforcer = IRG-E

au14-job-name-corp-nemo-irg-leader = IRG Team Leader
au14-job-description-corp-nemo-irg-leader = You lead the Instability Response Group! Coordinate non-lethal operations to handle regional instability. Escalate to CPISP when situations require higher authority.
au14-job-prefix-nemo-irg-leader = IRG-L

au14-job-name-corp-nemo-irg-medic = IRG Medic
au14-job-description-corp-nemo-irg-medic = You are the medical specialist of the Instability Response Group! Provide field medical support during non-lethal operations and stabilization missions.
au14-job-prefix-nemo-irg-medic = IRG-M

au14-job-name-corp-nemo-irg-pointman = IRG Pointman
au14-job-description-corp-nemo-irg-pointman = You are the pointman of the Instability Response Group! Lead entry and close quarters operations to handle instability within covered military factions.
au14-job-prefix-nemo-irg-pointman = IRG-P

au14-job-name-corp-nemo-irg-synthetic = IRG Synthetic
au14-job-description-corp-nemo-irg-synthetic = You are a synthetic operative in the Instability Response Group! Support tactical operations with your enhanced capabilities during instability response missions.
au14-job-prefix-nemo-irg-synthetic = IRG-SY

# MIS - Marshal Intelligence Service
au14-job-name-corp-nemo-mis-enforcer = MIS Operative
au14-job-description-corp-nemo-mis-enforcer = You are part of the Marshal Intelligence Service! Specializing in intelligence collection through surveillance, wiretaps, and covert operations. Rarely reveal your true allegiance.
au14-job-prefix-nemo-mis-enforcer = MIS-O

au14-job-name-corp-nemo-mis-examiner = MIS Examiner
au14-job-description-corp-nemo-mis-examiner = You are an examiner in the Marshal Intelligence Service! Analyze intelligence data and coordinate covert intelligence gathering operations across the ship.
au14-job-prefix-nemo-mis-examiner = MIS-EX

au14-job-name-corp-nemo-mis-medic = MIS Medic
au14-job-description-corp-nemo-mis-medic = You are the medical specialist of the Marshal Intelligence Service! Provide covert medical support while maintaining your cover in intelligence operations.
au14-job-prefix-nemo-mis-medic = MIS-M

au14-job-name-corp-nemo-mis-synthetic = MIS Synthetic
au14-job-description-corp-nemo-mis-synthetic = You are a synthetic operative in the Marshal Intelligence Service! Your enhanced capabilities make you invaluable for covert intelligence gathering and infiltration.
au14-job-prefix-nemo-mis-synthetic = MIS-SY

au14-job-name-corp-nemo-mis-teamlead = MIS Team Lead
au14-job-description-corp-nemo-mis-teamlead = You lead intelligence operations in the Marshal Intelligence Service! Coordinate covert surveillance and intelligence gathering across multiple assets.
au14-job-prefix-nemo-mis-teamlead = MIS-L

# SED - Special Enforcement Detachment
au14-job-name-corp-nemo-sed-enforcer = SED Enforcer
au14-job-description-corp-nemo-sed-enforcer = You are part of the Special Enforcement Detachment! Investigate calls of injustice and directly handle criminal appeals. Your role is investigation; usually MIG handles arrests.
au14-job-prefix-nemo-sed-enforcer = SED-E

au14-job-name-corp-nemo-sed-inspector = SED Inspector
au14-job-description-corp-nemo-sed-inspector = You are an inspector in the Special Enforcement Detachment! Lead investigations into injustice and coordinate with MIG when arrests are warranted.
au14-job-prefix-nemo-sed-inspector = SED-I

au14-job-name-corp-nemo-sed-synthetic = SED Synthetic
au14-job-description-corp-nemo-sed-synthetic = You are a synthetic operative in the Special Enforcement Detachment! Assist investigations and evidence collection during criminal appeal operations.
au14-job-prefix-nemo-sed-synthetic = SED-SY
