# CMU14
cmd-golobby-desc = Enables the lobby and restarts the round. Requires the confirm argument to run.
cmd-golobby-help = Usage: golobby confirm [preset]
cmd-golobby-success = Enabling the lobby and restarting the round.
cmd-golobby-success-with-preset = Enabling the lobby and restarting the round with preset {$preset}.

# CMU14
cmu-cmd-golobby-needs-confirm = This command enables the lobby and restarts the round for everyone. Run golobby confirm to proceed, optionally followed by a preset name.
