# CMU14
cmd-restartround-desc = Ends the current round and starts the countdown for the next lobby. Requires the confirm argument to run.
cmd-restartround-help = Usage: restartround confirm

# CMU14
cmd-restartroundnow-desc = Moves the server from PostRound to a new PreRoundLobby. Requires the confirm argument to run.
cmd-restartroundnow-help = Usage: restartroundnow confirm

# CMU14
cmu-cmd-restartround-needs-confirm = This command ends the round for everyone. Run restartround confirm to proceed.
cmu-cmd-restartroundnow-needs-confirm = This command immediately moves the server back to the lobby for everyone. Run restartroundnow confirm to proceed.
