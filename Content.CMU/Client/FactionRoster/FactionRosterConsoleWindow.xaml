<DefaultWindow xmlns="https://spacestation14.io"
            Title="{Loc 'faction-roster-console-window-title'}"
            MinSize="420 560"
            SetSize="420 560">
    <PanelContainer StyleClasses="CrtPanel" VerticalExpand="True" HorizontalExpand="True">
        <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal" Margin="8 6 8 6" HorizontalExpand="True">
                <Label Name="CountLabel" HorizontalExpand="True" VerticalAlignment="Center" ToolTip="{Loc 'faction-roster-console-count-tooltip'}" />
                <Button Name="RefreshButton" Text="{Loc 'faction-roster-console-refresh-button'}" ToolTip="{Loc 'faction-roster-console-refresh-tooltip'}" />
            </BoxContainer>
            <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Name="ContentContainer"
                              Orientation="Vertical"
                              Margin="8 0 8 8"
                              SeparationOverride="6"
                              HorizontalExpand="True" />
            </ScrollContainer>
        </BoxContainer>
    </PanelContainer>
</DefaultWindow>
