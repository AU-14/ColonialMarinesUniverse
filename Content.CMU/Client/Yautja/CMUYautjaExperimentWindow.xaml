<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'cmu-yautja-experiment-guide-title'}"
               MinSize="460 420" SetSize="570 650">
    <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
        <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="14" HorizontalExpand="True">
            <RichTextLabel Name="Status" HorizontalExpand="True" />
            <Label Text="{Loc 'cmu-yautja-experiment-selected-heading'}" StyleClasses="LabelHeading" />
            <RichTextLabel Name="Procedure" HorizontalExpand="True" />
            <Label Text="{Loc 'cmu-yautja-experiment-clues-heading'}" StyleClasses="LabelHeading" />
            <RichTextLabel Name="Clues" HorizontalExpand="True" />
            <RichTextLabel Name="Steps" HorizontalExpand="True" />
        </BoxContainer>
    </ScrollContainer>
</DefaultWindow>
