<controls:CorporateConsoleWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client.CMU14.ColonyEconomy"
    Title="{Loc corporate-console-title}" MinSize="480 480">
    <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="8">
            <Label Name="CorporateBudgetLabel" Access="Public" Text="{Loc corporate-console-budget}"
                   StyleClasses="LabelHeading" Margin="0 4" />

            <!-- Withdraw -->
            <Label Text="{Loc corporate-console-withdraw-section}" Margin="0 4" />
            <Label Name="WithdrawTaxNote" Access="Public" Text=""
                   StyleClasses="LabelSubText" Margin="0 2" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="4" Margin="0 2">
                <Button Name="Withdraw100" Access="Public" Text="$100"
                        HorizontalExpand="True" Margin="2 0" />
                <Button Name="Withdraw250" Access="Public" Text="$250"
                        HorizontalExpand="True" Margin="2 0" />
                <Button Name="Withdraw500" Access="Public" Text="$500"
                        HorizontalExpand="True" Margin="2 0" />
            </BoxContainer>

            <!-- Transit Tariff -->
            <Label Text="{Loc corporate-console-transit-tariff-section}" Margin="0 6" />
            <Label Name="CurrentTariffLabel" Access="Public" Text="{Loc corporate-console-current-transit-tariff}"
                   Margin="0 2" />
            <Label Text="{Loc corporate-console-transit-tariff-description}"
                   StyleClasses="LabelSubText" Margin="0 2" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="4" Margin="0 4">
                <Label Text="{Loc corporate-console-new-tariff}" />
                <LineEdit Name="TariffInput" Access="Public" PlaceHolder="{Loc corporate-console-tariff-placeholder}"
                          HorizontalExpand="True" SizeFlagsStretchRatio="2" />
                <Button Name="SetTariffButton" Access="Public" Text="{Loc colony-economy-apply}" />
            </BoxContainer>

            <!-- Economy Overview -->
            <Label Text="{Loc colony-economy-overview}" Margin="0 6" />
            <BoxContainer Name="EconomyStatusPanel" Access="Public" Orientation="Vertical" Margin="4 2" />

            <!-- Third Party -->
            <Label Text="{Loc colony-economy-third-party-support}" Margin="0 6" />
            <Button Name="OpenThirdPartyBtn" Access="Public" Text="{Loc colony-economy-open-third-party-menu}"
                    HorizontalExpand="True" Margin="0 4" />
        </BoxContainer>
    </ScrollContainer>
</controls:CorporateConsoleWindow>

