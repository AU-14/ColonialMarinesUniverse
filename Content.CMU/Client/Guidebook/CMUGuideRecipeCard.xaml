<BoxContainer xmlns="https://spacestation14.io"
              Orientation="Vertical"
              Margin="5 5 5 5">
    <PanelContainer StyleClasses="CrtInsetPanel" HorizontalExpand="True">
        <BoxContainer Orientation="Vertical">
            <PanelContainer Name="NameBackground" HorizontalExpand="True" VerticalExpand="False">
                <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="6">
                    <TextureRect Name="ProductIcon" MinSize="32 32" MaxSize="32 32" Stretch="KeepAspectCentered" />
                    <RichTextLabel Name="ProductName" VerticalAlignment="Center" />
                </BoxContainer>
            </PanelContainer>
            <BoxContainer Name="RecipesContainer" HorizontalExpand="True">
                <Collapsible HorizontalExpand="True">
                    <CollapsibleHeading Name="RecipeHeading" Title="{Loc 'guidebook-reagent-recipes-header'}" />
                    <CollapsibleBody>
                        <BoxContainer Name="RecipesBody"
                                      Orientation="Vertical"
                                      Margin="10 0 10 0"
                                      HorizontalExpand="True" />
                    </CollapsibleBody>
                </Collapsible>
            </BoxContainer>
            <BoxContainer Name="PathContainer" HorizontalExpand="True">
                <Collapsible HorizontalExpand="True">
                    <CollapsibleHeading Name="PathHeading" Title="{Loc 'cmu-industry-recipes-full-path'}" />
                    <CollapsibleBody>
                        <BoxContainer Name="PathBody"
                                      Orientation="Vertical"
                                      Margin="10 0 10 0"
                                      HorizontalExpand="True" />
                    </CollapsibleBody>
                </Collapsible>
            </BoxContainer>
            <BoxContainer Name="SourcesContainer" HorizontalExpand="True">
                <Collapsible HorizontalExpand="True">
                    <CollapsibleHeading Name="SourceHeading" Title="{Loc 'guidebook-reagent-sources-header'}" />
                    <CollapsibleBody>
                        <BoxContainer Name="SourcesBody"
                                      Orientation="Vertical"
                                      Margin="10 0 10 0"
                                      HorizontalExpand="True" />
                    </CollapsibleBody>
                </Collapsible>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</BoxContainer>
