<controls:ChemSimulatorWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.CMU14.Chemistry.Research"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Title="{Loc ui-chem-simulator-window-name}" MinSize="940 520">
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="#181C24" />
        </PanelContainer.PanelOverride>
        <ScrollContainer HScrollEnabled="False" VScrollEnabled="True">
            <BoxContainer Orientation="Horizontal" Margin="4">
                <!-- Left column: status, mode, actions -->
                <BoxContainer Orientation="Vertical" MinWidth="260" HorizontalExpand="True" SizeFlagsStretchRatio="2" Margin="0 0 4 0">
                    <PanelContainer Name="StatusHeader" Access="Public">
                        <Label Text="{Loc research-sim-ui-header-status}" FontColorOverride="#FFFFFF" Margin="6 2" />
                    </PanelContainer>

                    <PanelContainer Name="CreditsPanel" Access="Public" HorizontalExpand="True" Margin="0 3 0 0">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BackgroundColor="#12141A" BorderColor="#B33A3A" BorderThickness="2" />
                        </PanelContainer.PanelOverride>
                        <ProgressBar Name="CreditsBar" Access="Public" MinValue="0" MaxValue="100" MinHeight="24" Margin="4" HorizontalExpand="True">
                            <Label Name="CreditsLabel" Access="Public" Align="Right" FontColorOverride="#FFFFFF" Margin="0 0 6 0" />
                        </ProgressBar>
                    </PanelContainer>

                    <PanelContainer Name="StatusPanel" Access="Public" Margin="0 3 0 0">
                        <Label Name="StatusLabel" Access="Public" Margin="6 1" />
                    </PanelContainer>

                    <PanelContainer Margin="0 3 0 0">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BackgroundColor="#12141A" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" Margin="6">
                            <Label Name="CostLabel" Access="Public" FontColorOverride="#C7CCD6" />
                            <Label Name="OverdoseLabel" Access="Public" FontColorOverride="#C7CCD6" />
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer Name="ModeHeader" Access="Public" Margin="0 6 0 0">
                        <Label Text="{Loc research-sim-ui-header-mode}" FontColorOverride="#FFFFFF" Margin="6 2" />
                    </PanelContainer>
                    <GridContainer Columns="2" HSeparationOverride="6" VSeparationOverride="6" Margin="0 3 0 0">
                        <Button Name="AmplifyButton" Access="Public" MinHeight="32" HorizontalExpand="True" ClipText="True"
                                ToolTip="{Loc research-sim-ui-amplify-tooltip}" />
                        <Button Name="SuppressButton" Access="Public" MinHeight="32" HorizontalExpand="True" ClipText="True"
                                ToolTip="{Loc research-sim-ui-suppress-tooltip}" />
                        <Button Name="AddButton" Access="Public" MinHeight="32" HorizontalExpand="True" ClipText="True"
                                ToolTip="{Loc research-sim-ui-add-tooltip}" />
                        <Button Name="RelateButton" Access="Public" MinHeight="32" HorizontalExpand="True" ClipText="True"
                                ToolTip="{Loc research-sim-ui-relate-tooltip}" />
                    </GridContainer>

                    <PanelContainer Name="ActionsHeader" Access="Public" Margin="0 6 0 0">
                        <Label Text="{Loc research-sim-ui-header-actions}" FontColorOverride="#FFFFFF" Margin="6 2" />
                    </PanelContainer>
                    <Button Name="SimulateButton" Access="Public" MinHeight="32" HorizontalExpand="True" ClipText="True" Margin="0 3 0 0" />
                    <Button Name="OverrideButton" Access="Public" MinHeight="32" HorizontalExpand="True" ClipText="True" Margin="0 3 0 0"
                            ToolTip="{Loc research-sim-ui-override-tooltip}" />
                    <Button Name="EjectTargetButton" Access="Public" MinHeight="32" HorizontalExpand="True" ClipText="True" Margin="0 3 0 0" />
                    <Button Name="EjectReferenceButton" Access="Public" MinHeight="32" HorizontalExpand="True" ClipText="True" Margin="0 3 0 0" />
                </BoxContainer>

                <!-- Right column: target, reference, recipe selection -->
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" MinWidth="420" SizeFlagsStretchRatio="3" Margin="4 0 0 0">
                    <PanelContainer Name="TargetHeader" Access="Public">
                        <Label Text="{Loc research-sim-ui-header-target}" FontColorOverride="#FFFFFF" Margin="6 2" />
                    </PanelContainer>
                    <PanelContainer Name="TargetStatusPanel" Access="Public" Margin="0 3 0 0">
                        <BoxContainer Orientation="Horizontal" Margin="6 1">
                            <SpriteView Name="TargetIcon" Access="Public" SetSize="24 24" Margin="0 0 6 0" />
                            <Label Name="TargetNameLabel" Access="Public" VerticalAlignment="Center" />
                        </BoxContainer>
                    </PanelContainer>
                    <PanelContainer Name="TargetPropertiesPanel" Access="Public" Margin="0 3 0 0">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BackgroundColor="#12141A" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Name="TargetPropertiesBox" Access="Public" Orientation="Vertical" Margin="6" SeparationOverride="4" />
                    </PanelContainer>

                    <PanelContainer Name="ReferenceHeader" Access="Public" Margin="0 6 0 0">
                        <Label Text="{Loc research-sim-ui-header-reference}" FontColorOverride="#FFFFFF" Margin="6 2" />
                    </PanelContainer>
                    <PanelContainer Name="ReferenceStatusPanel" Access="Public" Margin="0 3 0 0">
                        <BoxContainer Orientation="Horizontal" Margin="6 1">
                            <SpriteView Name="ReferenceIcon" Access="Public" SetSize="24 24" Margin="0 0 6 0" />
                            <Label Name="ReferenceNameLabel" Access="Public" VerticalAlignment="Center" />
                        </BoxContainer>
                    </PanelContainer>
                    <PanelContainer Name="ReferencePropertiesPanel" Access="Public" Margin="0 3 0 0">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BackgroundColor="#12141A" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Name="ReferencePropertiesBox" Access="Public" Orientation="Vertical" Margin="6" SeparationOverride="4" />
                    </PanelContainer>

                    <PanelContainer Name="RecipePickerHeader" Access="Public" Visible="False" Margin="0 6 0 0">
                        <Label Text="{Loc research-sim-ui-header-pick-recipe}" FontColorOverride="#FFFFFF" Margin="6 2" />
                    </PanelContainer>
                    <PanelContainer Name="RecipePickerPanel" Access="Public" Visible="False" Margin="0 3 0 0">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BackgroundColor="#12141A" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" Margin="6">
                            <BoxContainer Name="RecipeCandidatesBox" Access="Public" Orientation="Vertical" SeparationOverride="4" />
                            <Button Name="FinalizeButton" Access="Public" MinHeight="32" Disabled="True" ClipText="True" Margin="0 4 0 0" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </BoxContainer>
        </ScrollContainer>
    </PanelContainer>
</controls:ChemSimulatorWindow>
