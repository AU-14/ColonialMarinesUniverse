<ambassador:AmbassadorThirdPartyWindow
    xmlns="https://spacestation14.io"
    xmlns:ambassador="clr-namespace:Content.Client.CMU14.Ambassador"
    Title="{Loc ambassador-third-party-title}" MinSize="400 300">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="8">
        <Label Name="BudgetLabel" Access="Public" Text="" StyleClasses="LabelHeading" Margin="4 4" />
        <Label Text="{Loc ambassador-third-party-available}" StyleClasses="LabelHeading" Margin="4 8" />
        <ItemList Name="ThirdPartyList" Access="Public" SelectMode="Single" HorizontalExpand="True" VerticalExpand="True" MinSize="0 120" Margin="4 4" />
        <Label Name="CostLabel" Access="Public" Text="" Margin="4 4" />
        <Button Name="CallBtn" Access="Public" Text="{Loc ambassador-third-party-request}" HorizontalExpand="True" Margin="4 8" />
        <Label Name="StatusLabel" Access="Public" Text="" Margin="4 4" />
    </BoxContainer>
</ambassador:AmbassadorThirdPartyWindow>
