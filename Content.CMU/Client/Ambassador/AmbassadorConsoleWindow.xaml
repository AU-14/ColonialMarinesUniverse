<ambassador:AmbassadorConsoleWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ambassador="clr-namespace:Content.Client.CMU14.Ambassador"
    Title="{Loc ambassador-console-title}" MinSize="500 450">
    <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
            <Label Name="BudgetLabel" Access="Public" Text="{Loc ambassador-console-budget, amount='0'}" StyleClasses="LabelHeading" Margin="4 4" />
            <Label Name="FactionLabel" Access="Public" Text="" Margin="4 2" />
            <Label Text="{Loc ambassador-console-withdraw-section}" Margin="4 2" />
            <BoxContainer Orientation="Horizontal" Margin="4 2">
                <Button Name="Withdraw100" Access="Public" Text="$100" Margin="2 0" />
                <Button Name="Withdraw250" Access="Public" Text="$250" Margin="2 0" />
                <Button Name="Withdraw500" Access="Public" Text="$500" Margin="2 0" />
            </BoxContainer>
            <Label Text="{Loc ambassador-console-economy-section}" Margin="4 2" />
            <BoxContainer Orientation="Horizontal" Margin="4 2">
                <Button Name="ToggleEmbargo" Access="Public" Text="{Loc ambassador-console-toggle-embargo}" Margin="2 0" />
                <Button Name="ToggleTradePact" Access="Public" Text="{Loc ambassador-console-toggle-trade-pact}" Margin="2 0" />
            </BoxContainer>
            <Label Name="EmbargoStatus" Access="Public" Text="" Margin="8 0" />
            <Label Name="TradePactStatus" Access="Public" Text="" Margin="8 0" />
            <Label Text="{Loc ambassador-console-communications-section}" Margin="4 2" />
            <Button Name="ToggleCommsJam" Access="Public" Text="{Loc ambassador-console-toggle-comms-jam}" Margin="4 2" />
            <Label Name="CommsJamStatus" Access="Public" Text="" Margin="8 0" />
            <Label Text="{Loc ambassador-console-broadcast-section}" Margin="4 2" />
            <BoxContainer Orientation="Horizontal" Margin="4 2">
                <LineEdit Name="BroadcastInput" Access="Public" HorizontalExpand="True" PlaceHolder="{Loc ambassador-console-broadcast-placeholder}" Margin="2 0" />
                <Button Name="SendBroadcast" Access="Public" Text="{Loc ambassador-console-send}" Margin="2 0" />
            </BoxContainer>
            <Label Name="BroadcastCostLabel" Access="Public" Text="" Margin="8 0" />
            <Label Text="{Loc ambassador-console-signal-control-section}" Margin="4 2" />
            <BoxContainer Orientation="Horizontal" Margin="4 2">
                <Button Name="ToggleSignalBoost" Access="Public" Text="{Loc ambassador-console-signal-boost}" Margin="2 0" />
                <Button Name="ToggleSignalJam" Access="Public" Text="{Loc ambassador-console-signal-jam}" Margin="2 0" />
            </BoxContainer>
            <Label Name="SignalStatus" Access="Public" Text="" Margin="8 0" />
            <Label Text="{Loc ambassador-console-economy-overview-section}" Margin="4 2" />
            <BoxContainer Name="EconomyStatusPanel" Access="Public" Orientation="Vertical" Margin="8 2" />
            <Label Text="{Loc ambassador-console-radar-section}" Margin="4 2" />
            <Button Name="ScanRadarBtn" Access="Public" Text="{Loc ambassador-console-scan-radar}" HorizontalExpand="True" Margin="4 2" />
            <BoxContainer Name="RadarList" Access="Public" Orientation="Vertical" Margin="8 2" />
            <Label Text="{Loc ambassador-console-third-party-section}" Margin="4 2" />
            <Button Name="OpenThirdPartyBtn" Access="Public" Text="{Loc ambassador-console-open-third-party}" HorizontalExpand="True" Margin="4 2" />
        </BoxContainer>
    </ScrollContainer>
</ambassador:AmbassadorConsoleWindow>
