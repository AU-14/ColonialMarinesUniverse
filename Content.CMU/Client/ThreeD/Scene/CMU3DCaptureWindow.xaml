<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'cmu-3d-capture-title'}" MinSize="480 180">
    <BoxContainer Orientation="Vertical" SeparationOverride="12">
        <RichTextLabel Name="Instructions" MaxWidth="480" />
        <BoxContainer SeparationOverride="8">
            <Button Name="ChangeBinding" Text="{Loc 'cmu-3d-change-binding'}" HorizontalExpand="True" />
            <Button Name="StartLook" Text="{Loc 'cmu-3d-start-look'}" HorizontalExpand="True" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
