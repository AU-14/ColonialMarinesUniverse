<DefaultWindow xmlns="https://spacestation14.io" Title="{Loc 'cmu-insfor-ballot-title'}" MinSize="500 330" SetSize="692 438">
    <BoxContainer Orientation="Vertical" Margin="3" SeparationOverride="3">
        <PanelContainer Name="ContextPanel">
            <BoxContainer Margin="8 4" SeparationOverride="8">
                <RichTextLabel Name="Opponent" HorizontalExpand="True" VerticalAlignment="Center"/>
                <Label Name="Countdown" StyleClasses="LabelKeyText"/>
            </BoxContainer>
        </PanelContainer>
        <BoxContainer VerticalExpand="True" SeparationOverride="3">
            <PanelContainer Name="Navigation" SetWidth="202">
                <ScrollContainer HScrollEnabled="False" Margin="4">
                    <BoxContainer Name="FactionList" Orientation="Vertical" SeparationOverride="2"/>
                </ScrollContainer>
            </PanelContainer>
            <PanelContainer Name="Details" HorizontalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="5">
                    <BoxContainer SeparationOverride="6">
                        <TextureRect Name="Insignia" SetSize="30 30" CanShrink="True" Stretch="KeepAspectCentered" VerticalAlignment="Center"/>
                        <RichTextLabel Name="FactionName" HorizontalExpand="True" VerticalAlignment="Center" StyleClasses="LabelHeading"/>
                    </BoxContainer>
                    <BoxContainer Name="Tabs" SeparationOverride="3">
                        <Button Name="BriefingTab" ToggleMode="True" Text="{Loc 'cmu-insfor-ballot-briefing'}"/>
                        <Button Name="KitTab" ToggleMode="True" Text="{Loc 'insfor-select-cellkit-header'}"/>
                    </BoxContainer>
                    <ScrollContainer Name="DetailScroll" VerticalExpand="True" HScrollEnabled="False" RectClipContent="True">
                        <BoxContainer Name="DetailBody" Orientation="Vertical" SeparationOverride="6" Margin="2"/>
                    </ScrollContainer>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
        <PanelContainer Name="Actions">
            <BoxContainer Margin="6 4" SeparationOverride="6">
                <CheckBox Name="Exclude" Text="{Loc 'cmu-insfor-ballot-exclude'}" VerticalAlignment="Center"/>
                <Control HorizontalExpand="True"/>
                <Button Name="Vote" Text="{Loc 'cmu-insfor-ballot-vote'}"/>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</DefaultWindow>
