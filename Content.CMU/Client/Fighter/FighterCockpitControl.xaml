<LayoutContainer xmlns="https://spacestation14.io" xmlns:fighter="clr-namespace:Content.Client.CMU14.Fighter" xmlns:viewport="clr-namespace:Content.Client.Viewport" InheritChildMeasure="False" RectClipContent="True" HorizontalExpand="True" VerticalExpand="True" MouseFilter="Ignore">
    <LayoutContainer Name="ExteriorScene" InheritChildMeasure="False" LayoutContainer.AnchorRight="1" LayoutContainer.AnchorBottom="1" MouseFilter="Ignore">
        <viewport:ScalingViewport Name="Exterior" RenderZLevels="True" ApplyZLevelBlur="False" StretchMode="Nearest" RenderScaleMode="Fixed" MouseFilter="Ignore" LayoutContainer.AnchorRight="1" LayoutContainer.AnchorBottom="1" />
    </LayoutContainer>
    <fighter:FighterShipControl Name="Ship" MouseFilter="Ignore" />
    <fighter:FighterEffectsControl Name="Effects" MouseFilter="Ignore" LayoutContainer.AnchorRight="1" LayoutContainer.AnchorBottom="1" />
    <fighter:FighterHandoffControl Name="Handoff" MouseFilter="Ignore" LayoutContainer.AnchorRight="1" LayoutContainer.AnchorBottom="1" />
    <BoxContainer Name="LeftColumn" Orientation="Vertical" SeparationOverride="0">
        <PanelContainer Name="ViewPanel" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" SeparationOverride="5" Margin="8">
                <BoxContainer MinHeight="20" MaxHeight="20" SeparationOverride="6">
                    <fighter:FighterCockpitReadout Text="{Loc 'cmu-fighter-hud-title'}" HorizontalExpand="True" />
                    <fighter:FighterCockpitReadout Name="RoleTitle" MinWidth="96" MaxWidth="130" />
                </BoxContainer>
                <BoxContainer Name="Tabs" SeparationOverride="4" MinHeight="30" MaxHeight="30">
                    <fighter:FighterCockpitButton Name="FlightTab" Text="{Loc 'cmu-fighter-hud-airspace'}" HorizontalExpand="True" />
                    <fighter:FighterCockpitButton Name="TargetingTab" Text="{Loc 'cmu-fighter-console-optics'}" HorizontalExpand="True" />
                </BoxContainer>
                <LayoutContainer InheritChildMeasure="False" VerticalExpand="True">
                    <BoxContainer Name="RoutePanel" Orientation="Vertical" SeparationOverride="5" LayoutContainer.AnchorRight="1" LayoutContainer.AnchorBottom="1">
                        <LayoutContainer Name="ChartHost" InheritChildMeasure="False" VerticalExpand="True" />
                        <BoxContainer Name="RouteEditing" MinHeight="28" MaxHeight="28" SeparationOverride="4">
                            <fighter:FighterCockpitButton Name="Entry" Text="{Loc 'cmu-fighter-hud-entry'}" HorizontalExpand="True" />
                            <fighter:FighterCockpitButton Name="Exit" Text="{Loc 'cmu-fighter-hud-exit'}" HorizontalExpand="True" />
                            <fighter:FighterCockpitButton Name="Apply" Text="{Loc 'cmu-fighter-hud-apply'}" HorizontalExpand="True" />
                            <fighter:FighterCockpitButton Name="AirCover" Text="{Loc 'cmu-fighter-hud-cover'}" HorizontalExpand="True" />
                        </BoxContainer>
                        <fighter:FighterCockpitReadout Name="CoverageHelp" Visible="False" Text="{Loc 'cmu-fighter-cover-instruction'}" MinHeight="30" MaxHeight="30" />
                        <fighter:FighterCockpitReadout Name="RouteStatus" MinHeight="30" MaxHeight="30" />
                    </BoxContainer>
                    <BoxContainer Name="TargetingControls" Visible="False" Orientation="Vertical" SeparationOverride="4" LayoutContainer.AnchorRight="1" LayoutContainer.AnchorBottom="1">
                        <LayoutContainer Name="Scene" InheritChildMeasure="False" RectClipContent="True" VerticalExpand="True" MouseFilter="Ignore">
                            <viewport:ScalingViewport Name="Ground" RenderZLevels="True" ApplyZLevelBlur="False" StretchMode="Nearest" RenderScaleMode="Fixed" MouseFilter="Ignore" LayoutContainer.AnchorRight="1" LayoutContainer.AnchorBottom="1" />
                        </LayoutContainer>
                        <fighter:FighterCockpitReadout Name="Feed" MinHeight="18" MaxHeight="18" />
                        <BoxContainer MinHeight="28" MaxHeight="28" SeparationOverride="4">
                            <fighter:FighterCockpitButton Name="NormalVision" Text="{Loc 'cmu-fighter-vision-normal'}" HorizontalExpand="True" />
                            <fighter:FighterCockpitButton Name="NightVision" Text="{Loc 'cmu-fighter-hud-night'}" HorizontalExpand="True" />
                            <fighter:FighterCockpitButton Name="ThermalVision" Text="{Loc 'cmu-fighter-vision-thermal'}" HorizontalExpand="True" />
                        </BoxContainer>
                        <fighter:FighterCockpitReadout Name="ThermalStatus" MinHeight="18" MaxHeight="18" />
                        <fighter:FighterCockpitReadout Name="SensorStatus" MinHeight="20" MaxHeight="20" MouseFilter="Pass" />
                        <BoxContainer MinHeight="28" MaxHeight="28" SeparationOverride="4">
                            <fighter:FighterCockpitButton Name="CameraLock" Text="{Loc 'cmu-fighter-lock'}" HorizontalExpand="True" />
                            <fighter:FighterCockpitButton Name="CameraZoom" Text="{Loc 'cmu-fighter-console-zoom'}" HorizontalExpand="True" />
                            <fighter:FighterCockpitButton Name="Mark" Text="{Loc 'cmu-fighter-console-mark'}" HorizontalExpand="True" />
                            <fighter:FighterCockpitButton Name="Laser" Text="{Loc 'cmu-fighter-laser'}" HorizontalExpand="True" />
                        </BoxContainer>
                    </BoxContainer>
                </LayoutContainer>
                <ScrollContainer HScrollEnabled="False" MinHeight="32" MaxHeight="64">
                    <GridContainer Name="TargetList" Columns="3" HorizontalExpand="True" />
                </ScrollContainer>
                <fighter:FighterCockpitReadout Name="Observation" MinHeight="20" MaxHeight="20" />
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
    <BoxContainer Name="BottomBar" SeparationOverride="0">
        <PanelContainer Name="FlightPanel">
            <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="8">
                <BoxContainer MinHeight="22" MaxHeight="22">
                    <fighter:FighterCockpitReadout Text="{Loc 'cmu-fighter-hud-flight'}" MinWidth="64" />
                    <fighter:FighterCockpitReadout Name="FlightDisplay" HorizontalExpand="True" />
                </BoxContainer>
                <BoxContainer Name="FlightSettings" Orientation="Vertical" SeparationOverride="4">
                    <BoxContainer MinHeight="30" MaxHeight="30" SeparationOverride="4">
                        <fighter:FighterCockpitReadout Name="HeightLabel" MinWidth="60" MaxWidth="60" />
                        <PanelContainer Name="AltitudeSwitch" HorizontalExpand="True">
                            <BoxContainer SeparationOverride="0">
                                <fighter:FighterCockpitButton Name="LowAltitude" Text="{Loc 'cmu-fighter-hud-low'}" Segmented="True" HorizontalExpand="True" />
                                <fighter:FighterCockpitButton Name="MediumAltitude" Text="{Loc 'cmu-fighter-hud-cloud'}" Segmented="True" SegmentDivider="True" HorizontalExpand="True" />
                                <fighter:FighterCockpitButton Name="HighAltitude" Text="{Loc 'cmu-fighter-hud-high'}" Segmented="True" SegmentDivider="True" HorizontalExpand="True" />
                            </BoxContainer>
                        </PanelContainer>
                    </BoxContainer>
                    <BoxContainer MinHeight="30" MaxHeight="30" SeparationOverride="4">
                        <fighter:FighterCockpitReadout Name="SpeedLabel" MinWidth="60" MaxWidth="60" />
                        <PanelContainer Name="SpeedSwitch" HorizontalExpand="True">
                            <BoxContainer SeparationOverride="0">
                                <fighter:FighterCockpitButton Name="NearStall" Text="{Loc 'cmu-fighter-hud-slow'}" Segmented="True" HorizontalExpand="True" />
                                <fighter:FighterCockpitButton Name="Cruise" Text="{Loc 'cmu-fighter-preset-speed-cruise'}" Segmented="True" SegmentDivider="True" HorizontalExpand="True" />
                                <fighter:FighterCockpitButton Name="Afterburner" Text="{Loc 'cmu-fighter-hud-burner'}" Segmented="True" SegmentDivider="True" HorizontalExpand="True" />
                            </BoxContainer>
                        </PanelContainer>
                    </BoxContainer>
                </BoxContainer>
                <fighter:FighterCockpitReadout Name="CrewStatus" MinHeight="20" MaxHeight="20" />
                <fighter:FighterCockpitReadout Name="FlightHelp" MinHeight="28" MaxHeight="28" />
            </BoxContainer>
        </PanelContainer>
        <PanelContainer Name="LoadoutPanel" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="8">
                <BoxContainer MinHeight="24" MaxHeight="24" SeparationOverride="8">
                    <fighter:FighterCockpitReadout Text="{Loc 'cmu-fighter-weapons-heading'}" MinWidth="64" MaxWidth="64" />
                    <fighter:FighterCockpitReadout Name="WeaponName" HorizontalExpand="True" MouseFilter="Pass" />
                </BoxContainer>
                <BoxContainer MinHeight="64" MaxHeight="64" SeparationOverride="4">
                    <LayoutContainer Name="WeaponSlots" InheritChildMeasure="False" HorizontalExpand="True" />
                    <fighter:FighterCockpitButton Name="Gau" Text="{Loc 'cmu-fighter-kind-gau'}" VerticalReadout="True" MinWidth="60" MaxWidth="60" />
                </BoxContainer>
                <BoxContainer Name="FireControls" MinHeight="26" MaxHeight="26" SeparationOverride="4">
                    <BoxContainer Name="RunAssist" HorizontalExpand="True" SizeFlagsStretchRatio="2" SeparationOverride="4">
                        <fighter:FighterCockpitButton Name="PrepareRun" Text="{Loc 'cmu-fighter-hud-prepare'}" HorizontalExpand="True" />
                        <fighter:FighterCockpitButton Name="QueueFire" Text="{Loc 'cmu-fighter-hud-queue'}" HorizontalExpand="True" />
                    </BoxContainer>
                    <fighter:FighterCockpitButton Name="Fire" Text="{Loc 'cmu-fighter-fire-button'}" Disabled="True" HorizontalExpand="True" />
                </BoxContainer>
                <fighter:FighterCockpitReadout Name="FireStatus" MinHeight="20" MaxHeight="20" />
            </BoxContainer>
        </PanelContainer>
        <PanelContainer Name="ControlsPanel">
            <BoxContainer Name="ControlsContent" Orientation="Vertical" SeparationOverride="4" Margin="8">
                <fighter:FighterCockpitReadout Text="{Loc 'cmu-fighter-hud-mission'}" MinHeight="20" MaxHeight="20" />
                <BoxContainer Name="MissionActions" Orientation="Vertical" SeparationOverride="4">
                    <fighter:FighterCockpitButton Name="Launch" Text="{Loc 'cmu-fighter-launch'}" MinHeight="32" MaxHeight="32" />
                    <BoxContainer MinHeight="30" MaxHeight="30" SeparationOverride="4">
                        <fighter:FighterCockpitButton Name="Return" Text="{Loc 'cmu-fighter-takeoff'}" HorizontalExpand="True" />
                        <fighter:FighterCockpitButton Name="Flares" Text="{Loc 'cmu-fighter-flares-short'}" Disabled="True" HorizontalExpand="True" />
                    </BoxContainer>
                    <BoxContainer MinHeight="30" MaxHeight="30" SeparationOverride="4">
                        <fighter:FighterCockpitButton Name="Swap" Text="{Loc 'cmu-fighter-hud-swap'}" HorizontalExpand="True" />
                        <fighter:FighterCockpitButton Name="Leave" Text="{Loc 'cmu-fighter-unbuckle'}" HorizontalExpand="True" />
                    </BoxContainer>
                </BoxContainer>
                <fighter:FighterCockpitButton Name="StopObserving" Visible="False" Text="{Loc 'cmu-fighter-stop-observing'}" MinHeight="32" MaxHeight="32" />
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
    <PanelContainer Name="IncomingPanel" Visible="False" LayoutContainer.AnchorLeft=".33" LayoutContainer.AnchorRight=".67" LayoutContainer.AnchorTop=".30" LayoutContainer.AnchorBottom=".53">
        <BoxContainer Orientation="Vertical" SeparationOverride="5" Margin="9">
            <fighter:FighterCockpitReadout Name="IncomingTitle" Warning="True" VerticalExpand="True" />
            <fighter:FighterCockpitReadout Name="IncomingStatus" MinHeight="24" MaxHeight="28" />
            <fighter:FighterCockpitButton Name="IncomingFlares" Text="{Loc 'cmu-fighter-flares'}" MinHeight="44" MaxHeight="54" VerticalExpand="True" />
        </BoxContainer>
    </PanelContainer>
    <PanelContainer Name="EjectPanel" Visible="False" LayoutContainer.AnchorLeft=".25" LayoutContainer.AnchorRight=".72" LayoutContainer.AnchorTop=".30" LayoutContainer.AnchorBottom=".62">
        <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="14">
            <fighter:FighterCockpitReadout Text="{Loc 'cmu-fighter-eject-warning'}" Warning="True" MinHeight="30" />
            <fighter:FighterCockpitReadout Name="EjectWarning" VerticalExpand="True" />
            <BoxContainer SeparationOverride="10" MinHeight="48">
                <fighter:FighterCockpitButton Name="CancelEject" Text="{Loc 'cmu-fighter-eject-cancel'}" HorizontalExpand="True" />
                <fighter:FighterCockpitButton Name="ConfirmEject" Text="{Loc 'cmu-fighter-eject-confirm'}" HorizontalExpand="True" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</LayoutContainer>
