<DefaultWindow xmlns="https://spacestation14.io"
               Title="Ground Text"
               MinSize="460 610"
               SetSize="460 610">
    <BoxContainer Orientation="Vertical" Margin="8">
        <Label Text="Text (new lines are preserved)" />
        <TextEdit Name="TextInput" MinHeight="150" VerticalExpand="True" HorizontalExpand="True" />

        <Label Name="LetterSpacingLabel" Text="Letter spacing: 1.00" Margin="0 8 0 0" />
        <Slider Name="LetterSpacing" MinValue="0.35" MaxValue="2" Value="1" HorizontalExpand="True" />

        <Label Name="LineSpacingLabel" Text="Line spacing: 1.25" Margin="0 8 0 0" />
        <Slider Name="LineSpacing" MinValue="0.5" MaxValue="3" Value="1.25" HorizontalExpand="True" />

        <Label Name="WonkinessLabel" Text="Wonkiness: 0.00" Margin="0 8 0 0" />
        <Slider Name="Wonkiness" MinValue="0" MaxValue="0.75" Value="0" HorizontalExpand="True" />

        <Label Text="Color" Margin="0 8 0 0" />
        <ColorSelectorSliders Name="ColorSelector" IsAlphaVisible="True" />

        <Label Text="Hold the tool and face the direction the text should face. Supports A-Z, 0-9, &amp; * - = ! # $ @ + ?." Margin="0 8 0 8" />
        <Button Name="PlaceButton" Text="Place ground text" HorizontalAlignment="Center" MinWidth="180" />
    </BoxContainer>
</DefaultWindow>
