<dropPod:CMUDropPodConsoleWindow
    xmlns="https://spacestation14.io"
    xmlns:dropPod="clr-namespace:Content.Client.CMU14.DropPod"
    xmlns:tacticalMap="clr-namespace:Content.Client._RMC14.TacticalMap"
    Title="{Loc 'cmu-drop-pod-console-title'}"
    MinSize="1000 620"
    SetSize="1100 700">
    <PanelContainer StyleClasses="CrtPanel" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
            <PanelContainer StyleClasses="CrtHeaderPanel">
                <BoxContainer Orientation="Horizontal" Margin="4 2">
                    <Label Text="{Loc 'cmu-drop-pod-console-title'}" StyleClasses="CrtHeading"
                           HorizontalExpand="True" />
                    <Label Name="CooldownLabel" Access="Public" StyleClasses="CrtHeading" />
                </BoxContainer>
            </PanelContainer>
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True"
                          SeparationOverride="6">
                <PanelContainer StyleClasses="CrtInsetPanel" HorizontalExpand="True" VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="4" SeparationOverride="4">
                        <Label Text="{Loc 'cmu-drop-pod-console-map-hint'}" StyleClasses="CrtDimText" />
                        <PanelContainer StyleClasses="CrtSectionRule" HorizontalExpand="True" MinHeight="1" />
                        <tacticalMap:TacticalMapControl Name="Map" Access="Public"
                                                        Stretch="KeepAspectCentered" MouseFilter="Stop"
                                                        HorizontalExpand="True" VerticalExpand="True" Margin="2" />
                    </BoxContainer>
                </PanelContainer>
                <BoxContainer Orientation="Vertical" MinWidth="320" VerticalExpand="True" SeparationOverride="6">
                    <PanelContainer StyleClasses="CrtInsetPanel">
                        <BoxContainer Orientation="Vertical" Margin="4" SeparationOverride="4">
                            <Label Text="{Loc 'cmu-drop-pod-console-insertion'}" StyleClasses="CrtHeading" />
                            <PanelContainer StyleClasses="CrtSectionRule" HorizontalExpand="True" MinHeight="1" />
                            <Label Name="TargetLabel" Access="Public" />
                            <Label Name="TargetHintLabel" Access="Public" StyleClasses="CrtDimText" />
                            <Button Name="ClearTargetButton" Access="Public"
                                    Text="{Loc 'cmu-drop-pod-console-clear-target'}" />
                        </BoxContainer>
                    </PanelContainer>
                    <PanelContainer StyleClasses="CrtInsetPanel" VerticalExpand="True">
                        <BoxContainer Orientation="Vertical" Margin="4" SeparationOverride="4">
                            <Label Text="{Loc 'cmu-drop-pod-console-pods'}" StyleClasses="CrtHeading" />
                            <PanelContainer StyleClasses="CrtSectionRule" HorizontalExpand="True" MinHeight="1" />
                            <ScrollContainer HScrollEnabled="False" VScrollEnabled="True" VerticalExpand="True">
                                <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                                    <Label Name="PodsEmptyLabel" Access="Public" StyleClasses="CrtDimText"
                                           Text="{Loc 'cmu-drop-pod-console-no-pods'}" Margin="4" Visible="False" />
                                    <BoxContainer Name="PodList" Access="Public" Orientation="Vertical"
                                                  HorizontalExpand="True" SeparationOverride="2" />
                                </BoxContainer>
                            </ScrollContainer>
                            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                                <Button Name="SelectAllButton" Access="Public" HorizontalExpand="True"
                                        Text="{Loc 'cmu-drop-pod-console-select-all'}" />
                                <Button Name="RefreshButton" Access="Public" HorizontalExpand="True"
                                        Text="{Loc 'cmu-drop-pod-console-refresh'}" />
                            </BoxContainer>
                        </BoxContainer>
                    </PanelContainer>
                    <Button Name="FireButton" Access="Public" StyleClasses="Caution" MinHeight="36"
                            Text="{Loc 'cmu-drop-pod-console-fire'}" />
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</dropPod:CMUDropPodConsoleWindow>
