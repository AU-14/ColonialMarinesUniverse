<Control xmlns="https://spacestation14.io"
         xmlns:picker="clr-namespace:Content.Client.CMU14.UserInterface.ColorPicker">
    <BoxContainer Orientation="Vertical" SeparationOverride="2">
        <!-- Laid out like OptionDropDown - label left, control right - so it lines up with the dropdowns
             around it. -->
        <PanelContainer StyleClasses="CrtOptionRow">
            <BoxContainer Orientation="Horizontal">
                <Label Name="TitleLabel" HorizontalExpand="True" MinWidth="160" VerticalAlignment="Center" />
                <!-- Wider than a dropdown: colour names run long ("Very light strong greenish cyan"). -->
                <ContainerButton Name="SwatchButton" MinWidth="320">
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <PanelContainer Name="Swatch" MinSize="14 14" VerticalAlignment="Center" />
                        <Label Name="NameLabel" HorizontalExpand="True" ClipText="True" VerticalAlignment="Center" />
                        <TextureRect StyleClasses="optionTriangle" VerticalAlignment="Center" />
                    </BoxContainer>
                </ContainerButton>
            </BoxContainer>
        </PanelContainer>
        <!-- Expands in place rather than floating over the tab, so it can't be clipped by the window edge
             and nothing overlays the options behind it. -->
        <picker:CmuColorPickerPanel Name="Panel" Visible="False" HorizontalExpand="True" />
    </BoxContainer>
</Control>
