<controls:HospitalEmergencyComputerWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client.CMU14.Hospital"
    Title="{Loc hospital-emergency-window-title}" MinSize="540 420">
    <BoxContainer Orientation="Vertical" SeparationOverride="6">
        <Label Text="{Loc hospital-emergency-header}" StyleClasses="LabelHeading" />
        <Label Name="StatusLabel" Access="Public" Text="{Loc hospital-emergency-status-standing-by}" />
        <Label Name="LandingZoneLabel" Access="Public" Text="{Loc hospital-emergency-landing-zone-searching}" StyleClasses="LabelSubText" />

        <PanelContainer StyleClasses="LowDivider" MinHeight="2" />

        <Label Text="{Loc hospital-emergency-incident-report-heading}" StyleClasses="LabelSubText" />
        <RichTextLabel Name="IncidentReportLabel" Access="Public" Text="{Loc hospital-emergency-no-active-incident}" MinSize="0 72" MaxWidth="500" HorizontalExpand="True" />

        <GridContainer Columns="2" HorizontalExpand="True">
            <Label Text="{Loc hospital-emergency-casualties-label}" />
            <Label Name="CasualtiesLabel" Access="Public" Text="0" />
            <Label Text="{Loc hospital-emergency-severity-label}" />
            <Label Name="SeverityLabel" Access="Public" Text="--" />
            <Label Text="{Loc hospital-emergency-reward-label}" />
            <Label Name="RewardLabel" Access="Public" Text="$0" />
            <Label Text="{Loc hospital-emergency-patients-label}" />
            <Label Name="PatientsLabel" Access="Public" />
            <Label Text="{Loc hospital-emergency-timer-label}" />
            <Label Name="TimerLabel" Access="Public" Text="--" />
        </GridContainer>

        <PanelContainer StyleClasses="LowDivider" MinHeight="2" />

        <Label Name="AuditLabel" Access="Public" Text="{Loc hospital-emergency-audit-none}" StyleClasses="LabelSubText" />

        <GridContainer Columns="2" HorizontalExpand="True">
            <Button Name="ApproveLandingButton" Access="Public" Text="{Loc hospital-emergency-approve-landing}" HorizontalExpand="True" />
            <Button Name="SkipContractButton" Access="Public" Text="{Loc hospital-emergency-skip-contract}" HorizontalExpand="True" />
            <Button Name="ReleaseShuttleButton" Access="Public" Text="{Loc hospital-emergency-release-shuttle}" HorizontalExpand="True" />
            <Button Name="RequestPickupButton" Access="Public" Text="{Loc hospital-emergency-request-pickup}" HorizontalExpand="True" />
        </GridContainer>
    </BoxContainer>
</controls:HospitalEmergencyComputerWindow>
