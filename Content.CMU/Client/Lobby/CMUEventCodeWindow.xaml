<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="{Loc 'cmu-event-code-title'}" MinWidth="420">
    <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="8">
        <RichTextLabel Text="{Loc 'cmu-event-code-description'}" MaxWidth="400" />
        <LineEdit Name="CodeInput" Access="Public" PlaceHolder="{Loc 'cmu-event-code-placeholder'}" />
        <Button Name="SubmitButton" Access="Public" Text="{Loc 'cmu-event-code-submit'}" />
        <RichTextLabel Name="StatusLabel" Access="Public" MaxWidth="400" />
    </BoxContainer>
</DefaultWindow>
