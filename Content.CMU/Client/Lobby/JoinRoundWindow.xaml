<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="clr-namespace:Content.Client.CMU14.Interface">
    <!-- Four faction choices in a 2x2 grid, each a blurb over its join button. Built in the
         code-behind - see BuildColumn. -->
    <PanelContainer Name="Ground" Access="Public" HorizontalExpand="True" VerticalExpand="True">
        <!-- SeparationOverride is set in the code-behind, not here - it is RowGap, the gap between the
             two rows, not CmuPanelMetrics.RowSeparation. -->
        <BoxContainer Name="Choices" Access="Public" Orientation="Vertical" HorizontalExpand="True"
                      VerticalExpand="True"
                      Margin="{x:Static ui:CmuPanelMetrics.PanelPadding}" />
    </PanelContainer>
</DefaultWindow>
