<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
               Title="{Loc anprc-window-title}"
               MinWidth="400"
               MinHeight="420"
               SetSize="420 680">

  <PanelContainer>
    <PanelContainer.PanelOverride>
      <gfx:StyleBoxFlat BackgroundColor="#0E0F13" />
    </PanelContainer.PanelOverride>

    <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="5">

      <!-- Header -->
      <PanelContainer>
        <PanelContainer.PanelOverride>
          <gfx:StyleBoxFlat BackgroundColor="#181A20" BorderColor="#343846" BorderThickness="1" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Horizontal" Margin="6,4" SeparationOverride="6">
          <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="1">
            <Label Text="AN/PRC-117G" FontColorOverride="#C8D2E8" />
            <Label Text="{Loc anprc-ui-header-subtitle}" FontColorOverride="#687A9A" />
          </BoxContainer>
          <BoxContainer Orientation="Vertical" SeparationOverride="1">
            <Label Name="HeaderPowerLabel" Text="{Loc anprc-ui-header-power-placeholder}" FontColorOverride="#687A9A" />
            <Label Name="HeaderLinkLabel" Text="{Loc anprc-ui-header-link-placeholder}" FontColorOverride="#687A9A" />
          </BoxContainer>
        </BoxContainer>
      </PanelContainer>

      <ScrollContainer VerticalExpand="True" SizeFlagsStretchRatio="3">
        <BoxContainer Orientation="Vertical" SeparationOverride="5">

          <!-- LCD -->
          <PanelContainer>
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#07130A" BorderColor="#245236" BorderThickness="2" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="8,6" SeparationOverride="3">
              <BoxContainer Orientation="Horizontal" SeparationOverride="5">
                <Label Name="LcdModeLabel" Text="{Loc anprc-ui-lcd-mode-placeholder}" FontColorOverride="#4A7A55" />
                <Control HorizontalExpand="True" />
                <Label Name="TxIndicator" Text="●" FontColorOverride="#1E4A2E" />
                <Label Name="TxLabel" Text="{Loc anprc-ui-tx-off}" FontColorOverride="#1E4A2E" />
                <Label Name="CryptoLabel" Text="{Loc anprc-ui-crypto-sec}" FontColorOverride="#4A7A55" />
              </BoxContainer>
              <Label Name="FrequencyLabel" Text="-- . ---" FontColorOverride="#1E4A2E" />
              <Label Name="ChannelNameLabel" Text="{Loc anprc-ui-no-net-loaded}" FontColorOverride="#1E4A2E" />
              <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Name="ChannelIdLabel" Text="{Loc anprc-ui-channel-placeholder}" FontColorOverride="#4A7A55" HorizontalExpand="True" />
                <Label Name="BandLabel" Text="{Loc anprc-ui-band-placeholder}" FontColorOverride="#4A7A55" />
                <Label Name="WaveformLabel" Text="{Loc anprc-ui-waveform-placeholder}" FontColorOverride="#4A7A55" />
              </BoxContainer>
              <BoxContainer Orientation="Horizontal" SeparationOverride="6" Margin="0,3,0,0">
                <Label Text="{Loc anprc-ui-signal}" FontColorOverride="#4A7A55" />
                <Label Name="SignalBarsLabel" Text="░░░░░░░░" FontColorOverride="#1E4A2E" HorizontalExpand="True" />
                <Label Text="{Loc anprc-ui-battery}" FontColorOverride="#4A7A55" />
                <Label Name="BatteryBarsLabel" Text="░░░░░░" FontColorOverride="#1E4A2E" />
              </BoxContainer>
              <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Name="BitStatusLabel" Text="{Loc anprc-ui-bit-offline}" FontColorOverride="#4A7A55" HorizontalExpand="True" />
                <Label Name="AntennaLabel" Text="{Loc anprc-ui-antenna-placeholder}" FontColorOverride="#4A7A55" HorizontalExpand="True" />
                <Label Name="FaultLabel" Text="{Loc anprc-ui-fault-none}" FontColorOverride="#687A9A" />
              </BoxContainer>
            </BoxContainer>
          </PanelContainer>

          <!-- Callsign -->
          <BoxContainer Orientation="Horizontal" Margin="2,1,2,0">
            <Label Text="{Loc anprc-ui-callsign}" FontColorOverride="#A9C3E8" HorizontalExpand="True" />
            <Label Name="CallsignDisplayLabel" Text="{Loc anprc-ui-callsign-not-set}" FontColorOverride="#687A9A" />
          </BoxContainer>
          <PanelContainer>
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#17181D" BorderColor="#3D4059" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="6,5" SeparationOverride="4">
              <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <OptionButton Name="CallsignPresetButton" MinWidth="110" />
                <LineEdit Name="CallsignLineEdit"
                          HorizontalExpand="True"
                          PlaceHolder="{Loc anprc-ui-callsign-placeholder}" />
                <Button Name="CallsignSetButton" Text="{Loc anprc-ui-set-button}" MinWidth="48" />
              </BoxContainer>
              <Label Text="{Loc anprc-ui-callsign-help}" FontColorOverride="#4A7A55" />
              <Button Name="DirectoryButton" Text="{Loc anprc-ui-callsign-directory}" />
            </BoxContainer>
          </PanelContainer>

          <!-- Preset slots -->
          <BoxContainer Orientation="Horizontal" Margin="2,1,2,0">
            <Label Text="{Loc anprc-ui-preset-nets}" FontColorOverride="#A9C3E8" HorizontalExpand="True" />
            <Label Name="PresetSummaryLabel" Text="0/4" FontColorOverride="#687A9A" />
          </BoxContainer>

          <PanelContainer Name="PresetPanel">
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#17181D" BorderColor="#3D4059" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="5" SeparationOverride="4">
              <!-- Slot rows are added dynamically from code-behind -->
              <BoxContainer Name="SlotListContainer" Orientation="Vertical" SeparationOverride="3" />
              <!-- ADD button row -->
              <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Button Name="AddSlotButton" Text="{Loc anprc-ui-add-net}" HorizontalExpand="True" />
              </BoxContainer>
              <Label Text="{Loc anprc-ui-preset-transmit-help}" FontColorOverride="#4A7A55" />
            </BoxContainer>
          </PanelContainer>

          <!-- Add-slot panel (hidden by default) -->
          <PanelContainer Name="AddSlotPanel">
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#0E1A10" BorderColor="#245236" BorderThickness="2" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="6,5" SeparationOverride="4">
              <Label Text="{Loc anprc-ui-new-net-label}" FontColorOverride="#A9C3E8" />
              <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <LineEdit Name="AddSlotLabelEdit"
                          HorizontalExpand="True"
                          PlaceHolder="{Loc anprc-ui-new-net-placeholder}" />
                <Button Name="AddSlotConfirmButton" Text="{Loc anprc-ui-add-button}" MinWidth="48" />
                <Button Name="AddSlotCancelButton" Text="{Loc anprc-ui-cancel-button}" MinWidth="60" />
              </BoxContainer>
            </BoxContainer>
          </PanelContainer>

          <!-- Slot entry panel (hidden by default) -->
          <PanelContainer Name="SlotEntryPanel">
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#0E1A10" BorderColor="#245236" BorderThickness="2" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="6,5" SeparationOverride="4">
              <Label Name="SlotEntryHeaderLabel" Text="{Loc anprc-ui-tune-slot}" FontColorOverride="#A9C3E8" />

              <!-- Tab buttons -->
              <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Button Name="EntryTabFreqButton" Text="{Loc anprc-ui-frequency-tab}" HorizontalExpand="True" />
                <Button Name="EntryTabNetButton" Text="{Loc anprc-ui-net-tab}" HorizontalExpand="True" />
                <Button Name="EntryTabClearButton" Text="{Loc anprc-ui-clear-tab}" HorizontalExpand="True" />
              </BoxContainer>

              <!-- FREQ tab content -->
              <BoxContainer Name="EntryFreqPanel" Orientation="Horizontal" SeparationOverride="4">
                <LineEdit Name="EntryFreqLineEdit"
                          HorizontalExpand="True"
                          PlaceHolder="{Loc anprc-ui-frequency-placeholder}" />
                <Button Name="EntryFreqConfirmButton" Text="{Loc anprc-ui-set-button}" MinWidth="48" />
              </BoxContainer>

              <!-- NET tab content: scrollable channel list -->
              <ScrollContainer Name="EntryNetScroll" MinHeight="120" MaxHeight="160">
                <BoxContainer Name="EntryNetList" Orientation="Vertical" SeparationOverride="2" />
              </ScrollContainer>

              <Button Name="SlotEntryCloseButton" Text="{Loc anprc-ui-close-button}" />
            </BoxContainer>
          </PanelContainer>

          <!-- Controls -->
          <PanelContainer>
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#17181D" BorderColor="#3D4059" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="6,5" SeparationOverride="4">
              <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Button Name="ModeButton" HorizontalExpand="True" Text="{Loc anprc-ui-mode-fh}" />
                <Button Name="MonitorButton" HorizontalExpand="True" Text="{Loc anprc-ui-monitor-off}" />
                <Button Name="ScanButton" HorizontalExpand="True" Text="{Loc anprc-ui-scan-off}" />
                <Button Name="SquelchButton" HorizontalExpand="True" Text="{Loc anprc-ui-squelch-default}" />
                <Button Name="TxPowerButton" HorizontalExpand="True" Text="{Loc anprc-ui-tx-power-default}" />
              </BoxContainer>
              <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Text="{Loc anprc-ui-role}" FontColorOverride="#687A9A" />
                <Label Name="RoleValueLabel" Text="{Loc anprc-ui-role-rto-relay}" FontColorOverride="#C8D2E8" HorizontalExpand="True" />
                <Label Text="{Loc anprc-ui-relay}" FontColorOverride="#687A9A" />
                <Label Name="RelayValueLabel" Text="{Loc anprc-ui-relay-standby}" FontColorOverride="#C8D2E8" />
              </BoxContainer>
              <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Name="DiagnosticLineA" Text="{Loc anprc-ui-anchor-offline}" FontColorOverride="#687A9A" HorizontalExpand="True" />
                <Label Name="DiagnosticLineB" Text="{Loc anprc-ui-bypass-no}" FontColorOverride="#687A9A" />
              </BoxContainer>
              <BoxContainer Orientation="Horizontal" SeparationOverride="4" Margin="0,3,0,0">
                <Button Name="RadioCheckButton" Text="{Loc anprc-ui-radio-check}" HorizontalExpand="True" />
              </BoxContainer>
            </BoxContainer>
          </PanelContainer>

          <!-- Search receiver -->
          <BoxContainer Orientation="Horizontal" Margin="2,1,2,0">
            <Label Text="{Loc anprc-ui-search}" FontColorOverride="#A9C3E8" HorizontalExpand="True" />
            <Label Name="SweepStatusLabel" Text="{Loc anprc-ui-search-idle}" FontColorOverride="#687A9A" />
          </BoxContainer>
          <PanelContainer>
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#17181D" BorderColor="#3D4059" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="6,5" SeparationOverride="4">
              <Label Name="SweepBandLabel" Text="{Loc anprc-ui-band-idle}" FontColorOverride="#4A7A55" />
              <Label Name="SweepHintLabel"
                     Text="{Loc anprc-ui-search-help}"
                     FontColorOverride="#687A9A" />
              <Button Name="SweepButton" Text="{Loc anprc-ui-start-search}" />
              <Label Text="{Loc anprc-ui-contacts}" FontColorOverride="#A9C3E8" Margin="0,3,0,0" />
              <BoxContainer Name="SweepContactList" Orientation="Vertical" SeparationOverride="2" />
            </BoxContainer>
          </PanelContainer>

          <!-- COMSEC -->
          <BoxContainer Orientation="Horizontal" Margin="2,1,2,0">
            <Label Text="{Loc anprc-ui-comsec}" FontColorOverride="#A9C3E8" HorizontalExpand="True" />
            <Label Name="CryptoStatusLabel" Text="{Loc anprc-ui-unsecured}" FontColorOverride="#D65A5A" />
          </BoxContainer>
          <PanelContainer>
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#17181D" BorderColor="#3D4059" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="6,5" SeparationOverride="4">
              <Label Name="CryptoFillLabel" Text="{Loc anprc-ui-fill-none}" FontColorOverride="#687A9A" />
              <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Button Name="ZeroizeButton" Text="{Loc anprc-ui-zeroize}" HorizontalExpand="True" StyleClasses="Caution" />
                <Button Name="DestroyButton" Text="{Loc anprc-ui-destroy}" HorizontalExpand="True" StyleClasses="Caution" />
              </BoxContainer>
              <Button Name="RecryptoButton" Text="{Loc anprc-recrypto-button}" StyleClasses="Caution" />
            </BoxContainer>
          </PanelContainer>

        </BoxContainer>
      </ScrollContainer>

      <!-- Net log: outside the settings scroll so it grows with the window -->
      <BoxContainer Orientation="Horizontal" Margin="2,1,2,0">
        <Label Text="{Loc anprc-ui-net-log}" FontColorOverride="#A9C3E8" HorizontalExpand="True" />
        <Label Name="NetLogCountLabel" Text="{Loc anprc-ui-net-log-zero-entries}" FontColorOverride="#687A9A" />
      </BoxContainer>
      <BoxContainer Orientation="Horizontal" SeparationOverride="4">
        <OptionButton Name="NetLogChannelFilter" MinWidth="120" />
        <LineEdit Name="NetLogSearchEdit"
                  HorizontalExpand="True"
                  PlaceHolder="{Loc anprc-ui-net-log-filter-placeholder}" />
        <Button Name="NetLogFilterClearButton" Text="{Loc anprc-ui-clear-filter}" MinWidth="44" />
      </BoxContainer>
      <BoxContainer Orientation="Horizontal" SeparationOverride="4">
        <Button Name="PrintLogButton" Text="{Loc anprc-ui-print-log}" HorizontalExpand="True" />
        <Button Name="PrintInterceptsButton" Text="{Loc anprc-ui-print-intercepts}" HorizontalExpand="True" />
      </BoxContainer>
      <PanelContainer VerticalExpand="True" SizeFlagsStretchRatio="2">
        <PanelContainer.PanelOverride>
          <gfx:StyleBoxFlat BackgroundColor="#07130A" BorderColor="#245236" BorderThickness="1" />
        </PanelContainer.PanelOverride>
        <ScrollContainer VerticalExpand="True" MinHeight="100">
          <BoxContainer Name="NetLogContainer" Orientation="Vertical" SeparationOverride="2" Margin="4,3" />
        </ScrollContainer>
      </PanelContainer>

      <!-- Footer -->
      <PanelContainer>
        <PanelContainer.PanelOverride>
          <gfx:StyleBoxFlat BackgroundColor="#181A20" BorderColor="#343846" BorderThickness="1" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Horizontal" Margin="6,5" SeparationOverride="6">
          <Button Name="PowerButton" Text="{Loc anprc-power-off-button}" MinWidth="96" />
          <Label Name="StatusLabel" Text="" FontColorOverride="#A9C3E8" VerticalAlignment="Center" HorizontalExpand="True" />
        </BoxContainer>
      </PanelContainer>

    </BoxContainer>
  </PanelContainer>

</DefaultWindow>
