<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:recon="clr-namespace:Content.Client.CMU14.TacticalMap.Reconstruction"
               xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
               Title="{Loc cmu-recon-title}" MinSize="680 420" SetSize="1280 820">
  <PanelContainer>
    <PanelContainer.PanelOverride>
      <gfx:StyleBoxFlat BackgroundColor="#0B141D" BorderColor="#304751" BorderThickness="1" />
    </PanelContainer.PanelOverride>
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
      <BoxContainer Orientation="Horizontal" SeparationOverride="10">
        <Label Text="{Loc cmu-recon-heading}" FontColorOverride="#C6E9E9" HorizontalExpand="True" />
        <Label Name="Progress" FontColorOverride="#829DA9" />
        <Label Name="Feed" Text="{Loc cmu-recon-feed}" FontColorOverride="#75C8BA" />
      </BoxContainer>
      <BoxContainer Orientation="Horizontal" VerticalExpand="True" SeparationOverride="10">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6">
          <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <Button Name="TopDown" Text="{Loc cmu-recon-top-down}" />
            <Button Name="Reset" Text="{Loc cmu-recon-reset}" />
            <Button Name="CenterPlayer" Text="{Loc cmu-recon-center-player}" Disabled="True" />
            <CheckBox Name="Pencil" Text="{Loc cmu-recon-pencil}" Margin="12,0,0,0" />
            <CheckBox Name="PlaceText" Text="{Loc cmu-recon-place-text}" />
            <Button Name="Send" Text="{Loc cmu-recon-send}" Disabled="True" />
          </BoxContainer>
          <recon:CMUReconstructionControl Name="View" HorizontalExpand="True" VerticalExpand="True" RectClipContent="True" />
          <RichTextLabel Name="Controls" Text="{Loc cmu-recon-controls}" />
        </BoxContainer>
        <ScrollContainer SetWidth="168" HScrollEnabled="False">
          <BoxContainer Orientation="Vertical" SeparationOverride="7" Margin="0,2,4,0">
            <Label Text="{Loc cmu-recon-map}" FontColorOverride="#77CABD" />
            <OptionButton Name="MapSelection" Disabled="True" />
            <Label Text="{Loc cmu-recon-floor}" FontColorOverride="#77CABD" />
            <OptionButton Name="Floor" />
            <CheckBox Name="LowWalls" Text="{Loc cmu-recon-low-walls}" Pressed="True" />
            <CheckBox Name="Isolate" Text="{Loc cmu-recon-isolate}" />
            <CheckBox Name="Labels" Text="{Loc cmu-recon-labels}" Pressed="True" />
            <CheckBox Name="Contacts" Text="{Loc cmu-recon-contacts}" Pressed="True" />
            <Label Text="{Loc cmu-recon-draw}" FontColorOverride="#E7BC78" Margin="0,12,0,0" />
            <GridContainer Name="Colors" Columns="3" />
            <Label Text="{Loc cmu-recon-width}" />
            <OptionButton Name="StrokeWidth" />
            <LineEdit Name="MarkerText" PlaceHolder="{Loc cmu-recon-text-placeholder}" />
            <RichTextLabel Text="{Loc cmu-recon-draw-help}" />
            <Button Name="Undo" Text="{Loc cmu-recon-undo-drawing}" Disabled="True" />
            <Button Name="Clear" Text="{Loc cmu-recon-clear-drawings}" Disabled="True" />
          </BoxContainer>
        </ScrollContainer>
      </BoxContainer>
      <RichTextLabel Name="Status" Text="{Loc cmu-recon-loading}" />
    </BoxContainer>
  </PanelContainer>
</DefaultWindow>
