<controls:CMUTransmissionsTerminalWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client.CMU14.CorporateWork"
    Title="{Loc cmu-transmissions-title}" MinSize="720 520" SetSize="840 620">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="12" Margin="12">
        <!-- Brief, cases and status -->
        <BoxContainer Orientation="Vertical" SetWidth="300" MinWidth="300" VerticalExpand="True" SeparationOverride="8">
            <Label Text="{Loc cmu-transmissions-heading}" StyleClasses="LabelHeading" />
            <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
                <!-- Wrapped in a box so the brief sits at the top instead of floating in the middle -->
                <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                    <RichTextLabel Text="{Loc cmu-transmissions-instructions}" HorizontalExpand="True" />
                </BoxContainer>
            </ScrollContainer>
            <Label Text="{Loc cmu-transmissions-tiers-section}" />
            <BoxContainer Name="TierButtons" Access="Public" Orientation="Vertical" SeparationOverride="6" />
            <RichTextLabel Name="StatusLabel" Access="Public" HorizontalExpand="True" Margin="0 4 0 0" />
        </BoxContainer>

        <!-- The work itself -->
        <PanelContainer Name="WorkPanel" Access="Public" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="8">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                    <Label Text="{Loc cmu-transmissions-targets}" HorizontalExpand="True" />
                    <Label Name="TimerLabel" Access="Public" Text="" />
                </BoxContainer>
                <BoxContainer Name="SequenceRows" Access="Public" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2" />
                <Label Text="{Loc cmu-transmissions-buffer}" />
                <Label Name="BufferLabel" Access="Public" Text="" StyleClasses="LabelHeading" HorizontalAlignment="Center" />
                <Label Text="{Loc cmu-transmissions-signal}" />
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
                    <GridContainer Name="CodeGrid" Access="Public" HorizontalAlignment="Center" HSeparationOverride="4" VSeparationOverride="4" />
                </BoxContainer>
                <Button Name="UploadButton" Access="Public" Text="{Loc cmu-transmissions-upload}" HorizontalExpand="True" MinHeight="36" />
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:CMUTransmissionsTerminalWindow>
