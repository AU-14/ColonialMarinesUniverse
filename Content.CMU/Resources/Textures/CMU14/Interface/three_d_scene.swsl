// CMU local 3D scene workbench. Original work, CC0-1.0.
// Layout and budgets match CMU3DSceneEncoding. No tactical-survey data is consumed.
light_mode unshaded;
uniform sampler2D sceneBoxes;
uniform sampler2D sceneGrid;
uniform sampler2D sceneSurfaces;
uniform sampler2D sceneSurfaceInfo;
uniform highp vec2 surfaceAtlasSize;
uniform highp vec3 cameraOrigin;
uniform highp vec3 cameraForward;
uniform highp vec3 cameraRight;
uniform highp vec3 cameraUp;
uniform highp vec2 sceneZ;
uniform highp float aspect;
uniform highp float tanHalfFov;
uniform highp vec4 gridLayout;
uniform highp vec3 gridZ;
uniform highp float sceneRadius;
uniform highp vec3 sceneView;
uniform sampler2D liveLight;
uniform highp float useLiveLight;
uniform highp float brightness;
uniform sampler2D spriteAtlas;
uniform sampler2D billboardData;
uniform highp float billboardCount;
uniform highp vec2 billboardLayout;
uniform highp float selectedBox;

highp vec4 boxData(highp float boxId, highp float column) {
    highp float index = (boxId - 1.0) * 6.0 + column;
    highp vec2 uv = vec2((mod(index, 256.0) + 0.5) / 256.0, 1.0 - (floor(index / 256.0) + 0.5) / gridLayout.w);
    return floor(texture2D(sceneBoxes, uv) * 255.0 + 0.5);
}
highp vec4 gridData(highp float index) {
    highp vec2 uv = vec2((mod(index, 2048.0) + 0.5) / 2048.0, 1.0 - (floor(index / 2048.0) + 0.5) / gridLayout.z);
    return floor(texture2D(sceneGrid, uv) * 255.0 + 0.5);
}
highp vec2 unpackPair(highp vec4 data) {
    return vec2(data.r + data.g * 256.0, data.b + data.a * 256.0);
}
highp vec2 slab(highp vec3 origin, highp vec3 ray, highp vec3 low, highp vec3 high) {
    if ((abs(ray.x) < 0.000001 && (origin.x < low.x || origin.x > high.x)) ||
        (abs(ray.y) < 0.000001 && (origin.y < low.y || origin.y > high.y)) ||
        (abs(ray.z) < 0.000001 && (origin.z < low.z || origin.z > high.z))) return vec2(1000000.0, -1000000.0);
    highp vec3 inv = (step(vec3(0.0), ray) * 2.0 - 1.0) / max(abs(ray), vec3(0.000001));
    highp vec3 a = (low - origin) * inv;
    highp vec3 b = (high - origin) * inv;
    highp vec3 near = min(a, b);
    highp vec3 far = max(a, b);
    // Parallel rays inside a slab impose no distance constraint, including its boundary.
    highp vec3 parallel = vec3(1.0) - step(vec3(0.000001), abs(ray));
    near = mix(near, vec3(-1000000.0), parallel);
    far = mix(far, vec3(1000000.0), parallel);
    return vec2(max(max(near.x, near.y), near.z), min(min(far.x, far.y), far.z));
}
// Source pixels are unfiltered sRGB, uploaded with the same row convention as box data.
highp vec4 sampleSurface(highp vec4 metadata, highp vec3 local) {
    if (metadata.g >= 128.0) return vec4(1.0);
    highp float index = metadata.b + floor(metadata.g / 8.0) * 256.0;
    if (index < 0.5) return vec4(1.0);
    highp vec4 info = floor(texture2D(sceneSurfaceInfo, vec2((index - 0.5) / 4096.0, 0.5)) * 255.0 + 0.5);
    if (info.a < 0.5) return vec4(0.0);
    highp float axis = mod(metadata.g, 4.0);
    highp vec2 uv = vec2(local.x + 0.5, 1.0 - (local.z + 0.5) * metadata.a / 255.0);
    if (axis > 1.5 && axis < 2.5) uv = vec2(local.x + 0.5, 0.5 - local.y);
    if (axis > 2.5) uv.x = 0.5 - local.y;
    if (mod(metadata.g, 8.0) > 3.5) uv.x = 1.0 - uv.x;
    highp vec2 dimensions = info.rg + 1.0;
    highp vec2 pixel = clamp(floor(uv * dimensions), vec2(0.0), dimensions - 1.0);
    highp vec2 cell = vec2(mod(index - 1.0, 64.0), floor((index - 1.0) / 64.0)) * (surfaceAtlasSize.x / 64.0);
    highp vec2 atlasUV = (cell + pixel + 0.5) / surfaceAtlasSize;
    return texture2D(sceneSurfaces, vec2(atlasUV.x, 1.0 - atlasUV.y));
}
// The same 4x4 screen-door coverage as the browser and comparison renderer.
// Sampling retained fractional source alpha keeps shoreline shadows translucent.
highp float coverageThreshold(highp vec2 fragmentPixel) {
    highp vec2 pixel = mod(floor(fragmentPixel), 4.0);
    highp vec2 low = mod(pixel, 2.0);
    highp vec2 high = floor(pixel / 2.0);
    highp float lowIndex = mod(low.x + low.y, 2.0) * 2.0 + low.y;
    highp float highIndex = mod(high.x + high.y, 2.0) * 2.0 + high.y;
    return (4.0 * lowIndex + highIndex + 0.5) / 16.0;
}
