highp float intersectBox(highp float id, highp vec3 origin, highp vec3 ray, highp float threshold, highp vec2 segment,
    out highp vec3 normal, out highp vec3 albedo) {
    normal = vec3(0.0, 0.0, 1.0);
    albedo = vec3(0.0);
    highp vec2 a = unpackPair(boxData(id, 0.0));
    highp vec2 b = unpackPair(boxData(id, 1.0));
    highp vec2 c = unpackPair(boxData(id, 2.0));
    highp vec3 center = (vec3(a, b.x) - 32768.0) / 1024.0;
    highp vec3 halfSize = vec3(b.y, c) / 2048.0;
    highp vec4 metadata = boxData(id, 5.0);
    // Reject other floors before rotation/shape work. Tilted solids need their full local bounds.
    highp vec2 segmentZ = origin.z + ray.z * segment;
    if (metadata.g < 128.0 && (max(segmentZ.x, segmentZ.y) < center.z - halfSize.z - 0.002 ||
        min(segmentZ.x, segmentZ.y) > center.z + halfSize.z + 0.002)) return 1000000.0;
    highp vec2 rotation = normalize((unpackPair(boxData(id, 3.0)) - 32768.0) / 32767.0);
    highp vec3 relative = origin - center;
    highp vec3 localOrigin = vec3(rotation.x * relative.x + rotation.y * relative.y,
        -rotation.y * relative.x + rotation.x * relative.y, relative.z);
    highp vec3 localRay = vec3(rotation.x * ray.x + rotation.y * ray.y,
        -rotation.y * ray.x + rotation.x * ray.y, ray.z);
    highp float pitch = metadata.g >= 128.0 ? ((metadata.g - 128.0) * 256.0 + metadata.a - 16384.0) * (3.141592653589793 / 32768.0) : 0.0;
    highp vec2 tilt = vec2(cos(pitch), sin(pitch));
    localOrigin = vec3(tilt.x * localOrigin.x + tilt.y * localOrigin.z, localOrigin.y, -tilt.y * localOrigin.x + tilt.x * localOrigin.z);
    localRay = vec3(tilt.x * localRay.x + tilt.y * localRay.z, localRay.y, -tilt.y * localRay.x + tilt.x * localRay.z);
    highp vec2 bounds = slab(localOrigin, localRay, -halfSize, halfSize);
    if (bounds.y < max(max(bounds.x, 0.0001), segment.x - 0.001) || bounds.x > segment.y + 0.001) return 1000000.0;
    highp float distance = bounds.x >= 0.0001 ? bounds.x : bounds.y;
    highp float shape = metadata.r;
    highp vec3 cylinderAxis = shape < 2.5 ? vec3(1.0, 0.0, 0.0) : shape < 3.5 ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0);
    highp float leafShear = mod(shape - 7.0, 2.0) > 0.5 ? -0.85 : 0.85;
    highp float leafScale = sqrt(1.0 - 0.85 * 0.85);
    highp vec3 foliageNormal = vec3(0.0, 0.0, 1.0);
    if (shape > 10.5 && shape < 11.5) {
        distance = 1000000.0;
        highp vec3 unitOrigin = localOrigin / (halfSize * 2.0);
        highp vec3 unitRay = localRay / (halfSize * 2.0);
        for (int leaf = 0; leaf < 19; leaf++) {
            highp vec3 leafCenter;
            highp vec3 ax;
            highp vec3 ay;
            highp vec3 az;
            foliageTransform(float(leaf), leafCenter, ax, ay, az);
            highp vec3 relativeLeaf = unitOrigin - leafCenter;
            highp vec3 o = vec3(dot(relativeLeaf, ax), dot(relativeLeaf, ay), dot(relativeLeaf, az));
            highp vec3 d = vec3(dot(unitRay, ax), dot(unitRay, ay), dot(unitRay, az));
            highp float qa = dot(d, d);
            highp float qb = dot(o, d);
            highp float discriminant = qb * qb - qa * (dot(o, o) - 1.0);
            if (qa <= 0.0 || discriminant < 0.0) continue;
            highp float root = sqrt(discriminant);
            highp float near = (-qb - root) / qa;
            highp float hit = near >= 0.0001 ? near : (-qb + root) / qa;
            if (hit < 0.0001 || hit >= distance) continue;
            distance = hit;
            highp vec3 pointLeaf = o + d * hit;
            foliageNormal = normalize((ax * pointLeaf.x + ay * pointLeaf.y + az * pointLeaf.z) / halfSize);
        }
        if (distance >= 1000000.0) return distance;
    }
    if ((shape > 0.5 && shape < 1.5) || (shape > 6.5 && shape < 10.5)) {
        highp vec3 o = localOrigin / halfSize;
        highp vec3 d = localRay / halfSize;
        if (shape > 6.5 && shape < 8.5) {
            o.x = (o.x - leafShear * o.z) / leafScale;
            d.x = (d.x - leafShear * d.z) / leafScale;
        } else if (shape > 8.5) {
            o.y = (o.y - leafShear * o.z) / leafScale;
            d.y = (d.y - leafShear * d.z) / leafScale;
        }
        highp float qa = dot(d, d);
        highp float qb = dot(o, d);
        highp float discriminant = qb * qb - qa * (dot(o, o) - 1.0);
        if (discriminant < 0.0) return 1000000.0;
        highp float root = sqrt(discriminant);
        highp float near = (-qb - root) / qa;
        distance = near >= 0.0001 ? near : (-qb + root) / qa;
        if (distance < 0.0001) return 1000000.0;
    }
    if (shape > 1.5 && shape < 4.5) {
        highp vec3 o = localOrigin / halfSize * (vec3(1.0) - cylinderAxis);
        highp vec3 d = localRay / halfSize * (vec3(1.0) - cylinderAxis);
        highp float qa = dot(d, d);
        highp float qb = dot(o, d);
        highp float qc = dot(o, o) - 1.0;
        if (qa < 0.000000000001) {
            if (qc > 0.0) return 1000000.0;
        } else {
            highp float discriminant = qb * qb - qa * qc;
            if (discriminant < 0.0) return 1000000.0;
            highp float root = sqrt(discriminant);
            bounds = vec2(max(bounds.x, (-qb - root) / qa), min(bounds.y, (-qb + root) / qa));
        }
        if (bounds.y < max(bounds.x, 0.0001)) return 1000000.0;
        distance = bounds.x >= 0.0001 ? bounds.x : bounds.y;
    }
    if (shape > 4.5 && shape < 6.5) {
        highp float slope = shape > 5.5 ? 1.0 : -1.0;
        highp float planeOrigin = localOrigin.z / halfSize.z + slope * localOrigin.y / halfSize.y;
        highp float planeRay = localRay.z / halfSize.z + slope * localRay.y / halfSize.y;
        if (abs(planeRay) < 0.000001) {
            if (planeOrigin > 0.0) return 1000000.0;
        } else if (planeRay < 0.0) bounds.x = max(bounds.x, -planeOrigin / planeRay);
        else bounds.y = min(bounds.y, -planeOrigin / planeRay);
        if (bounds.y < max(bounds.x, 0.0001)) return 1000000.0;
        distance = bounds.x >= 0.0001 ? bounds.x : bounds.y;
    }
    highp vec3 point = localOrigin + localRay * distance;
    highp vec4 paint = boxData(id, 4.0) / 255.0;
    highp vec4 surfaceColor = sampleSurface(metadata, point / (halfSize * 2.0));
    if (surfaceColor.a < 0.5 || paint.a * surfaceColor.a < threshold) {
        distance = bounds.y;
        point = localOrigin + localRay * distance;
        surfaceColor = sampleSurface(metadata, point / (halfSize * 2.0));
        if (surfaceColor.a < 0.5 || paint.a * surfaceColor.a < threshold) return 1000000.0;
    }
    highp vec3 edge = abs(abs(point) - halfSize);
    highp vec3 localNormal = vec3(0.0, 0.0, sign(point.z));
    if (edge.x <= edge.y && edge.x <= edge.z) localNormal = vec3(sign(point.x), 0.0, 0.0);
    else if (edge.y <= edge.z) localNormal = vec3(0.0, sign(point.y), 0.0);
    if (shape > 0.5 && shape < 1.5) localNormal = normalize(point / (halfSize * halfSize));
    if (shape > 6.5 && shape < 10.5) {
        highp vec3 unit = point / halfSize;
        highp vec3 gradient = unit;
        if (shape < 8.5) {
            gradient.x = (unit.x - leafShear * unit.z) / (leafScale * leafScale);
            gradient.z = unit.z - leafShear * gradient.x;
        } else {
            gradient.y = (unit.y - leafShear * unit.z) / (leafScale * leafScale);
            gradient.z = unit.z - leafShear * gradient.y;
        }
        localNormal = normalize(gradient / halfSize);
    }
    if (shape > 10.5 && shape < 11.5) localNormal = foliageNormal;
    if (shape > 1.5 && shape < 4.5) {
        if (abs(abs(dot(point, cylinderAxis)) - dot(halfSize, cylinderAxis)) < 0.00001)
            localNormal = cylinderAxis * sign(dot(point, cylinderAxis));
        else localNormal = normalize(point / (halfSize * halfSize) * (vec3(1.0) - cylinderAxis));
    }
    highp float wedgeSlope = shape > 5.5 ? 1.0 : -1.0;
    if (shape > 4.5 && shape < 6.5 && abs(point.z / halfSize.z + wedgeSlope * point.y / halfSize.y) < 0.0001)
        localNormal = normalize(vec3(0.0, wedgeSlope / halfSize.y, 1.0 / halfSize.z));
    localNormal = vec3(tilt.x * localNormal.x - tilt.y * localNormal.z, localNormal.y, tilt.y * localNormal.x + tilt.x * localNormal.z);
    normal = vec3(rotation.x * localNormal.x - rotation.y * localNormal.y,
        rotation.y * localNormal.x + rotation.x * localNormal.y, localNormal.z);
    albedo = paint.rgb * surfaceColor.rgb;
    return distance;
}

highp float traceScene(highp vec3 origin, highp vec3 ray, highp float threshold, out highp vec3 normal,
    out highp vec3 albedo, out highp float picked) {
    normal = vec3(0.0, 0.0, 1.0);
    albedo = vec3(0.0);
    picked = 0.0;
    highp vec2 volume = slab(origin, ray, vec3(sceneView.xy - vec2(sceneView.z), sceneZ.x - 0.002), vec3(sceneView.xy + vec2(sceneView.z), sceneZ.y + 0.002));
    highp float distance = max(0.0, volume.x);
    if (volume.y < max(distance, 0.0001)) return -1.0;
    highp vec3 inv = (step(vec3(0.0), ray) * 2.0 - 1.0) / max(abs(ray), vec3(0.000001));
    // Up to 208 XYZ crossings in the extended 64x64x80 grid.
    for (int stepIndex = 0; stepIndex < 224; stepIndex++) {
        if (distance > volume.y) break;
        highp vec3 point = origin + ray * (distance + 0.0001);
        highp vec3 cell = floor(vec3(point.xy - gridLayout.y, (point.z - gridZ.x) / gridZ.y));
        if (cell.x < 0.0 || cell.y < 0.0 || cell.z < 0.0 || cell.x >= gridLayout.x || cell.y >= gridLayout.x || cell.z >= gridZ.z) break;
        highp vec3 boundary = vec3(cell.xy + gridLayout.y, cell.z * gridZ.y + gridZ.x) + step(vec3(0.0), ray) * vec3(1.0, 1.0, gridZ.y);
        highp vec3 next = max((boundary - origin) * inv, vec3(distance));
        if (abs(ray.x) < 0.000001) next.x = 1000000.0;
        if (abs(ray.y) < 0.000001) next.y = 1000000.0;
        if (abs(ray.z) < 0.000001) next.z = 1000000.0;
        highp float cellEnd = min(volume.y, min(next.x, min(next.y, next.z)));
        highp float descriptor = ((cell.z * gridLayout.x + cell.y) * gridLayout.x + cell.x) * 2.0;
        highp vec4 startBytes = gridData(descriptor);
        highp float start = startBytes.r + startBytes.g * 256.0 + startBytes.b * 65536.0;
        highp vec4 countBytes = gridData(descriptor + 1.0);
        highp float count = countBytes.r + countBytes.g * 256.0 + countBytes.b * 65536.0;
        highp float references = gridLayout.x * gridLayout.x * gridZ.z * 2.0;
        highp float best = 1000000.0;
        highp float bestId = 0.0;
        highp vec3 bestNormal = normal;
        highp vec3 bestAlbedo = albedo;
        // Keep the bounded loop in sync with CMU3DSceneEncoding.MaxCellBoxes.
        for (int candidate = 0; candidate < 130560; candidate++) {
            if (float(candidate) >= count) break;
            highp float reference = start + float(candidate);
            highp vec4 entry = gridData(references + reference);
            highp vec2 segmentZ = origin.z + ray.z * vec2(distance, min(cellEnd, best));
            if (max(segmentZ.x, segmentZ.y) < mod(entry.b, 128.0) * 2.0 - 128.0 || min(segmentZ.x, segmentZ.y) > entry.a * 2.0 - 128.0) continue;
            highp float id = entry.r + entry.g * 256.0 + floor(entry.b / 128.0) * 65536.0;
            highp vec3 candidateNormal;
            highp vec3 candidateAlbedo;
            highp float hit = intersectBox(id, origin, ray, threshold, vec2(distance, min(cellEnd, best)), candidateNormal, candidateAlbedo);
            if (hit < distance - 0.001 || hit > cellEnd + 0.001 || hit > best) continue;
            best = hit;
            bestId = id;
            bestNormal = candidateNormal;
            bestAlbedo = candidateAlbedo;
        }
        if (bestId > 0.0) {
            normal = bestNormal;
            albedo = bestAlbedo;
            picked = bestId;
            return best;
        }
        distance = cellEnd + 0.0001;
    }
    return -1.0;
}
highp vec3 linearColor(highp vec3 color) {
    return mix(color / 12.92, pow((color + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), color));
}
highp vec2 billboardPair(highp float index) {
    highp vec4 data = floor(texture2D(billboardData, vec2((index + 0.5) / billboardLayout.y, 0.5)) * 255.0 + 0.5);
    return (unpackPair(data) - 32768.0) / 1024.0;
}
highp float traceBillboards(highp vec3 ray, highp float nearest, highp float threshold, out highp vec3 spriteColor, out highp vec3 spriteNormal, out highp float emissive) {
    spriteColor = vec3(0.0);
    spriteNormal = vec3(0.0);
    emissive = 0.0;
    highp float best = nearest < 0.0 ? 1000000.0 : nearest;
    highp float result = -1.0;
    // Keep the loop bound in sync with CMU3DSceneControl.BillboardLimit.
    for (int i = 0; i < 256; i++) {
        if (float(i) >= billboardCount) break;
        highp vec2 xy = billboardPair(float(i) * 4.0);
        highp vec2 zw = billboardPair(float(i) * 4.0 + 1.0);
        highp vec2 heightYaw = billboardPair(float(i) * 4.0 + 2.0);
        highp vec2 tiltLight = billboardPair(float(i) * 4.0 + 3.0);
        if (zw.y <= 0.0 || heightYaw.x <= 0.0) continue;
        highp vec3 right = vec3(cos(heightYaw.y), sin(heightYaw.y), 0.0);
        highp vec3 up = vec3(right.y * sin(tiltLight.x), -right.x * sin(tiltLight.x), cos(tiltLight.x));
        highp vec3 normal = cross(up, right);
        highp float denominator = dot(ray, normal);
        if (abs(denominator) < 0.00001) continue;
        highp vec3 center = vec3(xy, zw.x);
        highp float t = dot(center - cameraOrigin, normal) / denominator;
        if (t < 0.01 || t >= best) continue;
        highp vec3 world = cameraOrigin + ray * t;
        if (abs(world.x - sceneView.x) > sceneView.z || abs(world.y - sceneView.y) > sceneView.z) continue;
        highp vec3 local = world - center;
        highp vec2 uv = vec2(dot(local, right) / zw.y, dot(local, up) / heightYaw.x) + 0.5;
        if (uv.x < 0.0 || uv.y < 0.0 || uv.x > 1.0 || uv.y > 1.0) continue;
        highp vec2 atlasUv = (vec2(mod(float(i), billboardLayout.x), floor(float(i) / billboardLayout.x)) + vec2(uv.x, 1.0 - uv.y)) / billboardLayout.x;
        atlasUv.y = 1.0 - atlasUv.y;
        highp vec4 paint = texture2D(spriteAtlas, atlasUv);
        if (paint.a <= threshold) continue;
        spriteColor = paint.rgb;
        spriteNormal = denominator < 0.0 ? normal : -normal;
        emissive = tiltLight.y;
        best = t;
        result = t;
    }
    return result;
}
void fragment() {
    highp vec2 screen = (UV2 * 2.0 - 1.0) * vec2(aspect, 1.0);
    highp vec3 ray = normalize(cameraForward + (cameraRight * screen.x + cameraUp * screen.y) * tanHalfFov);
    highp vec3 normal;
    highp vec3 albedo;
    highp float picked;
    highp float distance = traceScene(cameraOrigin, ray, coverageThreshold(gl_FragCoord.xy), normal, albedo, picked);
    highp vec3 spriteColor;
    highp vec3 spriteNormal;
    highp float spriteEmissive;
    highp float spriteDistance = traceBillboards(ray, distance, coverageThreshold(gl_FragCoord.xy), spriteColor, spriteNormal, spriteEmissive);
    if (spriteDistance >= 0.0) {
        distance = spriteDistance;
        albedo = spriteColor;
        normal = spriteNormal;
        picked = 0.0;
    }
    highp vec3 color = mix(vec3(0.006, 0.012, 0.018), vec3(0.016, 0.026, 0.032), UV2.y);
    if (distance >= 0.0) {
        highp float diffuse = max(0.0, dot(normal, normalize(vec3(-0.4, -0.6, 1.0))));
        highp vec3 light = vec3(1.0);
        if (useLiveLight > 0.5) {
            highp vec2 lightUv = (cameraOrigin.xy + ray.xy * distance + normal.xy * 0.04) / (sceneRadius * 2.0) + 0.5;
            light = texture2D(liveLight, clamp(lightUv, vec2(0.001), vec2(0.999))).rgb * brightness;
        }
        color = (spriteDistance >= 0.0 ? albedo : linearColor(albedo)) * (0.72 + diffuse * 0.28) * light;
        if (spriteDistance >= 0.0 && spriteEmissive > 0.5) color = albedo;
        if (selectedBox > 0.0 && abs(selectedBox - picked) < 0.5) color = mix(color, vec3(0.95, 0.42, 0.08), 0.42);
        color = mix(color, vec3(0.016, 0.026, 0.032), smoothstep(24.0, 65.0, distance) * 0.25);
    }
    COLOR = vec4(color, 1.0);
}
