light_mode unshaded;
blend_mode multiply;
uniform highp vec4 glow;
uniform highp float intensity;

void fragment() {
    highp float falloff = max(0.0, 1.0 - length(UV2 * 2.0 - 1.0)) * intensity;
    // First half of screen blending: destination * (1 - source).
    COLOR = vec4(vec3(1.0) - glow.rgb * falloff, 1.0);
}
