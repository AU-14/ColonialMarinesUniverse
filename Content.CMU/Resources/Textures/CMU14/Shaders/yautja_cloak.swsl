light_mode unshaded;
uniform sampler2D SCREEN_TEXTURE;
uniform highp float visibility;
uniform highp float transition;
uniform highp float rain;
uniform highp float phase;
uniform highp vec2 body_origin;
uniform highp vec2 body_x;
uniform highp vec2 body_y;
uniform highp float native_pixel;
uniform highp float moving;
uniform highp float retro;

void fragment() {
    highp vec4 body = zTexture(UV);
    if (body.a < 0.01) discard;
    highp vec2 delta = SCREEN_UV - body_origin;
    highp vec2 pixel = floor(vec2(dot(delta, body_x), dot(delta, body_y)) + vec2(16.0));
    highp vec2 ps = TEXTURE_PIXEL_SIZE * native_pixel;
    // Distance inside the actual composed silhouette, measured in native sprite pixels.
    highp float depth = 8.0;
    for (int distance = 1; distance <= 8; distance++) {
        highp float d = float(distance);
        highp float a = min(min(zTexture(UV + vec2(ps.x * d, 0.0)).a,
            zTexture(UV - vec2(ps.x * d, 0.0)).a),
            min(zTexture(UV + vec2(0.0, ps.y * d)).a, zTexture(UV - vec2(0.0, ps.y * d)).a));
        if (a < 0.4) depth = min(depth, d);
    }
    highp float changing = step(0.001, transition) * step(transition, 0.999);
    highp float animated = max(moving, changing) * (1.0 - rain);
    // A one-pixel rim softens the lens without erasing refraction from narrow limbs.
    // Keep the rain lens shallow and avoid alternating vertical offsets across floor seams.
    highp float lens = smoothstep(0.0, 2.0, depth);
    highp float rainLens = smoothstep(0.0, 5.0, depth - 1.0);
    highp float shift = mix(lens * (1.0 + depth * 0.5 + animated * 0.65), rainLens * 0.8, rain);
    highp float wobble = sin(pixel.y * 0.25 + phase * 3.0) * animated * 0.3 * lens;
    // The classic field shimmers while moving; the modern field bends more slowly.
    highp float ripple = sin(pixel.y * 0.7 + phase * 12.0) * animated * 0.8 * lens;
    wobble = mix(wobble, ripple, retro);
    // Full lens distortion belongs to the power-up sweep. A settled cloak must not carve a
    // permanent body-shaped offset into straight metal seams, especially while standing still.
    highp float settled = max(changing, moving * 0.15);
    shift *= settled;
    wobble *= settled;
    highp vec2 refracted = SCREEN_UV + vec2(shift + wobble, 0.0) * SCREEN_PIXEL_SIZE * native_pixel;
    highp vec4 background = zTextureSpec(SCREEN_TEXTURE,
        clamp(refracted, SCREEN_PIXEL_SIZE * 0.5, vec2(1.0) - SCREEN_PIXEL_SIZE * 0.5));
    highp float index = pixel.y * 32.0 + pixel.x + floor(phase * 5.0);
    highp float noise = fract(sin(index * 127.1 + 41.7) * 43758.5453);
    highp float edge = 1.0 - step(1.5, depth);
    highp float interference = step(0.975, noise) * edge * rain * 0.2 * step(pixel.y, 23.0);
    highp float modernFront = transition * 34.0 - 1.0;
    highp float retroFront = floor(transition * 34.0) - 1.0;
    // Anchor the frayed edge to the body so the sweep does not randomly reveal covered pixels.
    highp float edgeNoise = fract(sin((pixel.y * 32.0 + pixel.x) * 127.1 + 41.7) * 43758.5453);
    highp float breakup = (edgeNoise - 0.5) * 2.0;
    highp float modernCovered = 1.0 - smoothstep(modernFront - 1.0, modernFront + 1.0, pixel.y);
    highp float retroCovered = step(pixel.y + breakup, retroFront);
    highp float modernSeam = (1.0 - smoothstep(0.0, 3.0, abs(pixel.y - modernFront))) * edge;
    highp float retroSeam = (1.0 - step(2.5, abs(pixel.y + breakup - retroFront))) *
        max(edge * 0.8, step(0.83, edgeNoise) * 0.65);
    highp float seam = mix(modernSeam, retroSeam, retro) * changing;
    highp float front = mix(modernFront, retroFront, retro);
    highp float strand = floor((pixel.x - 8.0) / 3.0);
    highp float strandTop = front + sin(strand + phase * 21.0) * 2.0;
    highp float sparks = step(8.0, pixel.x) * step(pixel.x, 21.0) *
        (1.0 - step(1.0, mod(pixel.x - 8.0 + (pixel.y - strandTop) * 0.25, 3.0))) *
        step(strandTop, pixel.y) * step(pixel.y, front + 4.0) * changing * (1.0 - rain);
    highp float pulse = sin(phase * 6.0);
    pulse *= pulse;
    highp float opacity = clamp(visibility * max(changing, moving * 0.2) + rain * 0.025 * pulse * pulse, 0.0, 1.0);
    highp float covered = mix(modernCovered, retroCovered, retro) * step(0.001, transition);
    // Match the reference's display-space fade; linear blending makes the faint body too bright.
    highp vec3 bodyColor = zToSrgb(body).rgb;
    highp vec3 fieldColor = mix(zToSrgb(background).rgb, bodyColor, opacity);
    highp vec3 color = mix(bodyColor, fieldColor, covered);
    // Match the webview's Prey red (#FA503A) and classic blue-white (#9ACFFF).
    highp vec3 glint = mix(vec3(250.0, 80.0, 58.0), vec3(154.0, 207.0, 255.0), retro) / 255.0;
    color = mix(color, glint, max(max(interference, seam * 0.9), sparks * 0.65));
    COLOR = vec4(zFromSrgb(vec4(color, 1.0)).rgb, body.a);
}
