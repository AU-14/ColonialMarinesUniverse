light_mode unshaded;
uniform highp vec4 tint;
uniform highp vec4 core;
uniform highp float phase;
uniform highp float material;
uniform highp float length_px;
uniform highp float seed;

highp float hash(highp float n) {
    return fract(sin(n * 127.1 + 311.7) * 43758.5453);
}

void fragment() {
    highp vec2 q = UV2;
    highp float x = q.x * length_px;
    highp float y = (q.y - 0.5) * 6.0;
    highp float flow = x * 0.45 - phase * 13.0 + seed;
    highp float braid = sin(flow) * 0.5 + sin(flow * 0.43 + phase * 4.0) * 0.28;
    highp float filament = exp(-pow((y - braid) * 1.6, 2.0));
    highp float sheath = exp(-y * y * 0.7) * (0.55 + sin(flow * 0.4) * 0.2);
    highp float packet = pow(max(0.0, sin(flow * 0.7)), 12.0);
    highp float brightness = sheath * 0.3 + filament * (0.6 + packet * 0.4);
    if (material > 0.5 && material < 1.5) {
        highp float cell = floor(x / 4.0);
        highp float frame = floor(phase * 18.0);
        highp float jitter = (hash(cell + frame * 19.0 + seed) - 0.5) * 2.0;
        filament = exp(-pow((y - jitter) * 2.2, 2.0));
        brightness = filament * (0.5 + hash(frame + seed) * 0.5) + sheath * 0.18;
    } else if (material > 1.5 && material < 2.5) {
        highp float bits = step(0.25, hash(floor((x - phase * 9.0) / 3.0) + seed));
        filament = exp(-y * y * 6.0);
        brightness = filament * bits * 0.85 + sheath * 0.08;
    } else if (material > 2.5 && material < 4.5) {
        filament = exp(-pow((y - braid * 1.6), 2.0));
        brightness = filament * (0.35 + packet * 0.35) + sheath * 0.15;
        if (material > 3.5) brightness *= 0.6 + hash(floor(x * 0.7) + seed) * 0.4;
    } else if (material > 4.5 && material < 5.5) {
        filament = exp(-pow((abs(y) - 0.8 - sin(flow) * 0.3) * 3.0, 2.0));
        brightness = filament * 0.45 + sheath * packet * 0.2;
    } else if (material > 5.5 && material < 6.5) {
        filament = exp(-pow((y - sin(flow * 0.3) * 0.9) * 2.0, 2.0));
        brightness = filament * (0.3 + packet * 0.7) + sheath * 0.1;
    } else if (material > 6.5) {
        filament = exp(-y * y * 3.0);
        brightness = filament * (0.35 + pow(max(0.0, sin(flow * 0.2)), 3.0) * 0.65);
    }
    highp float ends = smoothstep(0.0, min(0.2, 1.0 / max(length_px, 1.0)), q.x) *
        (1.0 - smoothstep(max(0.8, 1.0 - 1.0 / max(length_px, 1.0)), 1.0, q.x));
    highp float hot = clamp(filament * packet, 0.0, 0.85);
    COLOR = vec4(mix(tint.rgb, core.rgb, hot), clamp(brightness * tint.a * ends, 0.0, 0.95));
}
