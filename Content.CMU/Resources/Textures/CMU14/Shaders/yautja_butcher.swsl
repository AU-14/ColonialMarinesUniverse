light_mode unshaded;
// Work in body-local pixels, reconstructed per viewport. Only occupied victim pixels are altered.
uniform highp vec2 body_origin;
uniform highp vec2 body_x;
uniform highp vec2 body_y;
uniform highp float incision;
uniform highp float strip;
uniform highp float torso;
uniform highp float cut;
uniform highp vec4 part;
uniform highp vec4 blood;
uniform highp float xeno;
uniform highp float extracted;

void fragment() {
    highp vec4 victim = zTexture(UV);
    if (victim.a < 0.01) discard;
    highp vec2 delta = SCREEN_UV - body_origin;
    highp vec2 p = vec2(dot(delta, body_x), dot(delta, body_y)) + vec2(16.0);
    if (xeno > 0.5) {
        // A cracked diagonal carapace seam opens into plates and the ribbed thorax.
        // Coordinates follow the caste's base sprite, not a human-sized replacement body.
        highp float seam = 21.0 - (p.y - 10.0) * 0.45;
        highp float jagged = mod(p.y, 4.0) < 2.0 ? -0.7 : 0.7;
        highp float distance = abs(p.x - seam - jagged);
        highp float width = 0.6 + strip * 2.5 + torso * 2.5;
        highp float opened = step(distance, width) * step(10.0, p.y) *
            step(p.y, 10.0 + incision * 16.0) * step(0.001, incision);
        if (opened > 0.5) {
            highp float rib = 1.0 - step(1.0, mod(p.y + floor(p.x * 0.35), 4.0));
            highp float lip = smoothstep(width - 1.0, width, distance);
            highp vec3 cavity = mix(victim.rgb * 0.12, zFromSrgb(vec4(0.035, 0.055, 0.025, 1.0)).rgb, 0.7);
            cavity = mix(cavity, blood.rgb * 0.12, rib * torso);
            victim.rgb = mix(cavity, blood.rgb * 0.36, lip);
        }
        if (extracted > 0.5 && p.x >= 17.0 && p.x < 27.0 && p.y >= 6.0 && p.y < 16.0) discard;
    } else {
        p = floor(p);
        highp float depth = 0.0;
        if (abs(p.x - 16.0) <= 1.0 && p.y >= 11.0 && p.y < 11.0 + incision * 12.0) depth = 1.0;
        if (p.x >= 8.0 && p.x < 8.0 + strip * 4.0 && p.y >= 12.0 && p.y <= 21.0) depth = 2.0;
        if (p.x >= 16.0 - torso * 4.0 && p.x <= 16.0 + torso * 3.0 && p.y >= 12.0 && p.y <= 22.0 && torso > 0.0) depth = 3.0;
        if (cut > 0.0 && p.x >= part.x && p.x < part.x + part.z * cut && abs(p.y - part.y) <= 1.0 + cut) depth = 2.0;
        if (depth > 0.0) {
            highp float edge = 1.0 - step(0.5, mod(p.x + p.y, 4.0));
            highp vec3 tissue = mix(vec3(72.0, 9.0, 20.0), vec3(142.0, 30.0, 39.0), edge) / 255.0;
            if (depth < 1.5) tissue.r = 100.0 / 255.0;
            // Palette bytes are sRGB; the composed sprite and framebuffer are linear.
            victim.rgb = mix(zFromSrgb(vec4(tissue, 1.0)).rgb, blood.rgb * mix(0.28, 0.82, edge), xeno);
            if (depth > 2.5 && mod(p.y, 3.0) < 1.0 && p.x != 16.0)
                victim.rgb = zFromSrgb(vec4(173.0, 132.0, 112.0, 255.0) / 255.0).rgb;
        }
        if (extracted > 0.5 && p.x >= 8.0 && p.x < 24.0 && p.y < 10.0) discard;
    }
    // SWSL inlines fragment() into main: returning early skips the engine's framebuffer write.
    COLOR = victim;
}
