// Draw the airframe over crew, leaving the two cockpit openings transparent.
// Shader prototypes supply the same source-pixel apertures as cmuFighterAirframe.
uniform highp vec2 sprite_size = vec2(266.0, 335.0);
uniform highp vec2 pilot_center = vec2(133.0, 228.5);
uniform highp vec2 pilot_half_size = vec2(8.5, 12.5);
uniform highp vec2 observer_center = vec2(133.0, 193.5);
uniform highp vec2 observer_half_size = vec2(9.5, 16.5);
uniform highp vec2 frame_min = vec2(112.0, 162.0);
uniform highp vec2 frame_max = vec2(153.0, 270.0);

void fragment() {
    highp vec2 pixel = vec2(UV2.x, 1.0 - UV2.y) * sprite_size;
    highp vec2 pilot = abs((pixel - pilot_center) / pilot_half_size);
    highp vec2 wso = abs((pixel - observer_center) / observer_half_size);
    highp float front = step(max(pilot.x, pilot.y), 1.0) * step(pilot.x + pilot.y, 1.85);
    highp float rear = step(max(wso.x, wso.y), 1.0) * step(wso.x + wso.y, 1.85);
    // Only the cockpit rim needs a foreground pass; keep pylons and the rest
    // of the aircraft in their ordinary world draw order.
    highp float cockpit = step(frame_min.x, pixel.x) * step(pixel.x, frame_max.x) *
        step(frame_min.y, pixel.y) * step(pixel.y, frame_max.y);
    COLOR = zTexture(UV) * cockpit * (1.0 - max(front, rear));
}
