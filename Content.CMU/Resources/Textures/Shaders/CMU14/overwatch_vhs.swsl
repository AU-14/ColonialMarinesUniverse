light_mode unshaded;

// Overwatch camera feeds, shown as slightly grainy film. Samples the feed from a render target. No scanlines or
// other line-based artifacts: just a soft picture, a little colour bleed, film grain and a vignette.

uniform highp float aspect;
// 1 when the feed's night vision is on: the picture is drawn without lighting and shown in green phosphor.
uniform highp float nightVision;

// A hash without sin(), so the grain is plain noise: sin-based hashes lose precision on large inputs and show up as
// faint stripes crawling over the picture.
highp float grainHash(highp vec2 p) {
    highp vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

void fragment() {
    highp vec2 uv = UV;

    // Chroma bleed: red drifts right of the picture and blue left of it.
    highp float bleed = 0.0005;
    highp float r = zTexture(clamp(uv + vec2(bleed, 0.0), 0.0, 1.0)).r;
    highp float g = zTexture(uv).g;
    highp float b = zTexture(clamp(uv - vec2(bleed, 0.0), 0.0, 1.0)).b;
    highp vec3 rgb = vec3(r, g, b);

    // Slightly soft lens: blend each sample with its neighbours.
    highp vec3 soft = (zTexture(clamp(uv + vec2(0.0015, 0.0), 0.0, 1.0)).rgb +
                       zTexture(clamp(uv - vec2(0.0015, 0.0), 0.0, 1.0)).rgb) * 0.5;
    rgb = mix(rgb, soft, 0.05);

    // Faintly washed-out, warm colour. Kept light so you can still see what's on camera.
    highp float luma = dot(rgb, vec3(0.299, 0.587, 0.114));
    rgb = mix(vec3(luma), rgb, 0.97);
    rgb = rgb * vec3(1.03, 1.01, 0.97);

    // Night vision: everything is lit, so tint it green and lift the shadows a little.
    highp vec3 green = vec3(0.25, 1.0, 0.35) * (luma * 1.15 + 0.04);
    rgb = mix(rgb, green, nightVision);

    // Film grain: fine monochrome noise that changes at film's 24 frames a second. Like real grain it shows most in
    // the mid-tones and fades out in deep shadow and bright highlights.
    highp float frame = mod(floor(TIME * 24.0), 997.0);
    highp vec2 grainCell = floor(FRAGCOORD.xy) + vec2(frame * 37.0, frame * 17.0);
    highp float grain = grainHash(grainCell) - 0.5;
    highp float midtones = 4.0 * luma * (1.0 - luma);
    rgb = rgb + grain * (0.012 + 0.03 * midtones);

    // The odd fleck of dust on the film.
    highp float speck = step(0.9985, grainHash(grainCell + vec2(511.0, 263.0)));
    rgb = rgb + speck * 0.05;

    // Vignette, in real pixel proportions so a wide tile darkens evenly.
    highp vec2 centred = uv * 2.0 - 1.0;
    highp vec2 asp = vec2(aspect, 1.0);
    highp vec2 inPixels = centred * asp;
    highp float r2 = dot(inPixels, inPixels) / dot(asp, asp);
    highp float vig = 1.0 - clamp(0.06 * r2 * r2, 0.0, 1.0);

    COLOR = vec4(clamp(rgb, 0.0, 1.0) * vig, 1.0);
}
