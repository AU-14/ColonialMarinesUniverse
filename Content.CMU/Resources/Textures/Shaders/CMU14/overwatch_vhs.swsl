light_mode unshaded;

// Overwatch camera feeds played back as worn VHS tape. Samples the feed from a render target, so
// unlike an overlay it can move pixels: per-line wobble, the tracking band and the head-switch
// strip at the bottom all shift the picture sideways, and the colour channels bleed apart.

uniform highp float aspect;
// 1 when the feed's night vision is on: the picture is drawn without lighting and shown in green phosphor.
uniform highp float nightVision;

const highp float TAU = 6.28318530718;

void fragment() {
    highp vec2 uv = UV;
    highp float line = floor(FRAGCOORD.y / 2.0);

    // Tape wobble: every pair of lines sits slightly off, re-rolled 24 times a second.
    highp float wobble = (zRandom(vec2(line * 0.013, floor(TIME * 24.0) * 0.071)).x - 0.5) * 0.0004;

    // Tracking band crawling up the picture, torn sideways and full of snow while it passes.
    highp float bandY = 1.0 - fract(TIME * 0.07);
    highp float bandDist = abs(uv.y - bandY);
    highp float band = exp(-bandDist * bandDist * 2500.0);
    highp float bandShift = band * (zRandom(vec2(line * 0.37, TIME)).x - 0.5) * 0.004;

    // Head-switching noise: the bottom few lines of a VHS frame always sit skewed.
    highp float bottom = step(0.965, uv.y);
    highp float headShift = bottom * (0.0015 + 0.001 * sin(TIME * 40.0 + uv.y * 200.0));

    highp vec2 src = clamp(vec2(uv.x + wobble + bandShift + headShift, uv.y), 0.0, 1.0);

    // Chroma bleed: red drifts right of the picture and blue left of it.
    highp float bleed = 0.0006;
    highp float r = zTexture(clamp(src + vec2(bleed, 0.0), 0.0, 1.0)).r;
    highp float g = zTexture(src).g;
    highp float b = zTexture(clamp(src - vec2(bleed, 0.0), 0.0, 1.0)).b;
    highp vec3 rgb = vec3(r, g, b);

    // Low horizontal resolution: smear each sample with its neighbours.
    highp vec3 soft = (zTexture(clamp(src + vec2(0.002, 0.0), 0.0, 1.0)).rgb +
                       zTexture(clamp(src - vec2(0.002, 0.0), 0.0, 1.0)).rgb) * 0.5;
    rgb = mix(rgb, soft, 0.06);

    // Faintly washed-out, warm tape colour. The effect is kept light so you can still see what's on camera.
    highp float luma = dot(rgb, vec3(0.299, 0.587, 0.114));
    rgb = mix(vec3(luma), rgb, 0.97);
    rgb = rgb * vec3(1.03, 1.01, 0.97);

    // Night vision: everything is lit, so tint it green and lift the shadows a little.
    highp vec3 green = vec3(0.25, 1.0, 0.35) * (luma * 1.15 + 0.04);
    rgb = mix(rgb, green, nightVision);

    // Scanlines, kept faint: the static carries the look, not a dark raster.
    highp float scan = 0.5 - 0.5 * cos(FRAGCOORD.y * TAU / 3.0);
    rgb = rgb * (1.0 - scan * 0.025);

    // Static: fine grain over everything, sparse bright specks, and snow inside the tracking band.
    highp float noise = zRandom(FRAGCOORD.xy * SCREEN_PIXEL_SIZE + vec2(TIME * 13.0, TIME * 7.0)).x;
    highp float speck = step(0.997, zRandom(FRAGCOORD.xy * SCREEN_PIXEL_SIZE + vec2(TIME * 5.0, TIME * 17.0)).y);
    rgb = rgb + (noise - 0.5) * 0.02;
    rgb = rgb + speck * 0.08;
    rgb = rgb + band * noise * 0.05;

    // Vignette, in real pixel proportions so a wide tile darkens evenly.
    highp vec2 centred = uv * 2.0 - 1.0;
    highp vec2 asp = vec2(aspect, 1.0);
    highp vec2 inPixels = centred * asp;
    highp float r2 = dot(inPixels, inPixels) / dot(asp, asp);
    highp float vig = 1.0 - clamp(0.06 * r2 * r2, 0.0, 1.0);

    COLOR = vec4(clamp(rgb, 0.0, 1.0) * vig, 1.0);
}
