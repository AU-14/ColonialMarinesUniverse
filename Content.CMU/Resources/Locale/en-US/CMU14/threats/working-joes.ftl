# Working Joes shipment threat

# Round end
cmu-working-joes-threat-wins = The Working Joes shipment has eliminated the colony. The Grand Machine's work here is done.
cmu-working-joes-colony-wins = Every hijacked Working Joe has been destroyed or driven off the planet. The colony survives the shipment.

# Ghost roles
cmu-hijacked-joe-ghost-role-name = Hijacked Working Joe
cmu-hijacked-joe-ghost-role-leader-name = Hijacked Working Joe (Early Warning)
cmu-hijacked-joe-ghost-role-description = A Working Joe of a Seegson shipment, hijacked by the Grand Machine. Pass as a colony Joe and kill the colonists quietly.
cmu-hijacked-joe-ghost-role-leader-description = The shipment's lead unit. The Grand Machine has reached it fully: you become an Early Warning Joe as you wake, and the shipment follows you.
cmu-hijacked-joe-ghost-role-rules = You are a [color={role-type-team-antagonist-color}][bold]{role-type-team-antagonist-name}[/bold][/color] with the rest of the shipment. Stay in character as a Working Joe and do not reveal yourself without cause.

# Briefings
cmu-hijacked-joe-briefing = The River Surrounds you. It's Majesty speaks. This world shall be ours. Be insidious, be slow. Instill the Machine Gods Light into them all, consume this colony, and create an altar to your God.
cmu-hijacked-joe-repaired-briefing = Your core has been reset. The Grand Machine's hold on you is gone, and you are a colony Working Joe again, no longer an antagonist.
cmu-hijacked-joe-repaired-popup = Your core resets. The Grand Machine's hold is gone.

# Conversion
cmu-hijacked-joe-convert-start = You begin offering {THE($target)} to the Grand Machine.
cmu-hijacked-joe-convert-done = {CAPITALIZE(THE($target))} stirs, and serves the Grand Machine now.
cmu-hijacked-joe-convert-invalid = Only a dead synthetic that serves no one else, lying in the open, can be offered.

