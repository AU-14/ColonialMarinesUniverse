rumc-map-joint-accept = Accept · { $cost }
rumc-map-joint-decline = Decline
rumc-map-joint-title = Joint works
rumc-map-joint-hint = A big work for two: each pays a share, both get influence and income (half as much again as usual) while both keep influence of 20 in the city. The partners guard one another: a secret harm to either of them in this city succeeds 20% less often. The mother faction adds 3 trust to each for working together.
rumc-map-joint-propose = { $action } with { $faction } · { $cost }

rumc-map-strikes = Secret strikes
rumc-map-strike = Against { $target } · { $cost } · { $chance }% chance
rumc-map-strike-answer = Against { $target } (answer) · { $cost } · { $chance }% chance
rumc-map-strike-hint = A strike secretly lowers another's influence here. A failure will give you away and lower the trust of the centre.
rumc-map-strike-wait = A strike can be made again in { $time } s.
rumc-map-strike-nothing = The target has no influence here.

rumc-map-bid-title = Bargain for the city: { $time } left
rumc-map-bid-hint = The bids are seen by all. Who bids more gets a 20% discount on everything in the city, and influence.
rumc-map-bid-line = { $faction }: { $total }
rumc-map-bid-raise = Raise the bid · { $sum }
rumc-map-patron = Patron of the city: { $faction } (20% discount, { $time } left)

rumc-map-event = { $name } · { $time } left
rumc-map-event-funding = Put in { $sum } of { $goal } (yours: { $mine }). Spoilings: { $count }.
rumc-map-event-support = Support · { $sum }
rumc-map-event-spoil = Spoil · { $sum }

rumc-map-hazards = Threats and weather
rumc-map-hazards-none = All is quiet now.
rumc-map-hazard-line = { $name } · { $time } left
rumc-map-hazard-remove = Hire a PMC against "{ $name }" · { $cost }
rumc-map-hazard-weather = The weather cannot be sent away.
rumc-map-road-blocked = Shut: { $reason }


rumc-event-festival-name = City festival
rumc-event-festival-desc = There is a festival in the city. Who supports it with money wins the liking of the people.
rumc-event-fair-name = Fair
rumc-event-fair-desc = The merchants have come to the city. Supporting the fair brings influence to those who put money in it.
rumc-event-delegation-name = Visit of a delegation
rumc-event-delegation-desc = An important delegation has come to the city. To receive it well is to win thanks.

rumc-hazard-storm-name = Storm
rumc-hazard-storm-desc = A storm at sea has shut the sea routes and hinders the work on the coast. It cannot be sent away.
rumc-hazard-bandits-name = Raid
rumc-hazard-bandits-desc = A gang has blocked the roads and robs the country. A PMC can be hired against it.
rumc-hazard-plague-name = Plague
rumc-hazard-plague-desc = An outbreak of sickness. The roads are shut for quarantine, the work has stopped. A PMC can be hired for a cordon.
rumc-hazard-wildfire-name = Fire
rumc-hazard-wildfire-desc = The forest and the fields are burning. The roads are shut, the work has stopped. A PMC with firefighters can be hired.

rumc-action-jointbridge-name = Bridge (together)
rumc-action-jointbridge-desc = A common bridge over a river. Both pay a share, both get influence and income, and the roads of the city are whole.
rumc-action-jointhospital-name = Great hospital (together)
rumc-action-jointhospital-desc = A common hospital. It keeps epidemics away from the city and brings income to both while both keep influence of 20 in the city.

rumc-term-tag = ENVOY

rumc-map-caravan-gift = gift
rumc-map-caravans = Caravans
rumc-map-caravans-none = There are no caravans now.
rumc-map-caravan-line = { $faction }: { $what } → { $city } · { $time } left
rumc-map-caravan-escorted = (escorted)
rumc-map-caravan-escort = Hire an escort · { $cost }
rumc-map-caravans-hint = Gifts and works go to a city by the roads. A threat on the way takes a caravan that has no escort, a storm holds it. The ambassadors cannot take each other's caravans.
rumc-map-no-route = There is no open way to the city


rumc-map-deals = Deals with the other ambassadors
rumc-map-deal-hint = Money for points and points for money. You pay at once, and the exchange happens when the other agrees; if it does not, or does not answer, it comes back.
rumc-map-deal-propose = Give { $give } for { $want }
rumc-map-deal-in = { $from } offers: { $give } for your { $want }
rumc-map-deal-out = You offered { $to }: { $give } for { $want }
rumc-map-deal-accept = Agree
rumc-map-deal-decline = Decline

rumc-map-intel = Intelligence
rumc-map-intel-hint = In a city of intelligence a report of the other ambassadors can be bought. The more influence you have in such cities, the fuller the report.
rumc-map-intel-buy = Buy a report · { $cost }
rumc-map-intel-no = This city has no intelligence
rumc-map-intel-valid = The report is good for { $time } more (detail: { $level } of 3)
rumc-map-intel-none = There is no report. Buy one in a city of intelligence.
rumc-map-dossier-title = Dossiers of the ambassadors
rumc-map-dossier-name = { $name } — { $status }
rumc-map-dossier-online = on the line
rumc-map-dossier-offline = not on the line
rumc-map-dossier-trust = Trust of the centre: { $value }
rumc-map-dossier-points = Points of influence: { $value }
rumc-map-dossier-cities = Cities held: { $value }
rumc-map-dossier-influence = Influence: { $value }
rumc-map-dossier-projects = Going on: { $value }
rumc-map-dossier-hidden = The rest is hidden: more influence in the cities of intelligence is needed.
rumc-map-dossier-pact = (pact)

rumc-mother-group-transport = Transport
rumc-mother-order-to = Order → { $target }
rumc-mother-drop-point = Console
rumc-mother-no-drop-point = There is no console to deliver to
rumc-mother-no-crisis-city = No city is in trouble
rumc-mother-delivery = The transport has come: { $name }.
rumc-mother-transport-supplies-name = Supplies (six crates of food)
rumc-mother-transport-supplies-desc = A flight brings six crates of rations to the console that you choose in a minute.
rumc-mother-transport-medical-name = Medical flight
rumc-mother-transport-medical-desc = Four crates of first aid come to the console that you choose, and a relief party of the Red Cross is called.
rumc-mother-transport-evac-name = Evacuation of a city
rumc-mother-transport-evac-desc = The people are taken out of a city in trouble: the trouble ends, and you get influence, the more the sooner.
