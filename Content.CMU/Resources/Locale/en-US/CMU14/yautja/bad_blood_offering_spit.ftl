# trophy offering at the Lodge
cmu-bad-blood-offering-not-trophy = The Lodge only takes trophies.
cmu-bad-blood-offering-already-offered = {CAPITALIZE(THE($trophy))} has already been offered.
cmu-bad-blood-offering-stack = Split a single piece off {THE($trophy)} first. The Lodge takes one trophy at a time.
cmu-bad-blood-offering-unprepared = {CAPITALIZE(THE($trophy))} is not prepared. Polish bone and cure hide before you offer it.
cmu-bad-blood-offering-unknown = Nobody knows whose body {THE($trophy)} came from. The Lodge will not take it.
cmu-bad-blood-offering-unworthy = {CAPITALIZE(THE($trophy))} was not cut from a kill, or it came from a Yautja, a synthetic or a larva. The Lodge will not take it.
cmu-bad-blood-offering-body-spent = The Lodge already holds two trophies from that body.
cmu-bad-blood-offering-start = You begin hanging {THE($trophy)} on the Lodge.
cmu-bad-blood-offering-finished = You hang {THE($trophy)} on the Lodge. The clan gains { $sp } Superiority Points.
cmu-bad-blood-offering-examine = { $count ->
        [0] No trophies hang on it yet.
        [one] One trophy hangs on it.
       *[other] { $count } trophies hang on it.
    }
cmu-bad-blood-offering-examine-sp = The clan holds [color=#c9a227]{ $sp }[/color] Superiority Points.

# the Lodge spit
cmu-bad-blood-spit-denied = You do not know how to work the spit.
cmu-bad-blood-spit-not-dead = Only a dead body goes on the spit.
cmu-bad-blood-spit-not-prey = That is not prey. The spit is for humans and serpents.
cmu-bad-blood-spit-refuse-yautja = The clan does not eat its own kind.
cmu-bad-blood-spit-refuse-synth = There is no meat on a synthetic.
cmu-bad-blood-spit-refuse-larva = There is nothing on that worth cooking.
cmu-bad-blood-spit-unlit = The fire is out. Rekindle it first.
cmu-bad-blood-spit-busy = Something is already turning on the spit.
cmu-bad-blood-spit-rekindled = You rekindle the fire.
cmu-bad-blood-spit-corpse-start = You run the spit through {THE($target)} and start turning it over the fire.
cmu-bad-blood-spit-corpse-finished = The carcass is cooked through. The clan gains { $sp } Superiority Points.
cmu-bad-blood-spit-corpse-finished-unpaid = The carcass is cooked through. It earns the clan nothing.
cmu-bad-blood-spit-meat-start = You hold {THE($target)} over the fire.
cmu-bad-blood-spit-meat-finished = The cut is seared. The clan gains { $sp } Superiority Points.
cmu-bad-blood-spit-meat-finished-unpaid = The cut is seared. It earns the clan nothing.
cmu-bad-blood-spit-flask-full = {CAPITALIZE(THE($flask))} is already full.
cmu-bad-blood-spit-flask-filled = You fill {THE($flask)} with water.
