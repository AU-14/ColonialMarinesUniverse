# FLOW-512 / FLOW-513: the Lodge quarry and Bad Blood fortifications

cmu-bad-blood-quarry-clan-only = Only the clan cuts stone from this quarry.
cmu-bad-blood-quarry-empty = The quarry is bare. Offerings, Totems and sabotage bring more stone.
cmu-bad-blood-quarry-drawn = You take {$count} bricks. {$stone} stone is left.
cmu-bad-blood-quarry-full = The quarry holds all the stone it can.
cmu-bad-blood-quarry-returned = You stack {$count} bricks back on the quarry. It holds {$stone} stone.
cmu-bad-blood-quarry-examine = It holds [color=yellow]{$stone}[/color] of {$cap} stone.

cmu-bad-blood-brick-clan-only = Only a Bad Blood knows how to set these stones.
cmu-bad-blood-brick-out-of-range = The clan's stone only holds within {$radius} tiles of the Lodge or a Totem.
