au14-anvil-occupied = Something's already sitting on that anvil.
au14-anvil-placed = You set it down on the anvil with the tongs.
au14-anvil-forging-started = You start forging a { $name }.

au14-anvil-not-seated = It needs to be sitting on an anvil to work it.
au14-anvil-too-cold = It's too cold to shape - it'll need reheating.
au14-anvil-wrong-tool = This step needs a { $tool }.
au14-anvil-hit = You strike it. { $remaining ->
    [one] One more hit and it'll be done.
    *[other] { $remaining } hits left.
}
au14-anvil-finished = The { $name } is finished, cool enough to handle.

au14-anvil-examine-forging = Being forged - { $remaining ->
    [0] the last hit just landed.
    *[other] { $remaining } strikes left.
}

au14-anvil-recipe-metal-sheet = metal sheet
au14-anvil-recipe-forged-parts = forged parts
au14-anvil-recipe-forged-nails = forged nails
au14-anvil-recipe-armour-plates = armour plates
au14-anvil-recipe-empty-mold = empty mold
au14-anvil-recipe-brass-empty-mold = brass mold
au14-anvil-recipe-brass-parts = brass parts
au14-anvil-recipe-steel-drill-head = steel drill head
au14-anvil-recipe-steel-pipe = steel pipe
au14-anvil-recipe-steel-pipe-down = steel pipe going down
au14-anvil-recipe-steel-pump = steel water pump
