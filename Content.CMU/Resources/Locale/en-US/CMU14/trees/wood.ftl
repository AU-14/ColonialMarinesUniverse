ent-RUMCWoodLog = log
    .desc = A heavy log of a felled tree. It takes both hands and slows whoever carries it. Saw it into planks, or split it into firewood with an axe.
ent-RUMCFirewood1 = firewood
    .desc = A split billet of wood for the fire. It burns in a campfire or a stove.
ent-RUMCHandSaw = hand saw
    .desc = A broad hand saw with a steel blade. Hold it to a log and it makes planks.
ent-RUMCCrateHandSaws = hand saws crate
    .desc = Three hand saws for the woodcutters of the colony.
ent-RUMCTreeBirch = birch
    .desc = A tall white birch. Its crown is high and its trunk is slim.

tool-quality-au14-log-sawing-name = Sawing a log
tool-quality-au14-log-sawing-tool-name = Saw

au14-log-saw-verb = Saw into planks
au14-log-saw-tooltip = Saw the log into planks with a saw.
