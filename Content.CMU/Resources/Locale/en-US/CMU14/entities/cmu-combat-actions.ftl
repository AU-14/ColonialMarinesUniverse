# Group-less close-quarters actions (ew_joe_actions.yml) for any body with the matching component. The Early Warning
# Joe's own actions parent these and keep their own ent- entries in jobs/ew-joe.ftl.

ent-CMUActionOpticalZoom = Optical Zoom
    .desc = Push your optics far down the line you face, like a bio-mask scope. Use again to pull them back.

ent-CMUActionDrown = Drown
    .desc = Hold a grabbed organic under while cables fill its lungs. Eight seconds: they sleep where they fall, and you mend from what they lose.

ent-CMUActionOffer = Offer
    .desc = Offer a dead Working Joe or synthetic within reach to the Grand Machine. After a few seconds it rises again as one of you.
