# Hotspot objectives
cmu-hotspot-objective-controller = { $faction } has taken control of the hotspot zone

# Force on Force time limit rule
fof-time-limit-score-leading = Hotspot control: GOVFOR {$govfor} - OPFOR {$opfor}. {$faction} is leading!
fof-time-limit-score-tied = Hotspot control: GOVFOR {$govfor} - OPFOR {$opfor}. The score is tied!
fof-time-limit-sudden-death = Time limit reached. Overtime begins: the side behind on hold-ticks must take the zone and still hold it at the cap to steal the round. If they don't, the leader wins on score!
fof-time-limit-zone-victory = {$faction} took and held the hotspot zone in sudden death!
fof-time-limit-victory = Held the hotspot lead at round end, {$govfor} zone ticks to {$opfor}.
fof-time-limit-draw = The round ends in a draw. GOVFOR {$govfor} - OPFOR {$opfor} in hotspot control.

