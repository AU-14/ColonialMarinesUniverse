# Auctions
rumc-auction-title = Auctions of plots
rumc-auction-hint = The mayor puts up the first free plot of the kind he picks. The townsfolk bid against each other: a bid is held out of the account at once, and a bid that is topped is given back. The highest at the end wins, and a bid in the last 30 seconds lengthens the auction.
rumc-auction-start-price = Start price: { $value }
rumc-auction-start = Put a plot up for auction
rumc-auction-running = Auctions that go
rumc-auction-none = There are no auctions.
rumc-auction-line = { $zone }, { $place }
rumc-auction-place = corner X { $x }, Y { $y }
rumc-auction-no-bids = No bids. Start { $start }, { $time } left
rumc-auction-best = Best bid { $sum } ({ $leader }), { $time } left
rumc-auction-min = The next bid at least { $min }
rumc-auction-cancel = Take it off
rumc-auction-bid = Bid
rumc-auction-defaulter = The city does not deal with defaulters.
rumc-auction-plot-limit = You have { $max } plots already.
rumc-auction-too-low = The bid is too low: at least { $min }.
rumc-auction-no-money = Not enough money on the account: { $sum }.
rumc-auction-bid-taken = Bid taken: { $sum }.
rumc-citizen-auction-hint = Type a bid and press "Bid". The money is held at once, a bid that is topped is given back.
rumc-citizen-auction-none = No plots are for sale now.

# Tenders
rumc-tender-title = Tenders for the orders
rumc-tender-hint = The mayor announces an order with no price: it goes to the one who offers less for a piece. The winner gets the whole order, and no one else may fill it.
rumc-tender-ceiling = The ceiling of the price for a piece: { $value }
rumc-tender-start = Announce the tender
rumc-tender-running = Tenders that go
rumc-tender-none = There are no tenders.
rumc-tender-line = { $kind }: { $amount } pieces, not above { $max } for a piece
rumc-tender-no-bids = No offers, { $time } left
rumc-tender-best = Best price { $price } ({ $leader }), { $time } left
rumc-tender-cancel = Cancel the tender
rumc-tender-offer = Offer a price
rumc-tender-too-high = A lower price is needed: not above { $max }.
rumc-tender-bid-taken = Offer taken: { $price } for a piece.
rumc-citizen-tender-hint = Type a price for a piece, lower than the best now. The winner fills the order himself.
rumc-citizen-tender-none = There are no tenders.
rumc-order-not-yours = This order is won by another: { $name }.

# Loans to the townsfolk
rumc-playerloan-title = Loans to the townsfolk
rumc-playerloan-hint = The mayor offers a loan to a townsman who stands by the console. The money comes out of the budget: if the townsman does not pay it back, it is the loss of the city. The townsman decides whether to take it.
rumc-playerloan-principal = The sum
rumc-playerloan-instalments = Number of instalments (one every 5 minutes)
rumc-playerloan-interest = Interest for the whole term
rumc-playerloan-terms = Instalment { $instalment }, will pay back { $total } in all
rumc-playerloan-offer = Offer the loan
rumc-playerloan-offers = Offers
rumc-playerloan-offers-none = There are no offers.
rumc-playerloan-offer-line = { $name }: { $sum }, { $count } instalments of { $instalment }
rumc-playerloan-withdraw = Withdraw the offer
rumc-playerloan-loans = Loans in force
