# The tabs
rumc-government-tab-subsidies = Subsidies
rumc-citizen-tab-subsidies = Subsidies

# What the mayor sees
rumc-subsidy-title = Subsidies for starting a business
rumc-subsidy-hint = A townsman applies for a grant or a loan. The whole sum is held out of the budget at once, a part goes to the townsman at once, and the rest by the stages of the plan. If the plan is not done in time, what is left goes back to the budget, and what was paid becomes a loan at a high interest.
rumc-subsidy-applications = Applications
rumc-subsidy-applications-none = There are no applications.
rumc-subsidy-application-line = { $name }: { $business }, { $form } { $sum }
rumc-subsidy-plan-line = At once { $upfront }%. The plan: { $plan }. Time { $time }
rumc-subsidy-approve = Approve
rumc-subsidy-reject = Turn down
rumc-subsidy-active = Subsidies at work
rumc-subsidy-active-none = No subsidies are at work.
rumc-subsidy-active-line = { $name }: { $business }, { $form }
rumc-subsidy-money-line = Paid { $paid } of { $total }, held { $held }
rumc-subsidy-stage-line = Stage: { $stage }. Done { $progress } of { $target }. { $time } left
rumc-subsidy-cancel = Take the subsidy back
rumc-subsidy-catalog = Kinds of business
rumc-subsidy-catalog-line = Premises needed: { $zone }. Grant { $grant }, loan { $loan }, at once { $upfront }%
rumc-subsidy-form-grant = grant
rumc-subsidy-form-loan = loan
rumc-subsidy-stage-done = every stage is done
rumc-subsidy-plan-deliver = deliver { $target } pieces to the orders of the city ({ $percent }% of the sum)
rumc-subsidy-plan-rent = pay the rent of the plot { $target } times ({ $percent }% of the sum)
rumc-subsidy-plan-deals = seal { $target } deals at the notary ({ $percent }% of the sum)

# Why not
rumc-subsidy-have = You have an application or a subsidy already.
rumc-subsidy-full = The queue of applications is full.
rumc-subsidy-need-plot = You need your own plot in the zone "{ $zone }": your business will be there.
rumc-subsidy-no-account = A bank account is needed.
rumc-subsidy-gone = The applicant is not available.
rumc-subsidy-too-many = { $max } subsidies are at work already.
rumc-subsidy-no-money = The budget has not the money for the whole sum.

# What the townsman is told
rumc-subsidy-sent = The application is sent to the mayor.
rumc-subsidy-approved = The subsidy is approved. { $sum } is paid to you at once, the rest by the stages of the plan.
rumc-subsidy-rejected = The mayor has turned down the application.
rumc-subsidy-tranche = A stage of the plan is done. { $sum } is paid.
rumc-subsidy-done-grant = The plan is done: the grant is yours.
rumc-subsidy-done-loan = The plan is done: what was paid is now your loan, pay it in parts.
rumc-subsidy-failed = The plan was not done in time. What was left went back to the budget, and what was paid became a loan at a high interest.

# For the townsfolk
rumc-citizen-subsidy-hint = Pick a business and apply. The mayor approves it or turns it down. You need your own plot in the right zone and a bank account. A grant is not paid back if the plan is done; a loan is paid back in parts.
rumc-citizen-subsidy-yours = Your subsidy
rumc-citizen-subsidy-warning = If you do not make it in time, what is left goes back to the budget, and what you got becomes a loan at 15%.
rumc-citizen-subsidy-waiting = Your application
rumc-citizen-subsidy-withdraw = Withdraw the application
rumc-citizen-subsidy-premises = Your plot in the zone is needed: { $zone }
rumc-citizen-subsidy-apply-grant = Grant { $sum }
rumc-citizen-subsidy-apply-loan = Loan { $sum }

# The kinds of business
rumc-business-stall-name = Stall
rumc-business-stall-desc = A small point at the market: trade in small things. A small sum, an easy plan.
rumc-business-shop-name = Shop
rumc-business-shop-desc = A standing shop by the square. A plot in the trade zone is needed.
rumc-business-workshop-name = Workshop
rumc-business-workshop-desc = Production: equipment and materials. A plot in the production zone is needed.
