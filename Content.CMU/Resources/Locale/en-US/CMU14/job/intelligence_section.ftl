cmu-department-intelligence-section = Intelligence Section
cmu-department-intelligence-section-description = A discreet colony department that gathers information, runs field teams and keeps a small armed element.

cmu-job-supervisors-intel-handler = whoever is running the operation (the admins)
cmu-job-supervisors-intel-gru-spetsnaz-officer = the GRU Spetsnaz Officer
cmu-job-supervisors-intel-cia-sad-officer = the CIA SAD Officer
cmu-job-supervisors-intel-sas-officer = the Special Air Service Detachment Officer

cmu-job-name-intel-case-officer = Case Officer
cmu-job-description-intel-case-officer = Lead a field team for the Intelligence Section. You carry your real section ID and a colonist cover ID to blend in with the colony.

cmu-job-name-intel-gru-spetsnaz-officer = GRU Spetsnaz Officer
cmu-job-description-intel-gru-spetsnaz-officer = Lead the Intelligence Section's GRU Spetsnaz team: heavy armor, heavy weapons and the means to bring people back alive.
cmu-job-prefix-intel-gru-spetsnaz-officer = GRU OFF

cmu-job-name-intel-gru-spetsnaz-member = GRU Spetsnaz Member
cmu-job-description-intel-gru-spetsnaz-member = Serve on the Intelligence Section's GRU Spetsnaz team under the GRU Spetsnaz Officer.
cmu-job-prefix-intel-gru-spetsnaz-member = GRU

cmu-job-name-intel-cia-sad-officer = CIA SAD Officer
cmu-job-description-intel-cia-sad-officer = Lead the Intelligence Section's CIA Special Activities Division team: a light, deniable armed element.
cmu-job-prefix-intel-cia-sad-officer = SAD OFF

cmu-job-name-intel-cia-sad-member = CIA SAD Member
cmu-job-description-intel-cia-sad-member = Serve on the Intelligence Section's CIA Special Activities Division team under the CIA SAD Officer.
cmu-job-prefix-intel-cia-sad-member = SAD

cmu-job-name-intel-sas-officer = Special Air Service Detachment Officer
cmu-job-description-intel-sas-officer = Lead the SIS's Special Air Service detachment, the Intelligence Section's light Three World Empire armed element.
cmu-job-prefix-intel-sas-officer = SAS OFF

cmu-job-name-intel-sas-member = Special Air Service Detachment Member
cmu-job-description-intel-sas-member = Serve in the SIS's Special Air Service detachment under the Special Air Service Detachment Officer.
cmu-job-prefix-intel-sas-member = SAS

