cmu-sentry-broken = {CAPITALIZE(THE($sentry))} sparks, shudders and grinds to a halt!
cmu-sentry-broken-cant-turn-on = {CAPITALIZE(THE($sentry))} is wrecked and won't power up. It needs repairing first.
cmu-sentry-broken-examine = [color=red]It's wrecked.[/color] To repair it while it's deployed:

cmu-sentry-repair-step-done = [color=gray]{ $number }. { $step } (done)[/color]
cmu-sentry-repair-step-next = [color=yellow]{ $number }. { $step } (next)[/color]
cmu-sentry-repair-step-todo = { $number }. { $step }

cmu-sentry-repair-step-cut = Cut away the burnt wiring with wirecutters.
cmu-sentry-repair-step-weld-frame = Weld the cracked frame back together with a welder.
cmu-sentry-repair-step-rewire = Rewire it with { $amount } lengths of cable coil.
cmu-sentry-repair-step-screw = Screw the internal panels back down with a screwdriver.
cmu-sentry-repair-step-tune = Recalibrate its targeting with an access tuner.
cmu-sentry-repair-step-weld-casing = Weld the casing shut with a welder.

cmu-sentry-repair-deploy-first = {CAPITALIZE(THE($sentry))} has to be deployed before you can repair it.
cmu-sentry-repair-wrong-tool = That's not what {THE($sentry)} needs right now. Next: { $step }
cmu-sentry-repair-need-cable = You need at least { $amount } lengths of cable coil.

cmu-sentry-repair-start-cut = You start cutting the burnt wiring out of {THE($sentry)}.
cmu-sentry-repair-start-weld-frame = You start welding {THE($sentry)}'s cracked frame.
cmu-sentry-repair-start-rewire = You start rewiring {THE($sentry)}.
cmu-sentry-repair-start-screw = You start screwing {THE($sentry)}'s panels back down.
cmu-sentry-repair-start-tune = You start recalibrating {THE($sentry)}'s targeting.
cmu-sentry-repair-start-weld-casing = You start welding {THE($sentry)}'s casing shut.

cmu-sentry-repair-done-cut = You cut the last of the burnt wiring out of {THE($sentry)}.
cmu-sentry-repair-done-weld-frame = {CAPITALIZE(THE($sentry))}'s frame is whole again.
cmu-sentry-repair-done-rewire = You finish rewiring {THE($sentry)}.
cmu-sentry-repair-done-screw = {CAPITALIZE(THE($sentry))}'s panels are secure.
cmu-sentry-repair-done-tune = {CAPITALIZE(THE($sentry))}'s targeting beeps back to life.
cmu-sentry-repair-finished = You seal {THE($sentry)}'s casing. It's working again.
cmu-sentry-repair-finished-others = { $user } finishes repairing {THE($sentry)}.

# RMC sentry lines that had no text
rmc-sentry-disassembled-with-wrench = It can be disassembled with a [color=cyan]wrench[/color].
rmc-sentry-faction-set-with-multitool = Use a [color=cyan]multitool[/color] on it to set it to your IFF.
rmc-sentry-no-faction-set = {CAPITALIZE(THE($sentry))} has no IFF set. Use a multitool on it first.
