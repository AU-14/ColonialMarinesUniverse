ent-CMUExpeditionScavenger = armed scavenger
    .desc = A survivor holding the wreck perimeter. Their battered rifle is very real.
cmu-expedition-scavenger-identity = armed scavenger
cmd-cmu-expedition-ai-desc = Spawn a scavenger squad here on any map, or at an expedition objective.
cmd-cmu-expedition-ai-help = cmu-expedition-ai <map ID|here> [count: 1-12] [mixed|regular|poor|rich|scout]
cmu-expedition-here-no-player = The 'here' option needs your attached player or observer on a map with ground.
cmu-expedition-ai-use-here = This map has no expedition objective. Stand or ghost over the desired ground and use cmu-expedition-ai here instead.
cmu-expedition-ai-no-space = No safe ground was found nearby. Move away from water, cliffs, fire, or occupied ground.
cmu-expedition-ai-deployed = Deployed {$count}/{$requested} {$variant} scavengers in squad {$squad} on map {$map}. Use cmu-expedition-orders to direct them.
cmu-expedition-orders-none = No guards accepted the order. Check the squad ID and clear ground. Patrols need 2-8 waypoints; dead or player-controlled guards cannot receive movement orders.
cmu-expedition-ai-orders-status = Orders: destination {$destination}, patrol {$patrolling}, waypoint {$waypoint}/{$points}, blocked {$blocked} (retries after 3 seconds).
ent-CMUExpeditionScavengerPoor = scavenger scrapper
    .desc = A hungry wreck-picker in a patched coat. A surplus pistol and one spare magazine are all they can afford.
ent-CMUExpeditionScavengerRich = scavenger salvage baron
    .desc = Successful salvage buys ceramic plates and a stolen pulse rifle. This one paid to survive the next claim dispute.
ent-CMUExpeditionScavengerScout = scavenger trail scout
    .desc = A backwoods pathfinder carrying a short carbine and smoke for a hasty escape. They spot trouble before the rest of the crew.
cmu-expedition-poor-identity = scavenger scrapper
cmu-expedition-rich-identity = scavenger salvage baron
cmu-expedition-scout-identity = scavenger trail scout
cmu-expedition-ai-already-spawned = This expedition already received its preview squad.
cmu-expedition-ai-spawned = Deployed {$count} armed scavengers near the wreck.
ent-CMUExpeditionFieldDressing = expedition field dressing
    .desc = A compact emergency dressing for stabilizing minor combat injuries. Three applications per pack.
cmu-expedition-field-dressing-stack = field dressings
cmd-cmu-expedition-ai-status-desc = Show expedition infantry actions, cover choices and search costs.
cmd-cmu-expedition-ai-status-help = cmu-expedition-ai-status <map ID|here>
cmu-expedition-ai-status-line = {$entity}: {$disposition}/{$emotion}, stress {$stress}, initiative {$initiative} | squad {$squad}, {$goal}/{$action}, {$state} at {$position} | ammo {$ammo}, damage {$damage}, suppressed {$suppressed}, fire check {$fireCheck} | shelter {$anchor}, peek {$peek} | search {$cells} cells / {$milliseconds} ms (max {$maxSearchMs}), route {$routeCells} / {$routeMs} ms | reloads {$reloads}, grenades {$grenades}, rescues {$rescues}, flanks {$flanks}, reports {$reports}, failures {$failures}
ent-CMUExpeditionScavengerAggressive = scavenger raider
    .desc = A bold rifleman who presses a clear opening, but can still be rattled by incoming fire.
ent-CMUExpeditionScavengerCautious = scavenger sentry
    .desc = A patient defender who favors distance, measured shots and a safe way back.
cmu-expedition-raider-identity = scavenger raider
cmu-expedition-sentry-identity = scavenger sentry
cmu-expedition-contact-report = Contact at my last observed position. Cover the approach.
cmu-expedition-support-response = Copy that contact. Moving to support; cover my approach.
cmu-expedition-ai-radio-status = Radio: {$received} received / {$accepted} accepted, {$decision}, acting on radio {$radioContact}, approach {$destination}.
cmu-expedition-ai-survival-status = Survival: weapon {$weapon}, recovered {$recovered}, spacing {$spacing} to {$destination}, rejected cover {$cover}, preparing work {$preparing}, working {$working}.
cmu-expedition-radio-channel = Field squad
ent-CMUExpeditionHeadset = scavenger field headset
    .desc = A short-range squad radio. It works without a tower within forty metres.
ent-CMUExpeditionEncryptionKey = field squad encryption key
    .desc = A key for a scavenger field radio.
ent-CMUExpeditionBlastGrenade = scavenger HEDP grenade
    .desc = A standard four-second blast grenade carried in a scavenger's field supplies.
ent-CMUExpeditionSmokeGrenade = scavenger smoke grenade
    .desc = A smoke grenade carried for covering a withdrawal or casualty recovery.
