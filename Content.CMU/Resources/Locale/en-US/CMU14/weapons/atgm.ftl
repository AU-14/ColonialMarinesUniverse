cmu-atgm-not-deployed = {CAPITALIZE(THE($launcher))} needs to be deployed first.
cmu-atgm-unskilled = You don't know how to work {THE($launcher)}.
cmu-atgm-gunner-cannot-load = You can't reload {THE($launcher)} while manning it. Your loader has to do that.
cmu-atgm-already-loaded = {CAPITALIZE(THE($launcher))} already has a missile in the tube.
cmu-atgm-load-start-self = You start loading {THE($missile)} into {THE($launcher)}.
cmu-atgm-load-start-others = {CAPITALIZE(THE($user))} starts loading {THE($missile)} into {THE($launcher)}.
cmu-atgm-loaded = You seat the missile in {THE($launcher)}.
cmu-atgm-link-start = You start wiring {THE($finder)} to {THE($launcher)}.
cmu-atgm-linked = You wire {THE($finder)} to {THE($launcher)}.

cmu-atgm-no-finder = No finder is wired to the launcher.
cmu-atgm-finder-not-held = Nobody is holding the linked finder.
cmu-atgm-spotter-is-gunner = You need a second crewman on the finder to guide the missile.
cmu-atgm-spotter-incapacitated = Your spotter can't guide the missile right now.
cmu-atgm-spotter-unskilled = Your spotter doesn't know how to guide the missile.
cmu-atgm-spotter-too-far = Your spotter is too far from the launcher.

cmu-atgm-examine-loaded = A missile is [color=green]loaded[/color].
cmu-atgm-examine-empty = The launch tube is [color=red]empty[/color].
cmu-atgm-examine-linked = A finder is [color=green]wired in[/color].
cmu-atgm-examine-unlinked = No finder is [color=red]wired in[/color].
cmu-atgm-finder-examine-linked = It is [color=green]wired to a launcher[/color].
cmu-atgm-finder-examine-unlinked = It is [color=red]not wired to a launcher[/color].
cmu-atgm-finder-examine-locked = It is lasing {THE($target)}.

cmu-atgm-lock-acquired = You lase {THE($target)}. Missiles fired now will home on it.
cmu-atgm-lock-cleared = You stop lasing the target.
cmu-atgm-lock-none = You aren't lasing anything.
cmu-atgm-lock-lost = You lose the lock.
cmu-atgm-lock-broken = You lose the lock on {THE($target)}. Hold still while lasing.
cmu-atgm-lock-expired = Your lock on {THE($target)} times out.
cmu-atgm-lock-no-target = There's nothing there to lock onto.
cmu-atgm-lock-not-linked = The finder needs to be wired to a launcher first.
cmu-atgm-lock-unskilled = You don't know how to lase targets for the A.T.G.M.
cmu-atgm-lock-invalid-target = You can't lock onto that.
cmu-atgm-lock-cooldown = The finder is still recalibrating.
cmu-atgm-lock-no-sight = You can't get a clear line on that.
cmu-atgm-lock-in-flight = You can't change targets while the missile is in flight.
