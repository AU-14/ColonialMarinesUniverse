<!-- CMU14 -->
<PanelContainer xmlns="https://spacestation14.io"
                HorizontalExpand="True">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="0">
        <PanelContainer Name="AccentEdge" MinWidth="2" VerticalExpand="True" />
        <BoxContainer Orientation="Horizontal"
                      HorizontalExpand="True"
                      SeparationOverride="12"
                      Margin="12 10 14 9">
                              <!-- CMU14: tighter preview layout with accent edge -->
            <PanelContainer Name="PreviewFrame" MinSize="56 56" VerticalAlignment="Center" />
            <BoxContainer Orientation="Vertical"
                          HorizontalExpand="True"
                          VerticalAlignment="Center"
                          SeparationOverride="3">
                                      <!-- CMU14: compact title and description column -->
                <Label Name="Title" ClipText="True" HorizontalExpand="True" />
                <!-- The right margin is load-bearing, and it has to be here rather than a minimum width
                     on the count beside it. -->
                <RichTextLabel Name="Description" HorizontalExpand="True" Margin="0 0 12 0" />
            </BoxContainer>
            <BoxContainer Orientation="Vertical"
                          VerticalAlignment="Center"
                          SeparationOverride="1">
                <Label Name="CountLabel" Align="Right" />
                <Label Name="KindLabel" Align="Right" />
            </BoxContainer>
        </BoxContainer>
    <!-- CMU14 -->
    </BoxContainer>
</PanelContainer>
