<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'ghost-roles-window-title'}"
               MinSize="560 340"
               SetSize="600 380">
    <PanelContainer Name="Ground" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical"
                      HorizontalExpand="True"
                      VerticalExpand="True"
                      Margin="1"
                      SeparationOverride="0">
            <ScrollContainer Name="RulesScroll"
                             HorizontalExpand="True"
                             VerticalExpand="True"
                             HScrollEnabled="False">
                <RichTextLabel Name="TopBanner"
                               HorizontalExpand="True"
                               VerticalAlignment="Top"
                               Margin="14 12" />
            </ScrollContainer>
            <PanelContainer Name="ActionBar" HorizontalExpand="True">
                <Button Name="RequestButton"
                        Text="{Loc 'ghost-roles-window-request-role-button'}"
                        Disabled="True"
                        TextAlign="Center"
                        ClipText="True"
                        HorizontalAlignment="Center"
                        MinWidth="200" />
            </PanelContainer>
        </BoxContainer>
    </PanelContainer>
</DefaultWindow>
