<tabs:CmuTab xmlns="https://spacestation14.io"
             xmlns:tabs="clr-namespace:Content.Client.Options.UI.Tabs"
             xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="10 8 10 8" SeparationOverride="2" VerticalExpand="True">
                <Button Name="OpenUiSetupButton" Text="{Loc 'cmu-ui-setup-open'}" Margin="0 0 0 8" />
                <ui:CmuAppearanceOptions Name="Appearance" />

                <!-- cmu edit start: settings grouped by what they do -->
                <Label Text="{Loc 'cmu-ui-options-interface'}" Margin="0 10 0 0" StyleClasses="LabelKeyText" />
                <CheckBox Name="VoteUiLargeCheckBox"
                          Text="{Loc 'cmu-ui-options-vote-ui-large'}"
                          ToolTip="{Loc 'cmu-ui-options-vote-ui-large-tooltip'}" />
                <CheckBox Name="TemperatureFahrenheitCheckBox"
                          Text="{Loc 'cmu-ui-options-temperature-fahrenheit'}"
                          ToolTip="{Loc 'cmu-ui-options-temperature-fahrenheit-tooltip'}" />

                <Label Text="{Loc 'cmu-ui-options-gameplay'}" Margin="0 10 0 0" StyleClasses="LabelKeyText" />
                <CheckBox Name="TileMovementCheckBox"
                          Text="{Loc 'cmu-ui-options-tile-movement'}"
                          ToolTip="{Loc 'cmu-ui-options-tile-movement-tooltip'}" />
                <!-- cmu edit start: tile movement only while walking -->
                <CheckBox Name="TileMovementWalkOnlyCheckBox"
                          Text="{Loc 'cmu-ui-options-tile-movement-walk-only'}"
                          ToolTip="{Loc 'cmu-ui-options-tile-movement-walk-only-tooltip'}" />
                <!-- cmu edit end -->
                <CheckBox Name="AutoIngestCheckBox"
                          Text="{Loc 'cmu-ui-options-auto-ingest'}"
                          ToolTip="{Loc 'cmu-ui-options-auto-ingest-tooltip'}" />
                <CheckBox Name="ScreamOnHotbarCheckBox"
                          Text="{Loc 'cmu-ui-options-scream-on-hotbar'}"
                          ToolTip="{Loc 'cmu-ui-options-scream-on-hotbar-tooltip'}" />
                <CheckBox Name="VaultOnBumpCheckBox"
                          Text="{Loc 'cmu-ui-options-vault-on-bump'}"
                          ToolTip="{Loc 'cmu-ui-options-vault-on-bump-tooltip'}" />

                <Label Text="{Loc 'cmu-ui-options-medical'}" Margin="0 10 0 0" StyleClasses="LabelKeyText" />
                <CheckBox Name="TargetedHealingCheckBox"
                          Text="{Loc 'cmu-ui-options-targeted-healing'}"
                          ToolTip="{Loc 'cmu-ui-options-targeted-healing-tooltip'}" />
                <CheckBox Name="AutoReapplyKitsCheckBox"
                          Text="{Loc 'cmu-ui-options-auto-reapply-kits'}"
                          ToolTip="{Loc 'cmu-ui-options-auto-reapply-kits-tooltip'}" />
                <CheckBox Name="UiLessSurgeryCheckBox"
                          Text="{Loc 'cmu-ui-options-ui-less-surgery'}"
                          ToolTip="{Loc 'cmu-ui-options-ui-less-surgery-tooltip'}" />

                <Label Text="{Loc 'cmu-ui-options-identification'}" Margin="0 10 0 0" StyleClasses="LabelKeyText" />
                <CheckBox Name="FoFUnidentifiedMarkerCheckBox"
                          Text="{Loc 'cmu-ui-options-fof-unidentified-marker'}"
                          ToolTip="{Loc 'cmu-ui-options-fof-unidentified-marker-tooltip'}" />

                <Label Text="{Loc 'cmu-options-tacmap'}" Margin="0 10 0 0" StyleClasses="LabelKeyText" />
                <CheckBox Name="ClassicTacMapCheckBox" Text="{Loc cmu-options-tacmap-classic}"
                          ToolTip="{Loc cmu-options-tacmap-classic-tooltip}" />
                <CheckBox Name="CenterTacMapCheckBox" Text="{Loc cmu-options-tacmap-center}"
                          ToolTip="{Loc cmu-options-tacmap-center-tooltip}" />

                <Label Text="{Loc 'ui-options-cmu-chat'}" Margin="0 10 0 0" StyleClasses="LabelKeyText" />
                <CheckBox Name="ChatSpeechSoundsCheckBox"
                          Text="{Loc 'cmu-ui-options-chat-speech-sounds'}"
                          ToolTip="{Loc 'cmu-ui-options-chat-speech-sounds-tooltip'}" />
                <CheckBox Name="ChatResetToLocalCheckBox"
                          Text="{Loc 'cmu-ui-options-chat-reset-to-local'}"
                          ToolTip="{Loc 'cmu-ui-options-chat-reset-to-local-tooltip'}" />
                <CheckBox Name="ChatCenterInputCheckBox"
                          Text="{Loc 'cmu-ui-options-chat-center-input'}"
                          ToolTip="{Loc 'cmu-ui-options-chat-center-input-tooltip'}" />
                <CheckBox Name="RunechatSpeechBubblesCheckBox" Text="{Loc 'ui-options-runechat-speech'}" />
                <ui:OptionSlider Name="RunechatSpeechBubbleScaleSlider" Title="{Loc 'ui-options-runechat-speech-scale'}" />

                <Label Text="{Loc 'cmu-ui-options-popups-examine'}" Margin="0 10 0 0" StyleClasses="LabelKeyText" />
                <CheckBox Name="PopupsInChatCheckBox"
                          Text="{Loc 'cmu-ui-options-popups-in-chat'}"
                          ToolTip="{Loc 'cmu-ui-options-popups-in-chat-tooltip'}" />
                <CheckBox Name="HidePopupsOnScreenCheckBox"
                          Text="{Loc 'cmu-ui-options-hide-popups-on-screen'}"
                          ToolTip="{Loc 'cmu-ui-options-hide-popups-on-screen-tooltip'}" />
                <CheckBox Name="ExamineLogInChatCheckBox" Text="{Loc 'cmu-ui-options-examine-log-in-chat'}" />
                <CheckBox Name="ExamineFullTextInChatCheckBox" Text="{Loc 'cmu-ui-options-examine-full-text-in-chat'}" />
                <CheckBox Name="HideExamineTooltipCheckBox"
                          Text="{Loc 'cmu-ui-options-hide-examine-tooltip'}"
                          ToolTip="{Loc 'cmu-ui-options-hide-examine-tooltip-tooltip'}" />
                <CheckBox Name="ExamineWoundsInChatCheckBox" Text="{Loc 'cmu-ui-options-examine-wounds-in-chat'}" />

                <Label Text="{Loc 'cmu-ui-options-screen-shake'}" Margin="0 10 0 0" StyleClasses="LabelKeyText" />
                <CheckBox Name="ExplosionScreenShakeEnabledCheckBox" Text="{Loc 'ui-options-explosion-screen-shake-enabled'}" />
                <CheckBox Name="ExplosionScreenShakeIgnoreFarCheckBox" Text="{Loc 'ui-options-explosion-screen-shake-ignore-far'}" />
                <CheckBox Name="FirearmScreenShakeEnabledCheckBox" Text="{Loc 'ui-options-firearm-screen-shake-enabled'}" />

                <Label Text="{Loc 'cmu-ui-options-sound'}" Margin="0 10 0 0" StyleClasses="LabelKeyText" />
                <CheckBox Name="MuteScriptedSoundsCheckBox" Text="{Loc 'ui-options-mute-scripted-sounds'}" />
                <CheckBox Name="AreaEchoCheckBox" Text="{Loc 'ui-options-area-echo-enabled'}" />
                <CheckBox Name="AreaEchoHighResolutionCheckBox" Text="{Loc 'ui-options-area-echo-highres'}" />

                <Label Text="{Loc 'cmu-ui-options-visuals'}" Margin="0 10 0 0" StyleClasses="LabelKeyText" />
                <CheckBox Name="HideCassetteMusicNotesCheckBox"
                          Text="{Loc 'cmu-ui-options-hide-cassette-music-notes'}"
                          ToolTip="{Loc 'cmu-ui-options-hide-cassette-music-notes-tooltip'}" />
                <ui:OptionSlider Name="ZLevelBlurSlider" Title="{Loc 'ui-options-zlevel-blur'}" />
                <ui:OptionSlider Name="FaintLookUpOpacitySlider" Title="{Loc 'ui-options-faint-look-up-opacity'}" />

                <Label Text="{Loc 'cmu-ui-options-privacy'}" Margin="0 10 0 0" StyleClasses="LabelKeyText" />
                <CheckBox Name="HideRoundEndUsernameCheckBox"
                          Text="{Loc 'cmu-ui-options-hide-round-end-username'}"
                          ToolTip="{Loc 'cmu-ui-options-hide-round-end-username-tooltip'}" />
                <!-- cmu edit end -->
            </BoxContainer>
        </ScrollContainer>
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</tabs:CmuTab>
