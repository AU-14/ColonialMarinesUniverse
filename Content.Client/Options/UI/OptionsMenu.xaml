<DefaultWindow xmlns="https://spacestation14.io"
            xmlns:tabs="clr-namespace:Content.Client.Options.UI.Tabs"
            xmlns:cmutabs="clr-namespace:Content.Client.CMU14.UserInterface.Options.Tabs"
            xmlns:cmu="clr-namespace:Content.Client.CMU14.Interface"
            Title="{Loc 'ui-options-title'}"
            MinSize="800 450"
            SetSize="860 640">
    <!-- CrtContent holds everything the shader re-draws; CrtOverlay is its sibling and draws after it, so
         the shaded copy covers the original. -->
    <Control>
        <Control Name="CrtContent" HorizontalExpand="True" VerticalExpand="True">
            <!-- CrtPanelFill, not CrtPanel: a plain ground with no border and no inset, so this is still
                 not a third concentric rectangle. -->
            <PanelContainer StyleClasses="CrtPanelFill" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="0">
            <!-- Above the tabs rather than inside one, because it searches all of them at once and hides
                 the tabs with nothing to show - see CmuOptionsFilter. -->
            <PanelContainer Name="FilterBar" HorizontalExpand="True">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="10">
                    <LineEdit Name="FilterBox"
                              HorizontalExpand="True"
                              PlaceHolder="{Loc 'cmu-ui-options-filter-placeholder'}" />
                    <Label Name="FilterCount" VerticalAlignment="Center" />
                </BoxContainer>
            </PanelContainer>
            <TabContainer Name="Tabs" Access="Public" StyleClasses="CrtTabContainer" VerticalExpand="True" HorizontalExpand="True">
                <!-- Tabs are named for the subject a player is looking for. -->
                <cmutabs:GameplayTab Name="GameplayTab" />
                <cmutabs:InterfaceTab Name="InterfaceTab" />
                <cmutabs:ChatTab Name="ChatTab" />
                <tabs:AudioTab Name="AudioTab" />
                <tabs:GraphicsTab Name="GraphicsTab" />
                <tabs:AccessibilityTab Name="AccessibilityTab" />
                <tabs:KeyRebindTab Name="KeyRebindTab" />
                <tabs:AdminOptionsTab Name="AdminOptionsTab" />
            </TabContainer>
            </BoxContainer>
            </PanelContainer>
        </Control>
        <cmu:CrtScreenControl Name="CrtOverlay" HorizontalExpand="True" VerticalExpand="True" />
    </Control>
</DefaultWindow>
