<controls:ObjectiveEntryControl
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client._CMU14.Round.Objectives"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Margin="0 0 0 6">
    <PanelContainer Name="Background">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#1B1B1B" BorderColor="#3A3A3A" BorderThickness="1" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" Margin="8 6" SeparationOverride="4">
            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <PanelContainer Name="TypeBadgeBack" VerticalAlignment="Top">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat />
                    </PanelContainer.PanelOverride>
                    <Label Name="TypeBadgeLabel" Margin="6 1 6 1" />
                </PanelContainer>
                <RichTextLabel Name="DescriptionLabel" HorizontalExpand="True" VerticalAlignment="Top" />
                <PanelContainer Name="StatusBadgeBack" VerticalAlignment="Top">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat />
                    </PanelContainer.PanelOverride>
                    <Label Name="StatusBadgeLabel" Margin="6 1 6 1" />
                </PanelContainer>
            </BoxContainer>
            <BoxContainer Name="DetailsRow" Orientation="Horizontal" SeparationOverride="6">
                <Label Name="DetailsLabel" HorizontalExpand="True" FontColorOverride="#AAAAAA" VerticalAlignment="Center" />
                <Button Name="IntelButton" Text="Intel" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</controls:ObjectiveEntryControl>
