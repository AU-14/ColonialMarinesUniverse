<controls:TelephoneWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Telephone"
    Title="Telephone" MinSize="600 400">
    <!-- CMU14: keep the phone tabs within the window so their lists can scroll. -->
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <TabContainer Name="Tabs" Access="Public" HorizontalExpand="True" VerticalExpand="True" />
        <BoxContainer Name="Buttons" Access="Public" Orientation="Vertical" />
    </BoxContainer>
</controls:TelephoneWindow>
