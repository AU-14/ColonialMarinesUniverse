<controls:RequisitionsTacticalLayout xmlns="https://spacestation14.io" xmlns:controls="clr-namespace:Content.Client._RMC14.Requisitions" xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls">
  <PanelContainer Name="RootPanel" HorizontalExpand="True" VerticalExpand="True">
    <BoxContainer Orientation="Horizontal" Margin="10" SeparationOverride="8">
      <PanelContainer Name="FilterPanel" SetWidth="205"><BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="5">
        <Label Text="REQUISITION SECTORS"/><ScrollContainer HScrollEnabled="False" VScrollEnabled="True" VerticalExpand="True"><BoxContainer Name="CategoriesContainer" Orientation="Vertical" SeparationOverride="3"/></ScrollContainer>
      </BoxContainer></PanelContainer>
      <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8">
        <PanelContainer Name="CatalogPanel" VerticalExpand="True"><BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="5">
          <BoxContainer Orientation="Horizontal"><Label Text="TACTICAL STOCK LEDGER"/><LineEdit Name="SearchBar" PlaceHolder="FILTER LEDGER..." HorizontalExpand="True"/><Label Name="ResultCountLabel"/></BoxContainer>
          <PanelContainer Name="PackingHintPanel"><Label Name="PackingHintLabel" Margin="8 4"/></PanelContainer>
          <ScrollContainer HScrollEnabled="False" VScrollEnabled="True" VerticalExpand="True"><BoxContainer Name="ItemsContainer" Orientation="Vertical" SeparationOverride="3"/></ScrollContainer>
        </BoxContainer></PanelContainer>
        <PanelContainer Name="CartPanel" SetHeight="300"><BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="5">
          <BoxContainer Orientation="Horizontal"><Label Text="LOADOUT RAIL" HorizontalExpand="True"/><Label Name="CartStateLabel"/><Label Name="CartEmptyLabel" Text="NO LOADOUT ASSIGNED"/></BoxContainer>
          <ScrollContainer HScrollEnabled="True" VScrollEnabled="False" VerticalExpand="True"><BoxContainer Name="CartContainer" Orientation="Horizontal" SeparationOverride="6"/></ScrollContainer>
          <PanelContainer Name="CheckoutStagePanel" Visible="False"><BoxContainer Orientation="Vertical" Margin="6"><Label Name="CheckoutPhaseLabel" Align="Center"/><ProgressBar Name="CheckoutProgress" MinValue="0" MaxValue="1"/></BoxContainer></PanelContainer>
          <PanelContainer Name="ReceiptPanel" Visible="False"><BoxContainer Orientation="Horizontal" Margin="8"><Label Text="LOADOUT CLEARED //"/><Label Name="ReceiptLabel" HorizontalExpand="True"/><Button Name="ReceiptDismissButton" Text="CLEAR"/></BoxContainer></PanelContainer>
        </BoxContainer></PanelContainer>
      </BoxContainer>
      <PanelContainer Name="StatusPanel" SetWidth="255"><BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="8">
        <Label Text="TACTICAL CONTROL"/><Label Name="StyleSubtitleLabel"/><Button Name="StyleButton"/><cc:HSeparator/>
        <Label Name="BudgetLabel"/><Label Name="ProjectedBudgetLabel"/><Label Name="PlatformLabel"/><Button Name="PlatformButton"/><cc:HSeparator/>
        <PanelContainer Name="CartSummaryPanel"><BoxContainer Orientation="Vertical" Margin="8"><Label Name="CartCostLabel"/><Label Name="CartWeightLabel"/><Label Name="CartCratesLabel"/><Label Name="CartCapacityLabel"/></BoxContainer></PanelContainer>
        <Control VerticalExpand="True"/><Label Name="FeedbackLabel"/><Button Name="CheckoutButton" Text="COMMIT LOADOUT" MinHeight="48"/><Button Name="ItemsTabButton" Text="ITEM LEDGER"/><Button Name="BundlesTabButton" Text="LEGACY LOADOUTS"/>
      </BoxContainer></PanelContainer>
    </BoxContainer>
  </PanelContainer>
</controls:RequisitionsTacticalLayout>
