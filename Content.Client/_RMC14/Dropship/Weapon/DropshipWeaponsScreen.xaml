<controls:DropshipWeaponsScreen
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Dropship.Weapon"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:viewport="clr-namespace:Content.Client.Viewport"
    xmlns:firemission="clr-namespace:Content.Client._RMC14.Dropship.Weapon.FireMission">
    <PanelContainer Margin="6" StyleClasses="CrtInsetPanel" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <controls:DropshipWeaponsButtonRow Name="TopRow" Access="Public"
                                               Orientation="Horizontal" />
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
                <controls:DropshipWeaponsButtonRow Name="LeftRow" Access="Public"
                                                   Orientation="Vertical" />
                <PanelContainer MinSize="500 500" StyleClasses="CrtPanel"
                                HorizontalExpand="True" VerticalExpand="True">
                    <viewport:ScalingViewport Name="Viewport" Access="Public" Visible="False"
                                              HorizontalExpand="True" VerticalExpand="True" />
                    <firemission:DropshipFireMissionCreateScreen Name="FireMissionCreate" Access="Public" Visible="False"
                                                                 HorizontalExpand="True" VerticalExpand="True" />
                    <firemission:DropshipFireMissionEditScreen Name="FireMissionEdit" Access="Public" Visible="False"
                                                               HorizontalExpand="True" VerticalExpand="True" />
                    <firemission:DropshipFireMissionViewScreen Name="FireMissionView" Access="Public" Visible="True"
                                                               HorizontalExpand="True" VerticalExpand="True" />
                    <Label Name="ScreenLabel" Access="Public"
                           HorizontalExpand="True" VerticalExpand="True"
                           Align="Center" VAlign="Center" StyleClasses="CrtText" />
                </PanelContainer>
                <controls:DropshipWeaponsButtonRow Name="RightRow" Access="Public"
                                                   Orientation="Vertical" />
            </BoxContainer>
        <controls:DropshipWeaponsButtonRow Name="BottomRow" Access="Public"
                                           Orientation="Horizontal" />
            <BoxContainer Orientation="Horizontal">
                <Button Name="LaserPatternButton" Access="Public" Visible="False" />
                <Button Name="AirburstHeightButton" Access="Public" Visible="False" />
            </BoxContainer>
            <Label Name="PayloadPreviewLabel" Access="Public" ClipText="True" StyleClasses="CrtDimText"
                   ToolTip="{Loc 'cmu-dropship-preview-help'}" />
        </BoxContainer>
    </PanelContainer>
</controls:DropshipWeaponsScreen>
