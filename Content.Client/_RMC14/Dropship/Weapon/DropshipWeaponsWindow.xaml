<controls:DropshipWeaponsWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Dropship.Weapon"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Title="{Loc 'rmc-dropship-weapons-title'}"
    MinSize="1420 700">
    <PanelContainer Name="Panel" Access="Public">
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="#040404" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Horizontal">
            <controls:DropshipWeaponsScreen Name="ScreenOne" Access="Public"
                                            HorizontalExpand="True" VerticalExpand="True" />
            <BoxContainer Orientation="Vertical" Margin="0 10">
                <Button Name="ChinGunControlButton" Access="Public" Visible="False"
                        Text="{Loc 'cmu-mohawk-gunnery-manual'}"
                        ToolTip="{Loc 'cmu-mohawk-gunnery-control-help'}" />
                <Button Name="FreeFireButton" Access="Public" Visible="False"
                        ToolTip="{Loc 'cmu-mohawk-free-fire-help'}" />
                <Label Name="ChinGunHealthLabel" Access="Public" Visible="False" />
                <Button Name="TrackTargetButton" Access="Public" Visible="False"
                        ToggleMode="True" Text="{Loc 'cmu-dropship-track-mark'}"
                        ToolTip="{Loc 'cmu-mohawk-gunnery-mark-help'}" />
                <Button Name="AcquireTargetButton" Access="Public" Visible="False"
                        Text="{Loc 'cmu-mohawk-gunnery-acquire'}"
                        ToolTip="{Loc 'cmu-mohawk-gunnery-acquire-help'}" />
                <Button Name="ConfirmTrackingButton" Access="Public" Visible="False"
                        Text="{Loc 'cmu-mohawk-gunnery-authorize'}"
                        ToolTip="{Loc 'cmu-mohawk-gunnery-authorize-help'}" />
                <Button Name="ClearTrackingButton" Access="Public" Visible="False"
                        Text="{Loc 'cmu-dropship-track-clear'}" />
                <Button Name="PriorityButton" Access="Public" Visible="False" />
                <Button Name="FeedModeButton" Access="Public" Visible="False" />
                <Button Name="FeedOneButton" Access="Public" Visible="False" />
                <Button Name="FeedTwoButton" Access="Public" Visible="False" />
                <Label Name="FeedStatusLabel" Access="Public" Visible="False" MaxWidth="225" ClipText="True" />
                <Button Name="ClearFlareButton" Access="Public" Visible="False"
                        Text="{Loc 'cmu-mohawk-gunnery-clear-flare'}" />
                <Label Name="TrackingStatusLabel" Access="Public" MaxWidth="225" />
                <Label Name="ChinGunHelpLabel" Access="Public" Visible="False"
                       Text="{Loc 'cmu-mohawk-gunnery-short-help'}" />
                <BoxContainer Orientation="Horizontal">
                    <Control HorizontalExpand="True" />
                    <Button Name="OffsetUpButton" Access="Public" StyleClasses="OpenBoth"
                            SetSize="28 29" />
                    <Control HorizontalExpand="True" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal">
                    <Button Name="OffsetLeftButton" Access="Public" StyleClasses="OpenBoth"
                            HorizontalExpand="True" />
                    <Button Name="ResetOffsetButton" Access="Public"
                            StyleClasses="OpenBoth" HorizontalExpand="True" MinWidth="28" />
                    <Button Name="OffsetRightButton" Access="Public" StyleClasses="OpenBoth"
                            HorizontalExpand="True" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal">
                    <Control HorizontalExpand="True" />
                    <Button Name="OffsetDownButton" Access="Public" StyleClasses="OpenBoth"
                            SetSize="28 29" />
                    <Control HorizontalExpand="True" />
                </BoxContainer>
                <PanelContainer Margin="0 10 0 0" MouseFilter="Pass"
                                ToolTip="{Loc 'rmc-dropship-weapons-offset-calibration-does-not-affect-direct-bombardment'}">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BackgroundColor="#606060" BorderColor="#FFFFFF"
                                               BorderThickness="1" />
                    </PanelContainer.PanelOverride>
                    <Label Align="Center" Text="{Loc 'rmc-dropship-weapons-offset-calibration'}" />
                </PanelContainer>
            </BoxContainer>
            <controls:DropshipWeaponsScreen Name="ScreenTwo" Access="Public"
                                            HorizontalExpand="True" VerticalExpand="True" />
        </BoxContainer>
    </PanelContainer>
</controls:DropshipWeaponsWindow>
