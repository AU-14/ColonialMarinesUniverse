<controls:DropshipWeaponsWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Dropship.Weapon"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Title="{Loc 'rmc-dropship-weapons-title'}"
    MinSize="1420 700">
    <PanelContainer Name="Panel" Access="Public" StyleClasses="CrtPanel" Margin="4">
      <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <PanelContainer StyleClasses="CrtHeaderPanel" Margin="0 0 0 6">
            <Label StyleClasses="CrtHeading" Text="{Loc 'rmc-dropship-weapons-title'}" Margin="8 4" />
        </PanelContainer>
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
            <controls:DropshipWeaponsScreen Name="ScreenOne" Access="Public"
                                            HorizontalExpand="True" VerticalExpand="True" />
            <PanelContainer StyleClasses="CrtInsetPanel" Margin="0 6" MinWidth="260" MaxWidth="280" VerticalExpand="True">
              <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
               <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="4">
                <Label StyleClasses="CrtHeading" Text="{Loc 'cmu-mohawk-gunnery-panel-title'}" />
                <Button Name="ChinGunControlButton" Access="Public" Visible="False"
                        Text="{Loc 'cmu-mohawk-gunnery-manual'}"
                        ToolTip="{Loc 'cmu-mohawk-gunnery-control-help'}" />
                <Button Name="ArButton" Access="Public" Visible="False" Text="{Loc 'cmu-mohawk-gunnery-ar'}" />
                <Button Name="FreeFireButton" Access="Public" Visible="False"
                        ToolTip="{Loc 'cmu-mohawk-free-fire-help'}" />
                <Label Name="ChinGunHealthLabel" Access="Public" Visible="False" />
                <Label Name="HeatLabel" Access="Public" Visible="False" MaxWidth="260" ClipText="True" />
                <ProgressBar Name="HeatBar" Access="Public" Visible="False" MinValue="0" MaxValue="100"
                             MinHeight="8" HorizontalExpand="True" />
                <Label Name="LowAmmoLabel" Access="Public" Visible="False" MaxWidth="260" ClipText="True"
                       FontColorOverride="#FF8C00" />
                <Label Name="BootStatusLabel" Access="Public" MaxWidth="260" ClipText="True" />
                <Button Name="IffButton" Access="Public" Visible="False" />
                <Button Name="VisionButton" Access="Public" Visible="False"
                        ToolTip="{Loc 'cmu-mohawk-vision-help'}" />
                <Label Name="SharedFlareLabel" Access="Public" MaxWidth="260" ClipText="True" />
                <Label Name="AiTargetLabel" Access="Public" Visible="False" MaxWidth="260" ClipText="True" />
                <Button Name="ApproveAiButton" Access="Public" Visible="False" />
                <Button Name="TrackTargetButton" Access="Public" Visible="False"
                        ToggleMode="True" Text="{Loc 'cmu-mohawk-gunnery-mark'}"
                        ToolTip="{Loc 'cmu-mohawk-gunnery-mark-help'}" />
                <Button Name="AcquireTargetButton" Access="Public" Visible="False"
                        Text="{Loc 'cmu-mohawk-gunnery-acquire'}"
                        ToolTip="{Loc 'cmu-mohawk-gunnery-acquire-help'}" />
                <Button Name="ConfirmTrackingButton" Access="Public" Visible="False"
                        Text="{Loc 'cmu-mohawk-gunnery-authorize'}"
                        ToolTip="{Loc 'cmu-mohawk-gunnery-authorize-help'}" />
                <Button Name="ClearTrackingButton" Access="Public" Visible="False"
                        Text="{Loc 'cmu-dropship-track-clear'}" />
                <Button Name="PriorityButton" Access="Public" Visible="False" />
                <Button Name="FeedModeButton" Access="Public" Visible="False" />
                <Button Name="FeedOneButton" Access="Public" Visible="False" />
                <Button Name="FeedTwoButton" Access="Public" Visible="False" />
                <Button Name="FeedThreeButton" Access="Public" Visible="False"
                        ToolTip="{Loc 'cmu-mohawk-gunnery-feed-three-help'}" />
                <Label Name="FeedStatusLabel" Access="Public" Visible="False" MaxWidth="260" ClipText="True" />
                <Button Name="ClearFlareButton" Access="Public" Visible="False"
                        Text="{Loc 'cmu-mohawk-gunnery-clear-flare'}" />
                <Label Name="TrackingStatusLabel" Access="Public" MaxWidth="260" ClipText="True" />
                <Label Name="ChinGunHelpLabel" Access="Public" Visible="False"
                       Text="{Loc 'cmu-mohawk-gunnery-short-help'}" />
                <BoxContainer Orientation="Horizontal">
                    <Control HorizontalExpand="True" />
                    <Button Name="OffsetUpButton" Access="Public" StyleClasses="OpenBoth"
                            SetSize="28 29" />
                    <Control HorizontalExpand="True" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal">
                    <Button Name="OffsetLeftButton" Access="Public" StyleClasses="OpenBoth"
                            HorizontalExpand="True" />
                    <Button Name="ResetOffsetButton" Access="Public"
                            StyleClasses="OpenBoth" HorizontalExpand="True" MinWidth="28" />
                    <Button Name="OffsetRightButton" Access="Public" StyleClasses="OpenBoth"
                            HorizontalExpand="True" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal">
                    <Control HorizontalExpand="True" />
                    <Button Name="OffsetDownButton" Access="Public" StyleClasses="OpenBoth"
                            SetSize="28 29" />
                    <Control HorizontalExpand="True" />
                </BoxContainer>
                <PanelContainer Margin="0 10 0 0" MouseFilter="Pass" StyleClasses="CrtQuietPanel"
                                ToolTip="{Loc 'rmc-dropship-weapons-offset-calibration-does-not-affect-direct-bombardment'}">
                    <Label Align="Center" Text="{Loc 'rmc-dropship-weapons-offset-calibration'}" />
                </PanelContainer>
                <PanelContainer Margin="0 10 0 0" StyleClasses="CrtQuietPanel">
                    <BoxContainer Orientation="Vertical" Margin="4">
                        <Label Text="{Loc 'cmu-cas-requests-title'}" />
                        <BoxContainer Name="CasRequestsBox" Access="Public" Orientation="Vertical"
                                      SeparationOverride="4" />
                    </BoxContainer>
                </PanelContainer>
                <PanelContainer Margin="0 10 0 0" StyleClasses="CrtQuietPanel">
                    <BoxContainer Orientation="Vertical" Margin="4">
                        <Label Text="{Loc 'cmu-dropship-loadout-title'}" />
                        <Label Name="LoadoutLabel" Access="Public" MaxWidth="260" />
                    </BoxContainer>
                </PanelContainer>
                <PanelContainer Margin="0 10 0 0" StyleClasses="CrtQuietPanel">
                    <BoxContainer Orientation="Vertical" Margin="4">
                        <Label Text="{Loc 'cmu-dropship-preflight-title'}" />
                        <Label Name="PreflightLabel" Access="Public" MaxWidth="260" />
                    </BoxContainer>
                </PanelContainer>
               </BoxContainer>
              </ScrollContainer>
            </PanelContainer>
            <controls:DropshipWeaponsScreen Name="ScreenTwo" Access="Public"
                                            HorizontalExpand="True" VerticalExpand="True" />
        </BoxContainer>
      </BoxContainer>
    </PanelContainer>
</controls:DropshipWeaponsWindow>
