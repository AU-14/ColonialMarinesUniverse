<!-- CMU14 Start: CRT-themed fabricator with weapon filter sidebar and weapon/ammo search -->
<controls:DropshipFabricatorWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Dropship.Fabricator"
    Title="{Loc 'rmc-dropship-fabricator-title'}"
    MinSize="1000 620"
    SetSize="1100 700">
    <PanelContainer StyleClasses="CrtPanel" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
            <PanelContainer StyleClasses="CrtHeaderPanel">
                <BoxContainer Orientation="Horizontal" Margin="4 2">
                    <Label Text="{Loc 'rmc-dropship-fabricator-title'}" StyleClasses="CrtHeading"
                           HorizontalExpand="True" />
                    <Label Name="PointsLabel" Access="Public" StyleClasses="CrtHeading" />
                </BoxContainer>
            </PanelContainer>
            <PanelContainer StyleClasses="CrtInsetPanel">
                <BoxContainer Orientation="Vertical" Margin="4">
                    <BoxContainer Orientation="Horizontal">
                        <RichTextLabel Name="CurrentLabel" Access="Public" Margin="4 2" HorizontalExpand="True" />
                        <RichTextLabel Name="QueueLabel" Access="Public" Margin="4 2" />
                    </BoxContainer>
                    <PanelContainer StyleClasses="CrtSectionRule" HorizontalExpand="True" MinHeight="1" />
                    <ScrollContainer HScrollEnabled="False" VScrollEnabled="True"
                                     HorizontalExpand="True" MinHeight="84" MaxHeight="84" SetHeight="84">
                        <BoxContainer Name="QueueContainer" Access="Public" Orientation="Vertical"
                                      HorizontalExpand="True" />
                    </ScrollContainer>
                </BoxContainer>
            </PanelContainer>
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True"
                          SeparationOverride="6">
                <PanelContainer StyleClasses="CrtInsetPanel" MinWidth="240" VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="4" SeparationOverride="4">
                        <Label Text="{Loc 'cmu-dropship-fabricator-filter-title'}" StyleClasses="CrtHeading" />
                        <PanelContainer StyleClasses="CrtSectionRule" HorizontalExpand="True" MinHeight="1" />
                        <ScrollContainer HScrollEnabled="False" VScrollEnabled="True" VerticalExpand="True">
                            <BoxContainer Name="FilterContainer" Access="Public" Orientation="Vertical"
                                          HorizontalExpand="True" SeparationOverride="2" />
                        </ScrollContainer>
                    </BoxContainer>
                </PanelContainer>
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True"
                              SeparationOverride="6">
                    <LineEdit Name="SearchBar" Access="Public" HorizontalExpand="True"
                              PlaceHolder="{Loc 'cmu-dropship-fabricator-search-placeholder'}" />
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True"
                                  SeparationOverride="6">
                        <PanelContainer StyleClasses="CrtInsetPanel" HorizontalExpand="True" VerticalExpand="True">
                            <BoxContainer Orientation="Vertical" Margin="4" SeparationOverride="4">
                                <Label Name="EquipmentLabel" Access="Public" StyleClasses="CrtHeading" />
                                <PanelContainer StyleClasses="CrtSectionRule" HorizontalExpand="True" MinHeight="1" />
                                <ScrollContainer HScrollEnabled="False" VScrollEnabled="True" VerticalExpand="True">
                                    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                                        <Label Name="EquipmentEmptyLabel" Access="Public" StyleClasses="CrtDimText"
                                               Text="{Loc 'cmu-dropship-fabricator-no-equipment'}"
                                               Margin="4" Visible="False" />
                                        <BoxContainer Name="EquipmentContainer" Access="Public" Orientation="Vertical"
                                                      HorizontalExpand="True" SeparationOverride="2" />
                                    </BoxContainer>
                                </ScrollContainer>
                            </BoxContainer>
                        </PanelContainer>
                        <PanelContainer StyleClasses="CrtInsetPanel" HorizontalExpand="True" VerticalExpand="True">
                            <BoxContainer Orientation="Vertical" Margin="4" SeparationOverride="4">
                                <Label Name="AmmoLabel" Access="Public" StyleClasses="CrtHeading" />
                                <PanelContainer StyleClasses="CrtSectionRule" HorizontalExpand="True" MinHeight="1" />
                                <ScrollContainer HScrollEnabled="False" VScrollEnabled="True" VerticalExpand="True">
                                    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                                        <Label Name="AmmoEmptyLabel" Access="Public" StyleClasses="CrtDimText"
                                               Text="{Loc 'cmu-dropship-fabricator-no-ammo'}"
                                               Margin="4" Visible="False" />
                                        <BoxContainer Name="AmmoContainer" Access="Public" Orientation="Vertical"
                                                      HorizontalExpand="True" SeparationOverride="2" />
                                    </BoxContainer>
                                </ScrollContainer>
                            </BoxContainer>
                        </PanelContainer>
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</controls:DropshipFabricatorWindow>
<!-- CMU14 End -->