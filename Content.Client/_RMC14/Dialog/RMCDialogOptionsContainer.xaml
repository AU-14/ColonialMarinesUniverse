<controls:RMCDialogOptionsContainer
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Dialog"
    xmlns:ui="clr-namespace:Content.Client._RMC14.UserInterface"
    Margin="8" Orientation="Vertical" SeparationOverride="6">
    <RichTextLabel Name="Message" Access="Public" Text="[bold]What do you wish to do?[/bold]" MaxWidth="480" />
    <Label Name="Countdown" Access="Public" StyleClasses="CrtHeading" Visible="False" />
    <ui:BlueHorizontalSeparator />
    <ScrollContainer Name="OptionsScroll" Access="Public" HScrollEnabled="False" VScrollEnabled="True" HorizontalExpand="True" MaxHeight="352">
        <BoxContainer Name="Options" Access="Public" Orientation="Vertical" SeparationOverride="4" />
    </ScrollContainer>
    <LineEdit Name="Search" Access="Public" PlaceHolder="Search..." />
</controls:RMCDialogOptionsContainer>
