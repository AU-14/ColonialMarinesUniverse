<!-- CMU14 Begin: an equipment row with a distinct item name, stock information and dispense action. -->
<cc:CMAutomatedVendorEntry
    xmlns="https://spacestation14.io"
    xmlns:cc="clr-namespace:Content.Client._RMC14.Vendors"
    xmlns:cmu="clr-namespace:Content.Client.CMU14.Vendors"
    HorizontalExpand="True" MinHeight="72">
    <PanelContainer Name="RowSurface" HorizontalExpand="True">
        <cmu:CMUVendorRowLayout HorizontalExpand="True">
            <Button Name="TooltipLabel" Access="Public" VerticalAlignment="Top">
                <LayeredTextureRect Name="Texture" Access="Public"
                                    HorizontalExpand="False" VerticalExpand="False"
                                    MinSize="40 40" MaxSize="40 40" Stretch="Scale" />
            </Button>
            <BoxContainer Orientation="Vertical" SeparationOverride="6" HorizontalExpand="True" VerticalAlignment="Top">
                <RichTextLabel Name="ItemTitle" HorizontalExpand="True" VerticalAlignment="Top" />
                <RichTextLabel Name="Stock" Access="Public" HorizontalExpand="True" VerticalAlignment="Top" />
                <Label Name="Availability" HorizontalExpand="True" VerticalAlignment="Top" ClipText="True" MinHeight="24" MaxHeight="24" />
            </BoxContainer>
            <cc:CMAutomatedVendorPanel Name="Panel" Access="Public"
                HorizontalExpand="False" MinWidth="104" VerticalAlignment="Center" />
        </cmu:CMUVendorRowLayout>
    </PanelContainer>
</cc:CMAutomatedVendorEntry>
<!-- CMU14 End -->
