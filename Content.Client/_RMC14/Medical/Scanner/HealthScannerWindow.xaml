<scanner:HealthScannerWindow
    xmlns="https://spacestation14.io"
    xmlns:scanner="clr-namespace:Content.Client._RMC14.Medical.Scanner"
    xmlns:cmui="clr-namespace:Content.Client.CMU14.Medical.Presentation.Windows"
    xmlns:cooldown="clr-namespace:Content.Client.Cooldown"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    MinSize="340 260"
    SetSize="480 600">
    <PanelContainer Name="ScaleRoot" Access="Public">
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="#16181B" />
        </PanelContainer.PanelOverride>

        <BoxContainer Orientation="Vertical" Margin="4" HorizontalExpand="True" VerticalExpand="True">
            <PanelContainer Name="LoadingPanel" Access="Public" Visible="False" Margin="0 0 0 4">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#1F2327" BorderColor="#4972A1" BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <BoxContainer Name="LoadingRow" Access="Public" Orientation="Horizontal" Margin="5 2">
                    <cooldown:CooldownGraphic Name="LoadingSpinner" Access="Public" SetWidth="14" SetHeight="14"
                                              Margin="0 0 5 0" VerticalAlignment="Center" />
                    <Label Text="{Loc cmu-medical-scanner-loading}" FontColorOverride="#B5C2CE"
                           VerticalAlignment="Center" />
                    <Control HorizontalExpand="True" />
                    <Label Name="LoadingSubtext" Access="Public"
                           Text="{Loc cmu-medical-scanner-loading-subtext}" FontColorOverride="#6F7B86"
                           VerticalAlignment="Center" />
                </BoxContainer>
            </PanelContainer>

            <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Orientation="Vertical">
                    <!-- summary -->
                    <PanelContainer Margin="0 0 0 4">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BackgroundColor="#1F2327" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" Margin="6 5" SeparationOverride="4">
                            <PanelContainer Name="CMUStatusBanner" Access="Public" Visible="False">
                                <PanelContainer.PanelOverride>
                                    <graphics:StyleBoxFlat BackgroundColor="#2C6E55" />
                                </PanelContainer.PanelOverride>
                                <BoxContainer Name="CMUStatusBannerRow" Access="Public" Orientation="Horizontal" Margin="5 1">
                                    <Label Name="CMUStatusBannerLabel" Access="Public" StyleClasses="CMULabelBold"
                                           FontColorOverride="White" Margin="0 0 6 0" />
                                    <Label Name="CMUStatusBannerDetail" Access="Public" FontColorOverride="#F3F6F5"
                                           ClipText="True" HorizontalExpand="True" />
                                </BoxContainer>
                            </PanelContainer>

                            <PanelContainer Name="CMURiderBanner" Access="Public" Visible="False">
                                <PanelContainer.PanelOverride>
                                    <graphics:StyleBoxFlat BackgroundColor="#A0521C" />
                                </PanelContainer.PanelOverride>
                                <Label Name="CMURiderLabel" Access="Public" StyleClasses="CMULabelBold"
                                       FontColorOverride="White" Margin="5 1" ClipText="True" />
                            </PanelContainer>
                            <!-- this should probably be made a disease like the cm13 system-->>
                            <!-- CMU14: lab Wendigo procedure progress -->
                            <PanelContainer Name="CMUWendigoBanner" Access="Public" Visible="False">
                                <PanelContainer.PanelOverride>
                                    <graphics:StyleBoxFlat BackgroundColor="#4A2340" />
                                </PanelContainer.PanelOverride>
                                <Label Name="CMUWendigoLabel" Access="Public" FontColorOverride="White" Margin="5 1"
                                       ClipText="True" />
                            </PanelContainer>

                            <BoxContainer Orientation="Horizontal">
                                <Label Text="{Loc cmu-medical-scanner-label-health}" MinWidth="70"
                                       FontColorOverride="#8E9AA6" VerticalAlignment="Center" />
                                <ProgressBar Name="HealthBar" Access="Public" HorizontalExpand="True"
                                             SetHeight="18" VerticalAlignment="Center">
                                    <Label Name="HealthBarText" Access="Public" Align="Right" Margin="0 0 4 0"
                                           VerticalAlignment="Center" />
                                </ProgressBar>
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal">
                                <Label Text="{Loc cmu-medical-scanner-label-damage}" MinWidth="70"
                                       FontColorOverride="#8E9AA6" VerticalAlignment="Center" />
                                <BoxContainer Name="DamageRow" Access="Public" Orientation="Horizontal" />
                            </BoxContainer>
                            <BoxContainer Name="PatientHeaderRow" Access="Public" Orientation="Horizontal">
                                <Label Text="{Loc cmu-medical-scanner-label-holocard}" MinWidth="70"
                                       FontColorOverride="#8E9AA6" VerticalAlignment="Center" />
                                <PanelContainer Name="HolocardPanel" Access="Public" VerticalAlignment="Center"
                                                Margin="0 0 5 0">
                                    <PanelContainer.PanelOverride>
                                        <graphics:StyleBoxFlat BackgroundColor="#984A16" />
                                    </PanelContainer.PanelOverride>
                                    <Label Name="HolocardDescription" Access="Public" StyleClasses="CMULabelBold"
                                           Align="Center" Margin="5 1" />
                                </PanelContainer>
                                <Button Name="ChangeHolocardButton" Access="Public" StyleClasses="OpenBoth"
                                        VerticalAlignment="Center" />
                            </BoxContainer>
                        </BoxContainer>
                    </PanelContainer>

                    <!-- limbs -->
                    <PanelContainer Name="CMUBodyMapSection" Access="Public" Visible="False" Margin="0 0 0 4">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BackgroundColor="#1F2327" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" Margin="0 4 0 5">
                            <Label Text="{Loc cmu-medical-scanner-section-limbs-damaged}" StyleClasses="LabelKeyText"
                                   Margin="6 0" />
                            <PanelContainer MinHeight="2" Margin="0 3 0 4">
                                <PanelContainer.PanelOverride>
                                    <graphics:StyleBoxFlat BackgroundColor="#4972A1" />
                                </PanelContainer.PanelOverride>
                            </PanelContainer>
                            <BoxContainer Orientation="Horizontal" Margin="9 0 9 2">
                                <Control MinWidth="80" />
                                <Label Text="{Loc rmc-health-analyzer-brute}" MinWidth="40" StyleClasses="CMULabelBold"
                                       FontColorOverride="#DF3E3E" />
                                <Label Text="{Loc rmc-health-analyzer-burn}" MinWidth="40" StyleClasses="CMULabelBold"
                                       FontColorOverride="#FFB833" />
                                <Control HorizontalExpand="True" />
                                <Label Text="{Loc cm-wounds-brackets-translators-note}" />
                            </BoxContainer>
                            <BoxContainer Name="CMUBodyChartContainer" Access="Public" Orientation="Vertical"
                                          Margin="6 0" />
                        </BoxContainer>
                    </PanelContainer>

                    <!-- chemicals -->
                    <PanelContainer Name="ChemicalContentsCard" Access="Public" Visible="False" Margin="0 0 0 4">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BackgroundColor="#1F2327" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" Margin="0 4 0 5">
                            <Label Name="ChemicalContentsLabel" Access="Public" Margin="6 0"
                                   Text="{Loc cmu-medical-scanner-section-chemicals}" StyleClasses="LabelKeyText" />
                            <PanelContainer Name="ChemicalContentsSeparator" Access="Public" MinHeight="2" Margin="0 3 0 4">
                                <PanelContainer.PanelOverride>
                                    <graphics:StyleBoxFlat BackgroundColor="#4972A1" />
                                </PanelContainer.PanelOverride>
                            </PanelContainer>
                            <PanelContainer Name="UnknownChemicalsPanel" Access="Public" Visible="False" Margin="6 0 6 3">
                                <PanelContainer.PanelOverride>
                                    <graphics:StyleBoxFlat BackgroundColor="#7B4A25" />
                                </PanelContainer.PanelOverride>
                                <cmui:CMUScaledRichTextLabel Name="UnknownReagentsLabel" Access="Public" Margin="4 1" />
                            </PanelContainer>
                            <BoxContainer Name="ChemicalsContainer" Access="Public" Orientation="Vertical"
                                          Margin="8 0" SeparationOverride="2" />
                        </BoxContainer>
                    </PanelContainer>

                    <!-- vitals -->
                    <PanelContainer Margin="0 0 0 4">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BackgroundColor="#1F2327" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" Margin="8 5" SeparationOverride="2">
                            <BoxContainer Orientation="Horizontal">
                                <Label Name="BloodTypeLabel" Access="Public" MinWidth="130" FontColorOverride="#8E9AA6" />
                                <Label Name="BloodAmountLabel" Access="Public" />
                                <Label Name="SalineLabel" Access="Public" Margin="4 0 0 0" />
                                <Label Name="Bleeding" Access="Public" Margin="6 0 0 0" FontColorOverride="#DF3E3E"
                                       StyleClasses="CMULabelBold" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal">
                                <Label Text="{Loc cmu-medical-scanner-label-temperature}" MinWidth="130"
                                       FontColorOverride="#8E9AA6" />
                                <Label Name="BodyTemperatureLabel" Access="Public" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal">
                                <Label Text="{Loc cmu-medical-scanner-label-pulse}" MinWidth="130"
                                       FontColorOverride="#8E9AA6" />
                                <Label Name="PulseLabel" Access="Public" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal">
                                <Label Text="{Loc cmu-medical-scanner-label-shock-risk}" MinWidth="130"
                                       FontColorOverride="#8E9AA6" />
                                <Label Name="ShockRiskLabel" Access="Public" />
                            </BoxContainer>
                        </BoxContainer>
                    </PanelContainer>

                    <!-- advice -->
                    <PanelContainer Name="MedicalAdviceCard" Access="Public" Visible="False" Margin="0 0 0 4">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BackgroundColor="#1F2327" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" Margin="0 4 0 5">
                            <Label Name="MedicalAdviceLabel" Access="Public" Margin="6 0"
                                   Text="{Loc cmu-medical-scanner-section-advice}" StyleClasses="LabelKeyText" />
                            <PanelContainer Name="MedicalAdviceSeparator" Access="Public" MinHeight="2" Margin="0 3 0 4">
                                <PanelContainer.PanelOverride>
                                    <graphics:StyleBoxFlat BackgroundColor="#4972A1" />
                                </PanelContainer.PanelOverride>
                            </PanelContainer>
                            <BoxContainer Name="AdviceContainer" Access="Public" Orientation="Vertical"
                                          Margin="8 0" SeparationOverride="2" />
                        </BoxContainer>
                    </PanelContainer>

                    <!-- organs-->
                    <PanelContainer Name="CMUOrgansCard" Access="Public" Visible="False">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BackgroundColor="#1F2327" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" Margin="0 4 0 5">
                            <Label Text="{Loc cmu-medical-scanner-section-organs-damaged}" StyleClasses="LabelKeyText"
                                   Margin="6 0" />
                            <PanelContainer MinHeight="2" Margin="0 3 0 4">
                                <PanelContainer.PanelOverride>
                                    <graphics:StyleBoxFlat BackgroundColor="#4972A1" />
                                </PanelContainer.PanelOverride>
                            </PanelContainer>
                            <BoxContainer Name="CMUOrgansContainer" Access="Public" Orientation="Vertical"
                                          Margin="8 0" SeparationOverride="2" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </ScrollContainer>
        </BoxContainer>
    </PanelContainer>
</scanner:HealthScannerWindow>
