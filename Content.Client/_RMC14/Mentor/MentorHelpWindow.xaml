<!-- Same simplification as BwoinkPanel.xaml (AHelp), no shared code between them: CrtScreenPanel
     instead of a bordered CrtPanel wrapping two more bordered panels (CrtQuietPanel around the
     messages, CrtHeaderPanel around the input) - the messages sit straight on the screen's own
     ground with nothing framing them, and the input reuses AHelp's CrtBwoinkInput band. -->
<controls:MentorHelpWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Mentor"
    SetSize="600 360"
    Title="Mentor Help">
    <PanelContainer StyleClasses="CrtScreenPanel" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
            <OutputPanel Name="Messages" Access="Public" HorizontalExpand="True"
                         VerticalExpand="True" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="5">
                <PanelContainer StyleClasses="CrtBwoinkInput" HorizontalExpand="True">
                    <LineEdit Name="Chat"
                              Access="Public"
                              PlaceHolder="Type mentor help message..."
                              HorizontalExpand="True"
                              MinHeight="34"
                              SetHeight="34" />
                </PanelContainer>
                <Button Name="ReMentorButton" Access="Public" Text="Re-mentor" Visible="False" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</controls:MentorHelpWindow>
