<controls:RMCCentrifugeWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Chemistry.Centrifuge"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:ui="clr-namespace:Content.Client.CMU14.UI"
    Title="Chemical Centrifuge" MinSize="320 300">
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="#252832" />
        </PanelContainer.PanelOverride>
        <TextureRect TexturePath="/Textures/CMU14/Interface/Backgrounds/bg-weyland.png"
                     Stretch="KeepAspectCovered" CanShrink="True" MouseFilter="Ignore" />
        <BoxContainer Orientation="Vertical" Margin="4">
            <PanelContainer Margin="0 0 0 4">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#00000054" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical">
                    <Label Text="Centrifuge Controls" StyleClasses="LabelKeyText" FontColorOverride="#FFFFFF" Margin="6 3" />
                    <PanelContainer MinHeight="2">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BackgroundColor="#000000" />
                        </PanelContainer.PanelOverride>
                    </PanelContainer>
                    <BoxContainer Orientation="Vertical" Margin="6 4 6 5" SeparationOverride="1">
                        <BoxContainer Orientation="Horizontal">
                            <Label Text="Label:" MinWidth="60" FontColorOverride="#7D8EA6" VerticalAlignment="Center" />
                            <LineEdit Name="LabelEdit" Access="Public" PlaceHolder="No label" HorizontalExpand="True" />
                        </BoxContainer>
                        <ui:CMUMachineButton Name="ModeButton" Access="Public" HorizontalExpand="True" Margin="0 2 0 0" />
                        <ui:CMUMachineButton Name="SourceButton" Access="Public" HorizontalExpand="True" />
                        <ui:CMUMachineButton Name="ConnectButton" Access="Public" HorizontalExpand="True" />
                        <PanelContainer Name="ConnectionPanel" Access="Public" Margin="0 2 0 0">
                            <Label Name="ConnectionLabel" Access="Public" Margin="5 1" />
                        </PanelContainer>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>

            <PanelContainer>
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#00000054" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical">
                    <Label Text="Containers" StyleClasses="LabelKeyText" FontColorOverride="#FFFFFF" Margin="6 3" />
                    <PanelContainer MinHeight="2">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BackgroundColor="#000000" />
                        </PanelContainer.PanelOverride>
                    </PanelContainer>
                    <BoxContainer Orientation="Vertical" Margin="6 4 6 5" SeparationOverride="1">
                        <BoxContainer Orientation="Horizontal">
                            <Label Text="Input:" MinWidth="60" FontColorOverride="#7D8EA6" VerticalAlignment="Center" />
                            <Label Name="InputStatusLabel" Access="Public" HorizontalExpand="True" VerticalAlignment="Center" />
                            <ui:CMUMachineButton Name="EjectInputButton" Access="Public" Text="Eject" />
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal">
                            <Label Text="Output:" MinWidth="60" FontColorOverride="#7D8EA6" VerticalAlignment="Center" />
                            <Label Name="OutputStatusLabel" Access="Public" HorizontalExpand="True" VerticalAlignment="Center" />
                            <ui:CMUMachineButton Name="EjectOutputButton" Access="Public" Text="Eject" />
                        </BoxContainer>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
    </PanelContainer>
</controls:RMCCentrifugeWindow>
