                            </ScrollContainer>
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal" VerticalExpand="True" SeparationOverride="6">
                            <PanelContainer StyleClasses="CrtInsetPanel" MinWidth="330" Margin="3 3 0 3">
                                <ScrollContainer VerticalExpand="True">
                                    <BoxContainer Name="DistressThreatPreferenceList" Orientation="Vertical" />
                                </ScrollContainer>
                            </PanelContainer>
                            <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                                <BoxContainer Name="DistressThreatJobList" Orientation="Vertical" />
                            </ScrollContainer>
                        </BoxContainer>
                        <BoxContainer Orientation="Vertical" Margin="10">
                            <ScrollContainer VerticalExpand="True">
                                <BoxContainer Name="DistressAntagList" Orientation="Vertical" />
                            </ScrollContainer>
                        </BoxContainer>
                    </TabContainer>
                </BoxContainer>
                <BoxContainer Orientation="Vertical" Margin="10">
                    <!-- CMU14: separate FoF priorities and explicit side/role fallbacks. -->
                    <Label Text="{Loc 'cmu-fof-balancing'}" />
                    <BoxContainer Orientation="Horizontal" Margin="0 5">
                        <Label Text="{Loc 'cmu-fof-preferred-side'}" />
                        <OptionButton Name="FoFSideButton" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" Margin="0 5">
                        <Label Text="{Loc 'cmu-fof-fallback-label'}" />
                        <OptionButton Name="FoFFallbackButton" />
                    </BoxContainer>
                    <Label Text="{Loc 'cmu-fof-fallback-explanation'}" />
                    <TabContainer Name="ForceOnForceTabs" VerticalExpand="True" StyleClasses="CrtTabContainer">
                        <ScrollContainer VerticalExpand="True">
                            <!-- CMU14: faction gameplay options. -->
                            <BoxContainer Name="FoFJobList" Orientation="Vertical" />
                        </ScrollContainer>
                    </TabContainer>
                </BoxContainer>
                <BoxContainer Name="NamedItemsTab" Orientation="Vertical" Margin="10">
                    <!-- Named Items -->
                    <namedItems:NamedItemsPicker Name="NamedItems" />
                </BoxContainer>
            </TabContainer>
        </BoxContainer>
        <!-- Right side -->
        <BoxContainer Orientation="Vertical"
                      VerticalExpand="True"
                      VerticalAlignment="Center"
                      MinWidth="300"
                      MaxWidth="300">
            <profile:ProfilePreviewSpriteView Name="SpriteView" Scale="8 8" Margin="4" SizeFlagsStretchRatio="1" />
            <Label Name="PreviewJobLabel"
                   HorizontalAlignment="Center"
                   ClipText="True"
                   MinWidth="286"
                   MaxWidth="286"
                   StyleClasses="CrtHeading"
                   Visible="False" />
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 5">
                <Button Name="SpriteRotateLeft" Text="&lt;" StyleClasses="OpenRight" />
                <cc:VSeparator Margin="2 0 3 0" />
                <Button Name="SpriteRotateRight" Text="&gt;" StyleClasses="OpenLeft" />
            </BoxContainer>
        </BoxContainer>
</BoxContainer>
