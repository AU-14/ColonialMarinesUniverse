                                                    VerticalAlignment="Center"
                                                    ToolTip="{Loc 'cmu-humanoid-profile-editor-foxtrot-squad-tooltip'}" />
                                        </BoxContainer>
                                        <BoxContainer Orientation="Vertical" SeparationOverride="1">
                                            <Label Text="{Loc 'cmu-humanoid-profile-editor-foxtrot-squad-point-roles'}" StyleClasses="CrtDimText" />
                                            <Label Text="{Loc 'cmu-humanoid-profile-editor-foxtrot-squad-point-full'}" StyleClasses="CrtDimText" />
                                        </BoxContainer>
                                    </BoxContainer>
                                </PanelContainer>
                                <!-- cmu edit end -->
