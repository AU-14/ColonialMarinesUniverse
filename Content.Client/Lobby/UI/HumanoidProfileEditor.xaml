                                <Label Text="{Loc 'humanoid-profile-editor-skin-color-label'}" />
                                <Slider MinWidth="460" MaxWidth="460" HorizontalAlignment="Left" Name="Skin" MinValue="0" MaxValue="100" Value="20" />
