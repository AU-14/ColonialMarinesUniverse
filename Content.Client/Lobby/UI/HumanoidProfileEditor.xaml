                                    <Label Text="{Loc 'humanoid-profile-editor-skin-tone-label'}" ToolTip="{Loc 'humanoid-profile-editor-skin-tone-tooltip'}" />
                                    <Label MinWidth="240" VAlign="Center" Text="{Loc 'humanoid-profile-editor-skin-tone-label'}" ToolTip="{Loc 'humanoid-profile-editor-skin-tone-tooltip'}" />
                                    <Label Name="SkinToneNameLabel" VAlign="Center" HorizontalAlignment="Right" StyleClasses="LabelSubText" />
                                </BoxContainer>
                                <Slider Name="CharacterSkinSlider" HorizontalExpand="True" MinValue="0" MaxValue="100" />
                                <ColorSelectorSliders Name="CharacterSkinColorPicker" HorizontalExpand="True" />
