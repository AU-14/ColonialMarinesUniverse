                                    <Label MinWidth="240" VAlign="Center" Text="{Loc 'humanoid-profile-editor-preferred-squad-label'}" />
                                    <OptionButton MinWidth="220" Name="SquadPreferenceButton" />
                                    <Control HorizontalExpand="True" />
                                </BoxContainer>
                                <!-- Armor Preference -->
                                <BoxContainer HorizontalExpand="True">
                                    <Label MinWidth="240" VAlign="Center" Text="{Loc 'humanoid-profile-editor-preferred-armor-label'}" />
                                    <OptionButton MinWidth="220" Name="ArmorPreferenceButton" />
                                    <Control HorizontalExpand="True" />
                                <!-- cmu edit end -->
                                </BoxContainer>
