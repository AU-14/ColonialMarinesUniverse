                                    <Control HorizontalExpand="True"/>
                                    <Label Name="EyeColorNameLabel" HorizontalAlignment="Right" StyleClasses="LabelSubText" />
                                </BoxContainer>
                                <ColorSelectorSliders Name="CharacterEyeColorPicker" HorizontalExpand="True" />
                            </BoxContainer>
                            <!-- cmu edit end -->
                        </BoxContainer>
                    </ScrollContainer>
                </BoxContainer>
