                                    <Control HorizontalExpand="True" />
                                </BoxContainer>
                                <!-- Xeno Prefix -->
                                <BoxContainer HorizontalExpand="True">
                                    <Label MinWidth="240" VAlign="Center" Text="{Loc 'humanoid-profile-editor-xeno-prefix'}" />
                                    <LineEdit Name="XenoPrefix" MinWidth="100" />
                                    <TextureButton Name="XenoPrefixInfoButton" Scale="0.3 0.3"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Loc 'humanoid-profile-editor-xeno-prefix-tooltip'}"
                                                   StyleClasses="SpeciesInfoDefault" />
                                    <Control HorizontalExpand="True" />
                                </BoxContainer>
                                <!-- Xeno Postfix -->
                                <BoxContainer HorizontalExpand="True">
                                    <Label MinWidth="240" VAlign="Center" Text="{Loc 'humanoid-profile-editor-xeno-postfix'}" />
                                    <LineEdit Name="XenoPostfix" MinWidth="100" />
                                    <TextureButton Name="XenoPostfixInfoButton" Scale="0.3 0.3"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Loc 'humanoid-profile-editor-xeno-postfix-tooltip'}"
                                                   StyleClasses="SpeciesInfoDefault" />
                                    <Control HorizontalExpand="True" />
                                </BoxContainer>
                                <cc:HSeparator Color="#16823E" Margin="0 5" />
                                <!-- Species -->
                                <!-- cmu edit start -->
                                <BoxContainer HorizontalExpand="True">
                                    <Label MinWidth="240" VAlign="Center" Text="{Loc 'humanoid-profile-editor-species-label'}" />
                                    <OptionButton MinWidth="220" Name="SpeciesButton" />
                                <!-- cmu edit end -->
                                    <TextureButton Name="SpeciesInfoButton" Scale="0.3 0.3"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Loc 'humanoid-profile-editor-guidebook-button-tooltip'}"/>
                                    <Control HorizontalExpand="True" />
                                </BoxContainer>
                                <!-- cmu edit start: sex moved to the Character Records tab -->
                                <!-- Voice -->
                                <BoxContainer HorizontalExpand="True" Visible="False">
                                <!-- cmu edit end -->
                                    <Label Text="{Loc 'humanoid-profile-editor-voice-label'}" />
                                    <Control HorizontalExpand="True" />
                                    <OptionButton Name="VoiceButton" HorizontalAlignment="Right" />
