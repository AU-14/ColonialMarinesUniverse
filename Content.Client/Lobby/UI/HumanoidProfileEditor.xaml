                                    <OptionButton MinWidth="220" Name="SpawnPriorityButton" />
                                    <Control HorizontalExpand="True" />
                                <!-- cmu edit end -->
                                </BoxContainer>
                                <!-- cmu edit start -->
                                <!-- FOB security squad opt-in. Its own card so it reads as a choice with
                                     consequences rather than another one-line setting. Short lines only:
                                     this tab scrolls sideways, so long text never wraps. -->
                                <PanelContainer StyleClasses="CrtInsetPanel" Margin="0 8 0 2">
                                    <BoxContainer Orientation="Vertical" SeparationOverride="6">
                                        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                                            <Label Text="{Loc 'cmu-humanoid-profile-editor-foxtrot-squad-title'}"
