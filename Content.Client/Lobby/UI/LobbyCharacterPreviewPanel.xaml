<Control
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:profile="clr-namespace:Content.Client.Lobby.UI.ProfileEditorControls">
    <!-- The same three bands the round-info page has: one big fact with a tag, a rule, the body, a rule,
         a foot. -->
    <BoxContainer Name="VBox" Orientation="Vertical" VerticalExpand="True">
        <!-- Head. The name is the big fact and the pronoun and age its tag, in the same places the planet
             and gamemode take on the other page, with the same dotted leader between them. -->
        <BoxContainer Name="HeadRow" Orientation="Horizontal" HorizontalExpand="True"
                      SeparationOverride="10" Visible="False">
            <Label Name="SummaryName" StyleClasses="CrtHeading" VerticalAlignment="Center" />
            <PanelContainer Name="HeadLeader" HorizontalExpand="True" VerticalAlignment="Center"
                            MinHeight="1" />
            <RichTextLabel Name="SummaryAge" StyleClasses="CrtCharacterSummary"
                           VerticalAlignment="Center" />
        </BoxContainer>
        <PanelContainer Name="HeadRule" StyleClasses="CrtSectionRule" HorizontalExpand="True"
                        MinHeight="1" Margin="0 7 0 0" Visible="False" />

        <!-- Body. -->
        <BoxContainer Name="Loaded" Orientation="Vertical" VerticalExpand="True" Visible="False">
            <Control VerticalExpand="True" />
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="16">
                <Button Name="PrevCharButton" Text="&lt;" VerticalAlignment="Center"
                        ToolTip="{Loc 'lobby-character-preview-prev-char-tooltip'}" />
                <BoxContainer Name="ViewBox" Orientation="Horizontal" VerticalAlignment="Center">
                    <profile:ProfilePreviewSpriteView Name="ProfilePreviewSpriteView"
                                                      OverrideDirection="South"
                                                      Scale="3 3"
                                                      MaxSize="84 84"
                                                      Stretch="Fill"
                                                      Access="Public" />
                </BoxContainer>
                <Button Name="NextCharButton" Text="&gt;" VerticalAlignment="Center"
                        ToolTip="{Loc 'lobby-character-preview-next-char-tooltip'}" />
            </BoxContainer>
            <Label Name="JobSummary" StyleClasses="CrtHeading" Visible="False"
                   Align="Center" HorizontalExpand="True" Margin="0 8 0 0" />
            <Control VerticalExpand="True" />

            <!-- Foot: the two things you can do to this character. -->
            <PanelContainer Name="ActionBand" StyleClasses="CrtCommandBand" Margin="0 4 0 0">
                <BoxContainer Orientation="Horizontal" SeparationOverride="1" HorizontalExpand="True">
                    <Button Name="IgnoreAllegianceButton" ToggleMode="True" HorizontalExpand="True"
                            VerticalExpand="True" StyleClasses="CrtCommandCell"
                            Text="{Loc 'lobby-character-preview-ignore-allegiance'}"
                            ToolTip="{Loc 'lobby-character-preview-ignore-allegiance-tooltip'}" />
                    <Button Name="CharacterSetup" HorizontalExpand="True" VerticalExpand="True"
                            StyleClasses="CrtCommandCell"
                            Text="{Loc 'lobby-character-preview-panel-character-setup-button'}" />
                    <Button Name="PatronPerks" Access="Public" VerticalExpand="True"
                            StyleClasses="CrtCommandCell"
                            Text="{Loc 'rmc-ui-patron-perks'}" Visible="False" />
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
        <Label Name="Unloaded" Text="{Loc 'lobby-character-preview-panel-unloaded-preferences-label'}"/>
    </BoxContainer>
</Control>
