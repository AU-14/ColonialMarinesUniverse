###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto eol=lf
*.bat text  eol=crlf
*.cmd text  eol=crlf
*.ps1 text  eol=crlf

###############################################################################
# Force binary assets to be treated as binary, regardless of autocrlf/text=auto
# heuristics, so committing from a CRLF-configured client can't corrupt them.
###############################################################################
*.png  binary
*.webp binary
*.ico  binary
*.ogg  binary
*.wav  binary
*.sf2  binary
*.ttf  binary
*.otf  binary

###############################################################################
# Set default behavior for command prompt diff.
###############################################################################
*.cs        diff=csharp

###############################################################################
# Set the merge driver for YAML map data
# dotnet run --project ./Content.Tools "$@"
###############################################################################
Resources/Maps/**.yml merge=mapping-merge-driver
