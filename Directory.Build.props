<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Pow3r'">
    <!-- Veldrid's unused legacy SharpDX assets carry old RID metadata on modern .NET. -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Pow3r'">
    <!--
      These advisories are reached only through Veldrid -> retired SharpDX ->
      Microsoft.NETCore.App 1.0.x. Pow3r targets net10.0 and does not consume those runtime
      assets, so suppress only the exact transitive advisories instead of disabling auditing.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-7mfr-774f-w5r9" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-8884-xcr4-r68p" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-xcvr-qv8h-m7xw" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SpaceWizards.RsiLib'">
    <!-- RSI.NET is an external submodule; retain its pin and scope audit exceptions exactly. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2cmq-823j-5qj8" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rxmq-m78w-7wmc" />
  </ItemGroup>
</Project>
